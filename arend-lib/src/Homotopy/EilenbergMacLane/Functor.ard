-- | After ``theorems/homotopy/EilenbergMacLaneFunctor.agda`` in HoTT-Agda.

\import Algebra.Group
\import Algebra.Group.GroupHom
\import Equiv
\import Homotopy.Connectivity
\import Homotopy.EilenbergMacLane.Definition
\import Homotopy.EilenbergMacLane.Loop
\import Homotopy.K1
\import Homotopy.K1.Basic
\import Homotopy.K1.Functor
\import Homotopy.Localization.Truncation
\import Homotopy.Loop
\import Homotopy.Pointed \hiding (base)
\import Homotopy.Pushout
\import Homotopy.Suspension
\import Homotopy.Truncation
\import Logic
\import Paths

\open ->* (∘*, compose-assoc)

\func KMap.{u} {G H : CGroup.{u}} (n : Nat) (phi : GroupHom G H) : K G n ->* K H n \elim n
  | 0 => (phi, phi.func-ide)
  | 1 => K1Map phi
  | suc (suc n) => truncSusp (suc (suc (suc n))) (KMap (suc n) phi).1
  \where {
    \func truncSusp.{u} (m : Nat) {A B : \Type u} (f : A -> B)
      : Pointed.make {Trunc_-1+ m (Susp A)} (inT north) ->* Pointed.make {Trunc_-1+ m (Susp B)} (inT north)
      => (TruncMap m (Susp.map f), idp)

    \func susp-id {A : \Type} (y : Susp A) : Susp.map (\lam x => x) y = y \elim y
      | north => idp
      | south => idp
      | pglue a i => idp

    \func susp-comp {A B C : \Type} (f : A -> B) (g : B -> C) (y : Susp A)
      : Susp.map (\lam x => g (f x)) y = Susp.map g (Susp.map f y) \elim y
      | north => idp
      | south => idp
      | pglue a i => idp

    \func truncSusp-id.{u} (m : Nat) {A : \Type u} : truncSusp m (\lam (x : A) => x) = ->*.id
      => ->*.ext (trunc-unique (Trunc_-1+.level m (Susp A)) _ (\lam t => t) (\lam y => pmap inT (susp-id y))) idp

    \func truncSusp-comp.{u} (m : Nat) {A B C : \Type u} (f : A -> B) (g : B -> C)
      : truncSusp m (\lam x => g (f x)) = truncSusp m g ∘* truncSusp m f
      => ->*.ext (trunc-unique (Trunc_-1+.level m (Susp C)) _ _ (\lam y => pmap inT (susp-comp f g y))) idp

    \func id.{u} {G : CGroup.{u}} (n : Nat) : KMap n (GroupHom.id {G}) = ->*.id \elim n
      | 0 => ->*.ext {K G 0} {K G 0} (\lam _ => idp) prop-pi
      | 1 => K1Map.id
      | suc (suc n) => pmap (\lam (f : K G (suc n) ->* K G (suc n)) => truncSusp (suc (suc (suc n))) f.1) (id (suc n))
                       *> truncSusp-id (suc (suc (suc n)))

    \func comp.{u} {G H L : CGroup.{u}} (n : Nat) (psi : GroupHom H L) (phi : GroupHom G H)
      : KMap n (psi GroupHom.∘ phi) = KMap n psi ∘* KMap n phi \elim n
      | 0 => ->*.ext {K G 0} {K L 0} (\lam _ => idp) prop-pi
      | 1 => K1Map.comp psi phi
      | suc (suc n) => pmap (\lam (f : K G (suc n) ->* K L (suc n)) => truncSusp (suc (suc (suc n))) f.1) (comp (suc n) psi phi)
                       *> truncSusp-comp (suc (suc (suc n))) (KMap (suc n) phi).1 (KMap (suc n) psi).1
  }

\func KMap_loopUnit.{u} {G H : CGroup.{u}} (n : Nat) (phi : GroupHom G H)
  : ->*.compose {K G n} {Loop (K G (suc n))} {Loop (K H (suc n))} (Loop-Func (KMap (suc n) phi)) (K-loopUnit n)
    = ->*.compose {K G n} {K H n} {Loop (K H (suc n))} (K-loopUnit n) (KMap n phi) \elim n
  | 0 => ->*.ext {K G 0} {Loop (K H 1)} (\lam g => idp_*> _) (ToProp.fromProp (K1-level base base _ _) _ _)
  | suc n => susp-natural {K G (suc n)} {K H (suc n)} {K G (suc (suc n))} {K H (suc (suc n))} (KMap (suc n) phi) (KMap (suc (suc n)) phi) (K-susp (suc n)) (K-susp (suc n)) idp
  \where
    \func susp-natural.{u} {X Y Z W : Pointed.{u}} (f : X ->* Y) (F : Z ->* W)
                           (sX : Susp.pointed X ->* Z) (sY : Susp.pointed Y ->* W)
                           (sq : ->*.compose {Susp.pointed X} {Z} {W} F sX = ->*.compose {Susp.pointed X} {Susp.pointed Y} {W} sY (Susp-Func f))
      : ->*.compose {X} {Loop Z} {Loop W} (Loop-Func F) (->*.compose {X} {Loop (Susp.pointed X)} {Loop Z} (Loop-Func sX) (SuspLoopEquiv.unit X))
        = ->*.compose {X} {Y} {Loop W} (->*.compose {Y} {Loop (Susp.pointed Y)} {Loop W} (Loop-Func sY) (SuspLoopEquiv.unit Y)) f
      => compose-assoc (Loop-Func F) (Loop-Func sX) (SuspLoopEquiv.unit X)
         *> pmap (∘* SuspLoopEquiv.unit X) (inv (Loop-Func-comp F sX) *> pmap Loop-Func sq *> Loop-Func-comp sY (Susp-Func f))
         *> inv (compose-assoc (Loop-Func sY) (Loop-Func (Susp-Func f)) (SuspLoopEquiv.unit X))
         *> pmap (Loop-Func sY ∘*) (SuspLoopEquiv.unit.natural f)
         *> compose-assoc (Loop-Func sY) (SuspLoopEquiv.unit Y) f

\func KMap_loopInv.{u} {G H : CGroup.{u}} (n : Nat) (phi : GroupHom G H) (z : Loop (K G (suc n)))
  : (KMap n phi).1 ((K-loopInv n).1 z) = (K-loopInv n).1 ((Loop-Func (KMap (suc n) phi)).1 z)
  => IsEquiv.isInj (K-loopUnit-isEquiv n)
      (inv (->*.happly {K G n} {Loop (K H (suc n))} (KMap_loopUnit n phi) ((K-loopInv n).1 z))
       *> pmap (Loop-Func (KMap (suc n) phi)).1 (K-loopInv.right n z)
       *> inv (K-loopInv.right n _))
