-- | After `Cubical/CW/Homology/Base.agda` in the cubical library.

\import Algebra.Group
\import Algebra.Group.Chain
\import Algebra.Group.GroupCat
\import Algebra.Group.GroupHom
\import Algebra.Group.SubGroup
\import Algebra.Monoid
\import Algebra.Monoid.MonoidHom
\import Category (Iso)
\import Equiv
\import Homotopy.CW
\import Homotopy.CW.Homology.Chain
\import Algebra.Group.FreeAbelian (ZFree)
\import Homotopy.CW.Structure.Finite (discrete, unit-isCW, unit-structure)
\import Homotopy.CW.Homology.Descent
\import Homotopy.CW.Homology.Map
\import Logic
\import Logic.Unique
\import Paths
\import Paths.Meta

\func CWHomology.{u} (n : Nat) {X : \Type u} (cw : IsCW X) : AbGroup.{0}
  => (Datum.canonical n cw).1
  \where {
    \func compare.{u} (n : Nat) {X : \Type u} (cw : IsCW X) (s : HasCWStructure X) : Iso {AbGroupCat.{0}} {Homology (cellular s.1) n} {CWHomology n cw}
      => (Datum.canonical n cw).2 s

    \lemma compare-transition.{u} (n : Nat) {X : \Type u} (cw : IsCW X) (s t : HasCWStructure X) (x : Homology (cellular s.1) n)
      : Iso.f {compare n cw t} (structureMap n (\lam x => x) s t x) = Iso.f {compare n cw s} x
      => (Datum.canonical n cw).3 s t x

    \lemma compare-inverse.{u} (n : Nat) {X : \Type u} (cw : IsCW X) (s : HasCWStructure X) (y : CWHomology n cw)
      : Iso.f {compare n cw s} (Iso.hinv {compare n cw s} y) = y
      => Datum.f-hinv (Datum.canonical n cw) s y

    \lemma inverse-compare.{u} (n : Nat) {X : \Type u} (cw : IsCW X) (s : HasCWStructure X) (x : Homology (cellular s.1) n)
      : Iso.hinv {compare n cw s} (Iso.f {compare n cw s} x) = x
      => Datum.hinv-f (Datum.canonical n cw) s x

    \func map.{u} (n : Nat) {X Y : \Type u} (cX : IsCW X) (cY : IsCW Y) (f : X -> Y) : AddGroupHom (CWHomology n cX) (CWHomology n cY)
      => (MapDatum.canonical n cX cY f).1

    \lemma natural.{u} (n : Nat) {X Y : \Type u} (cX : IsCW X) (cY : IsCW Y) (f : X -> Y) (s : HasCWStructure X) (t : HasCWStructure Y)
                       (x : Homology (cellular s.1) n)
      : map n cX cY f (Iso.f {compare n cX s} x) = Iso.f {compare n cY t} (structureMap n f s t x)
      => (MapDatum.canonical n cX cY f).2 s t x

    \lemma natural-at.{u} (n : Nat) {X Y : \Type u} (cX : IsCW X) (cY : IsCW Y) (f : X -> Y) (s : HasCWStructure X) (t : HasCWStructure Y)
                          (x : Homology (cellular s.1) n) {y : CWHomology n cX} (e : Iso.f {compare n cX s} x = y)
      : Iso.f {compare n cY t} (structureMap n f s t x) = map n cX cY f y
      => inv (natural n cX cY f s t x) *> pmap (map n cX cY f) e

    \lemma map-unique.{u} (n : Nat) {X Y : \Type u} (cX : IsCW X) (cY : IsCW Y) (f : X -> Y) (D : MapDatum n cX cY f) : map n cX cY f = D.1
      => pmap __.1 (MapDatum.unique n cX cY f D)

    \lemma map-id.{u} (n : Nat) {X : \Type u} (cX : IsCW X) : map n cX cX (\lam x => x) = AddGroupHom.id
      => map-unique n cX cX (\lam x => x) (AddGroupHom.id, \lam s t x => inv (compare-transition n cX s t x))

    \lemma map-comp.{u} (n : Nat) {X Y Z : \Type u} (cX : IsCW X) (cY : IsCW Y) (cZ : IsCW Z) (g : Y -> Z) (f : X -> Y)
      : map n cX cZ (\lam x => g (f x)) = map n cY cZ g AddGroupHom.∘ map n cX cY f
      => map-unique n cX cZ (\lam x => g (f x)) (map n cY cZ g AddGroupHom.∘ map n cX cY f, \lam s r x => \case cY \with {
        | inP t => pmap (map n cY cZ g) (natural n cX cY f s t x) *> natural n cY cZ g t r _ *> pmap (Iso.f {compare n cZ r}) (structureMap.comp n g f s t r x)
      })

    \lemma map-homotopy.{u} (n : Nat) {X Y : \Type u} (cX : IsCW X) (cY : IsCW Y) {f g : X -> Y} (p : \Pi (x : X) -> f x = g x)
      : map n cX cY f = map n cX cY g
      => inv (map-unique n cX cY g (map n cX cY f, \lam s t x => natural n cX cY f s t x
               *> pmap (Iso.f {compare n cY t}) (pmap (\lam (h : AddGroupHom (Homology (cellular s.1) n) (Homology (cellular t.1) n)) => h x)
                                                      (cellHomologyMap.homotopy n (\lam z => pmap t.2 (p (s.2.ret z)))))))

    \lemma map-comp-at.{u} (n : Nat) {X Y Z : \Type u} (cX : IsCW X) (cY : IsCW Y) (cZ : IsCW Z) (g : Y -> Z) (f : X -> Y) (x : CWHomology n cX)
      : map n cX cZ (\lam x => g (f x)) x = map n cY cZ g (map n cX cY f x)
      => pmap (\lam (h : AddGroupHom (CWHomology n cX) (CWHomology n cZ)) => h x) (map-comp n cX cY cZ g f)

    \lemma map-id-at.{u} (n : Nat) {X : \Type u} (cX : IsCW X) {f : X -> X} (p : \Pi (x : X) -> f x = x) (x : CWHomology n cX) : map n cX cX f x = x
      => pmap (\lam (h : AddGroupHom (CWHomology n cX) (CWHomology n cX)) => h x) (map-homotopy n cX cX p *> map-id n cX)

    \func map-equiv.{u} (n : Nat) {X Y : \Type u} (cX : IsCW X) (cY : IsCW Y) (e : QEquiv {X} {Y}) : QEquiv (map n cX cY e) \cowith
      | ret => map n cY cX e.ret
      | ret_f x => inv (map-comp-at n cX cY cX e.ret e x) *> map-id-at n cX e.ret_f x
      | f_sec y => inv (map-comp-at n cY cX cY e e.ret y) *> map-id-at n cY e.f_sec y

    \lemma map-isEquiv.{u} (n : Nat) {X Y : \Type u} (cX : IsCW X) (cY : IsCW Y) (f : X -> Y) (s : HasCWStructure X) (t : HasCWStructure Y)
                           (e : IsEquiv (structureMap n f s t)) : IsEquiv (map n cX cY f)
      => transport IsEquiv (ext (\lam y => pmap (Iso.f {compare n cY t}) idp *> inv (natural n cX cY f s t _) *> pmap (map n cX cY f) (compare-inverse n cX s y)))
                   (IsEquiv.trans (IsEquiv.trans (inP (symQEquiv (AbGroupCat.equivOfIso (compare n cX s)))) e) (inP (AbGroupCat.equivOfIso (compare n cY t))))

    \lemma map-const.{u} (n : Nat) {X Y : \Type u} (cX : IsCW X) (cY : IsCW Y) (y0 : Y) (x : CWHomology.{u} (suc n) cX)
      : map.{u} (suc n) cX cY (\lam _ => y0) x = AddMonoid.zro {CWHomology.{u} (suc n) cY}
      => map-comp-at.{u} (suc n) cX unit-isCW.{u} cY (\lam _ => y0) (\lam _ => ()) x
         *> pmap (map.{u} (suc n) unit-isCW.{u} cY (\lam _ => y0)) (ReducedCWHomology.point-trivial.{u} n _) *> AddMonoidHom.func-zro
  }

\func ReducedCWHomology.{u} (n : Nat) {X : \Type u} (cw : IsCW X) : AbGroup.{0}
  => IAbGroup (KernelAddGroup (CWHomology.map n cw unit-isCW.{u} (\lam _ => ())))
  \where {
    \lemma point-trivial.{u} (n : Nat) {c : IsCW.{u} (\Sigma)} (y : CWHomology.{u} (suc n) c) : y = AddMonoid.zro {CWHomology.{u} (suc n) c}
      => inv (CWHomology.compare-inverse.{u} (suc n) c unit-structure.{u} y)
         *> pmap (Iso.f {CWHomology.compare.{u} (suc n) c unit-structure.{u}})
                 (Homology.trivial {cellular (discrete 1)} {suc n} ZFree.zero-trivial (Iso.hinv {CWHomology.compare.{u} (suc n) c unit-structure.{u}} y))
         *> AddMonoidHom.func-zro

    \func forget.{u} (n : Nat) {X : \Type u} (cw : IsCW X) : AddGroupHom (ReducedCWHomology.{u} n cw) (CWHomology.{u} n cw) \cowith
      | func y => y.1
      | func-+ => idp

    \func unreduced.{u} (n : Nat) {X : \Type u} (cw : IsCW X) : Iso {AbGroupCat.{0}} (forget.{u} (suc n) cw)
      => AbGroupCat.isoOfEquiv (forget.{u} (suc n) cw) (\new QEquiv {
           | ret y => (y, point-trivial.{u} n (CWHomology.map.{u} (suc n) cw unit-isCW.{u} (\lam _ => ()) y))
           | ret_f _ => ext idp
           | f_sec _ => idp
         })

    \func map.{u} (n : Nat) {X Y : \Type u} (cX : IsCW X) (cY : IsCW Y) (f : X -> Y) : AddGroupHom (ReducedCWHomology n cX) (ReducedCWHomology n cY) \cowith
      | func y => (CWHomology.map n cX cY f y.1,
                   inv (pmap (\lam (h : AddGroupHom (CWHomology n cX) (CWHomology n unit-isCW)) => h y.1) (CWHomology.map-comp n cX cY unit-isCW (\lam _ => ()) f)) *> y.2)
      | func-+ => ext (CWHomology.map n cX cY f).func-+

    \lemma map-id.{u} (n : Nat) {X : \Type u} (cX : IsCW X) (y : ReducedCWHomology n cX) : map n cX cX (\lam x => x) y = y
      => ext (pmap (\lam (h : AddGroupHom (CWHomology n cX) (CWHomology n cX)) => h y.1) (CWHomology.map-id n cX))

    \lemma map-comp.{u} (n : Nat) {X Y Z : \Type u} (cX : IsCW X) (cY : IsCW Y) (cZ : IsCW Z) (g : Y -> Z) (f : X -> Y) (y : ReducedCWHomology n cX)
      : map n cX cZ (\lam x => g (f x)) y = map n cY cZ g (map n cX cY f y)
      => ext (pmap (\lam (h : AddGroupHom (CWHomology n cX) (CWHomology n cZ)) => h y.1) (CWHomology.map-comp n cX cY cZ g f))

    \lemma map-homotopy.{u} (n : Nat) {X Y : \Type u} (cX : IsCW X) (cY : IsCW Y) {f g : X -> Y} (p : \Pi (x : X) -> f x = g x) (y : ReducedCWHomology n cX)
      : map n cX cY f y = map n cX cY g y
      => ext (pmap (\lam (h : AddGroupHom (CWHomology n cX) (CWHomology n cY)) => h y.1) (CWHomology.map-homotopy n cX cY p))

    \func Cells.{u} (n : Nat) {X : \Type u} (s : HasCWStructure X) (t : HasCWStructure.{u} (\Sigma)) : AbGroup.{0}
      => IAbGroup (KernelAddGroup (structureMap n (\lam (_ : X) => ()) s t))

    \func compare.{u} (n : Nat) {X : \Type u} (cw : IsCW X) (s : HasCWStructure X) (t : HasCWStructure.{u} (\Sigma))
      : Iso {AbGroupCat.{0}} {Cells n s t} {ReducedCWHomology n cw}
      => AbGroupCat.isoOfEquiv (forward n cw s t) (\new QEquiv {
           | ret y => (Iso.hinv {CWHomology.compare n cw s} y.1, backward n cw s t y.1 y.2)
           | ret_f x => ext (CWHomology.inverse-compare n cw s x.1)
           | f_sec y => ext (CWHomology.compare-inverse n cw s y.1)
         })
      \where {
        \func forward.{u} (n : Nat) {X : \Type u} (cw : IsCW X) (s : HasCWStructure X) (t : HasCWStructure.{u} (\Sigma))
          : AddGroupHom (Cells n s t) (ReducedCWHomology n cw) \cowith
          | func x => (Iso.f {CWHomology.compare n cw s} x.1,
                       CWHomology.natural n cw unit-isCW (\lam _ => ()) s t x.1 *> pmap (Iso.f {CWHomology.compare n unit-isCW t}) x.2 *> AddMonoidHom.func-zro)
          | func-+ => ext (Iso.f {CWHomology.compare n cw s}).func-+

        \lemma backward.{u} (n : Nat) {X : \Type u} (cw : IsCW X) (s : HasCWStructure X) (t : HasCWStructure.{u} (\Sigma)) (y : CWHomology n cw)
                            (q : CWHomology.map n cw unit-isCW.{u} (\lam _ => ()) y = AddMonoid.zro {CWHomology n unit-isCW.{u}})
          : structureMap n (\lam (_ : X) => ()) s t (Iso.hinv {CWHomology.compare n cw s} y) = AddMonoid.zro {Homology (cellular t.1) n}
          => inv (CWHomology.inverse-compare n unit-isCW t _)
             *> pmap (Iso.hinv {CWHomology.compare n unit-isCW t})
                     (inv (CWHomology.natural n cw unit-isCW (\lam _ => ()) s t _) *> pmap (CWHomology.map n cw unit-isCW (\lam _ => ())) (CWHomology.compare-inverse n cw s y) *> q)
             *> AddMonoidHom.func-zro
      }
  }
