\open PushoutData (ppglue)

\func gap.{u} {X Y : Pointed.{u}} (f : X ->* Y) : X ->* PointedFib (Cof.inc f)
  => (\lam a => totalEquiv.total (fill f) (totalFib f.1 a), base-path pinl f.2 (ppglue base))
  \where {
    \func fill {X Y : Pointed} (f : X ->* Y) (y : Y) (t : Fib f.1 y) : pinl y = {Cof f.1} pinl base
      => (pmap pinl (inv t.2) *> ppglue t.1) *> (inv (ppglue base) *> pmap pinl f.2)

    \func base-path {Y W : \Type} (L : Y -> W) {y0 y1 : Y} (p : y0 = y1) {w : W} (g : L y0 = w)
      : ((y0, (idp *> g) *> (inv g *> pmap L p)) : \Sigma (y : Y) (L y = L y1)) = (y1, idp) \elim p
      | idp => pmap (\lam (q : L y0 = L y0) => ((y0, q) : \Sigma (y : Y) (L y = L y0))) (pmap (`*> inv g) (idp_*> g) *> *>_inv g)

    \func base-path-proj {Y W : \Type} (L : Y -> W) {y0 y1 : Y} (p : y0 = y1) {w : W} (g : L y0 = w)
      : pmap (\lam (t : \Sigma (y : Y) (L y = L y1)) => t.1) (base-path L p g) = p \elim p
      | idp => idp

    \func proj.{u} {X Y : Pointed.{u}} (f : X ->* Y) : fibProj (Cof.inc f) ->*.∘* gap f = f
      => ->*.ext (\lam _ => idp) (idp_*> f.2 *> inv (base-path-proj pinl f.2 (ppglue base)))

    \lemma nconnected.{u} (r s : Nat) {X Y : Pointed.{u}} (f : X ->* Y) (cf : isNConnectedMap (suc r) f.1) (cX : isNConnectedType (suc s) X)
      : isNConnectedMap (suc (r Nat.+ s)) (gap f).1
      => nconnected-map-comp-right (suc (r Nat.+ s)) (totalFib f.1)
           (nconnected-total {suc (r Nat.+ s)} (fill f) \lam y => nconnected-map-comp-left (suc (r Nat.+ s)) (pathConcatEquiv-right (inv (ppglue base) *> pmap pinl f.2))
                                                                                         (nconnected-cofiber r s f.1 cf cX y))
  }

\lemma cofiber-exact.{u} (k : Nat) {X Y : Pointed.{u}} (f : X ->* Y) (c : isNConnectedMap (suc k) (gap f).1) (t : pi (suc k) Y)
                         (q : piMap (suc k) (Cof.inc f) t = ide {PiGroup k (Cof.pointed f)}) : ∃ (s : pi (suc k) X) (piMap (suc k) f s = t)
  => \case ((pi-exact-total (Cof.inc f) (suc k)) t).1 q \with {
    | inP (u, e) => \case nconnected-pi-surj (gap f) c u \with {
      | inP (v, e') => inP (v, pmap (piMap (suc k) __ v) (inv (gap.proj f)) *> piMap-comp (suc k) (fibProj (Cof.inc f)) (gap f) v
                               *> pmap (piMap (suc k) (fibProj (Cof.inc f))) e' *> e)
    }
  }

\func cofiberBottom {p g h : Nat} (f : Bouquet (suc (suc p)) g ->* Bouquet (suc (suc p)) h)
  : AddGroupHom (Coker (degreeHom f)) (AbGroup.fromCGroup (PiCGroup p (Cof.pointed f)))
  => Coker.desc (AddGroupHom.fromGroupHom (piGroupMap (suc p) (Cof.inc f)) AddGroupHom.∘ unbottom p h) (kills f)
  \where {
    \func unbottom (p h : Nat) => AddGroupHom.inverse (bottom p h) (IsEquiv.toQEquiv (bottom.isEquiv p h))

    \lemma unbottom-degree {p g h : Nat} (f : Bouquet (suc (suc p)) g ->* Bouquet (suc (suc p)) h) (r : ZFree g)
      : unbottom p h (degreeHom f r) = piMap (suc (suc p)) f (unbottom p g r)
      => pmap (unbottom p h) (inv (pmap (degreeHom f) ((IsEquiv.toQEquiv (bottom.isEquiv p g)).f_ret r)) *> inv (degreeHom.action f _))
         *> (IsEquiv.toQEquiv (bottom.isEquiv p h)).ret_f _

    \lemma kills {p g h : Nat} (f : Bouquet (suc (suc p)) g ->* Bouquet (suc (suc p)) h) (r : ZFree g)
      : piMap (suc (suc p)) (Cof.inc f) (unbottom p h (degreeHom f r)) = ide {PiGroup (suc p) (Cof.pointed f)}
      => pmap (piMap (suc (suc p)) (Cof.inc f)) (unbottom-degree f r) *> inv (piMap-comp (suc (suc p)) (Cof.inc f) f _)
         *> pmap (piMap (suc (suc p)) __ _) (Cof.inc-null f) *> piMap-zero (suc p) _

    \lemma gap-connected {p g h : Nat} (f : Bouquet (suc (suc p)) g ->* Bouquet (suc (suc p)) h) : isNConnectedMap (suc (suc p)) (gap f).1
      => nconnected-map-mono {suc (suc p)} {suc (p Nat.+ suc p)} linarith (gap.nconnected p (suc p) f
           (nconnected-map-between {suc p} f.1 (Bouquet.connected (suc p) g) (Bouquet.connected (suc p) h)) (Bouquet.connected (suc p) g))

    \lemma isEquiv {p g h : Nat} (f : Bouquet (suc (suc p)) g ->* Bouquet (suc (suc p)) h) : IsEquiv (cofiberBottom f)
      => IsEquiv.fromInjSurj (AddGroupHom.injective \lam {y} q => \case Coker.proj-surj {_} {_} {degreeHom f} y \with {
                               | inP (x, ex) => inv ex *> kernel f x (pmap (cofiberBottom f) ex *> q)
                             })
                             \lam y => TruncP.map (nconnected-pi-surj {suc p} (Cof.inc f) (nconnected-pinl {suc (suc p)} f.1 ((nconnected-unit {suc (suc p)}).1 (Bouquet.connected (suc p) g))) y)
                                         \lam s => (Coker.proj (degreeHom f) (bottom p h s.1),
                                                    pmap (piMap (suc (suc p)) (Cof.inc f)) ((IsEquiv.toQEquiv (bottom.isEquiv p h)).ret_f s.1) *> s.2)

    \lemma kernel {p g h : Nat} (f : Bouquet (suc (suc p)) g ->* Bouquet (suc (suc p)) h) (x : ZFree h)
                  (q : cofiberBottom f (Coker.proj (degreeHom f) x) = ide {PiGroup (suc p) (Cof.pointed f)})
      : Coker.proj (degreeHom f) x = AddMonoid.zro {Coker (degreeHom f)}
      => \case cofiber-exact (suc p) f (gap-connected f) _ q \with {
        | inP (s, e) => pmap (Coker.proj (degreeHom f)) (inv ((IsEquiv.toQEquiv (bottom.isEquiv p h)).f_sec x) *> pmap (bottom p h) (inv e)
                                                         *> degreeHom.action f s)
                        *> Coker.proj-kills (bottom p g s)
      }
  }

\func cofiberBottom1 {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h) : AddGroupHom (Coker (degreeHom f)) (Ab (PiGroup 0 (Cof.pointed f)))
  => Coker.desc (Ab.map (piGroupMap 0 (Cof.inc f)) AddGroupHom.∘ bottom1.back h) (kills f)
  \where {
    \lemma back-count (h : Nat) (y : PiGroup 0 (Bouquet 1 h)) : bottom1.back h (bottom1.count h y) = in~ y
      => (bottom1.isEquiv h).ret_f (in~ y)

    \lemma kills {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h) (r : ZFree g)
      : Ab.map (piGroupMap 0 (Cof.inc f)) (bottom1.back h (degreeHom f r)) = AddMonoid.zro {Ab (PiGroup 0 (Cof.pointed f))}
      => pmap (\lam (u : AddGroupHom (ZFree g) (Ab (PiGroup 0 (Cof.pointed f)))) => u r)
           (ZFree.hom-ext (Ab.map (piGroupMap 0 (Cof.inc f)) AddGroupHom.∘ bottom1.back h AddGroupHom.∘ degreeHom f) AddGroupHom.zero \lam a =>
              pmap (\lam y => Ab.map (piGroupMap 0 (Cof.inc f)) (bottom1.back h (degreeHom f y))) (inv (bottom1.basis-generator a))
              *> pmap (\lam y => Ab.map (piGroupMap 0 (Cof.inc f)) (bottom1.back h y)) (inv (bottom1.action f (circleBouquet.gen a)))
              *> pmap (Ab.map (piGroupMap 0 (Cof.inc f))) (back-count h (piMap 1 f (circleBouquet.gen a)))
              *> pmap in~ (inv (piMap-comp 1 (Cof.inc f) f (circleBouquet.gen a))
                           *> pmap (\lam (m : Bouquet 1 g ->* Cof.pointed f) => piMap 1 m (circleBouquet.gen a)) (Cof.inc-null f)
                           *> piMap-zero 0 {Bouquet 1 g} {Cof.pointed f} (circleBouquet.gen a)))

    \func source (g : Nat) : Connected0 (Bouquet 1 g)
      => \new Connected0 (Bouquet 1 g) (inP base) (nconnected1-path (Bouquet.connected 0 g))

    \func shift.{u} (X : Pointed.{u}) {x : X} (p : x = base) : Pointed.make x ->* X
      => (\lam y => y, p)

    \func unshift.{u} (X : Pointed.{u}) {x : X} (p : x = base) : X ->* Pointed.make x
      => (\lam y => y, inv p)

    \lemma shift-unshift.{u} (X : Pointed.{u}) {x : X} (p : x = base) (t : PiGroup 0 X)
      : piMap 1 {Pointed.make x} {X} (shift X p) (piMap 1 {X} {Pointed.make x} (unshift X p) t) = t
      => inv (piMap-comp 1 {X} {Pointed.make x} {X} (shift X p) (unshift X p) t)
         *> pmap (\lam (m : X ->* X) => piMap 1 m t)
                 (->*.ext {X} {X} { ->*.compose {X} {Pointed.make x} {X} (shift X p) (unshift X p)} { ->*.id} (\lam _ => idp) (idp_*> idp *> inv (inv_*> p)))
         *> piMap-id 1 t

    \lemma loop-pinl.{u} {A B : \Type u} (k : A -> B) {a : A} (t : a =0 a) : piMap 1 {Pointed.make a} {Pointed.make (k a)} (k, idp) t = map0 k t \elim t
      | in0 l => pmap in0 (idp_*> _)

    \func hom {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h)
      => PiGroup_Cof.hom {source g} {Bouquet 1 h} {f.1} {base}

    \func iso {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h)
      => PiGroup_Cof.iso {source g} {Bouquet 1 h} {f.1} {base}

    \lemma key {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h) (l : f.1 base =0 f.1 base)
      : piMap 1 (unshift (Cof.pointed f) (pmap pinl f.2)) (piMap 1 (Cof.inc f) (piMap 1 (shift (Bouquet 1 h) f.2) l)) = hom f (in~ l)
      => inv (piMap-comp 1 (unshift (Cof.pointed f) (pmap pinl f.2)) (Cof.inc f) _)
         *> inv (piMap-comp 1 (unshift (Cof.pointed f) (pmap pinl f.2) ->*.∘* Cof.inc f) (shift (Bouquet 1 h) f.2) l)
         *> pmap (\lam (m : Pointed.make (f.1 base) ->* Pointed.make {Cof f.1} (pinl (f.1 base)))
                    => piMap 1 {Pointed.make (f.1 base)} {Pointed.make {Cof f.1} (pinl (f.1 base))} m l)
                 (->*.ext {_} {_} { ->*.compose (unshift (Cof.pointed f) (pmap pinl f.2) ->*.∘* Cof.inc f) (shift (Bouquet 1 h) f.2)} {pinl, idp}
                          (\lam _ => idp) (cancel pinl f.2))
         *> loop-pinl pinl l *> inv (PiGroup_Cof.hom-in {source g} {Bouquet 1 h} {f.1} {base} l)
      \where
        \sfunc cancel {A B : \Type} (k : A -> B) {a a' : A} (p : a = a') : idp *> idp = pmap k p *> (idp *> inv (pmap k p)) \elim p
          | idp => idp

    \func unhom {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h) : GroupHom (Aut (f.1 base)) (Coker (degreeHom f))
      => AddGroupHom.toGroupHom (Coker.proj (degreeHom f)) GroupHom.∘ (bottom1.count h GroupHom.∘ piGroupMap 0 (shift (Bouquet 1 h) f.2))

    \lemma unhom-kills {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h) {r : Aut (f.1 base)} (c : imageClosure.Image (map0Hom f.1 base) r)
      : unhom f r = ide {Coker (degreeHom f)} \elim c
      | inP (a, e) => pmap (unhom f) (inv e) *> pmap (\lam y => Coker.proj (degreeHom f) (bottom1.count h y)) (shift-map0 f a)
                      *> pmap (Coker.proj (degreeHom f)) (bottom1.action f a) *> Coker.proj-kills (bottom1.count g a)
      \where
        \lemma shift-map0 {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h) (a : PiGroup 0 (Bouquet 1 g)) : piMap 1 (shift (Bouquet 1 h) f.2) (map0 f.1 a) = piMap 1 f a \elim a
          | in0 l => idp

    \func quotient {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h)
      => normalClosure.lift {Aut (f.1 base)} {Coker (degreeHom f)} {imageClosure.Image (map0Hom f.1 base)} (unhom f) (unhom-kills f)

    \func inverse {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h) : AddGroupHom (Ab (PiGroup 0 (Cof.pointed f))) (Coker (degreeHom f))
      => Ab.desc (quotient f GroupHom.∘ Iso.hinv {iso f} GroupHom.∘ piGroupMap 0 (unshift (Cof.pointed f) (pmap pinl f.2)))

    \lemma inverse-inc {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h) (y : PiGroup 0 (Bouquet 1 h))
      : inverse f (in~ (piMap 1 (Cof.inc f) y)) = Coker.proj (degreeHom f) (bottom1.count h y)
      => pmap (\lam z => quotient f (Iso.hinv {iso f} (piMap 1 (unshift (Cof.pointed f) (pmap pinl f.2)) (piMap 1 (Cof.inc f) z))))
              (inv (shift-unshift (Bouquet 1 h) f.2 y))
         *> pmap (\lam z => quotient f (Iso.hinv {iso f} z)) (key f (piMap 1 (unshift (Bouquet 1 h) f.2) y))
         *> pmap (quotient f) (path (\lam i => (Iso.hinv_f {iso f} @ i) (in~ (piMap 1 (unshift (Bouquet 1 h) f.2) y))))
         *> pmap (\lam z => Coker.proj (degreeHom f) (bottom1.count h z)) (shift-unshift (Bouquet 1 h) f.2 y)

    \lemma forward {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h) (z : Aut (f.1 base) // imageClosure (map0Hom f.1 base))
      : cofiberBottom1 f (quotient f z) = in~ (piMap 1 (shift (Cof.pointed f) (pmap pinl f.2)) (hom f z)) \elim z
      | in~ l => pmap (Ab.map (piGroupMap 0 (Cof.inc f))) (back-count h (piMap 1 (shift (Bouquet 1 h) f.2) l))
                 *> pmap in~ (inv (shift-unshift (Cof.pointed f) (pmap pinl f.2) _) *> pmap (piMap 1 (shift (Cof.pointed f) (pmap pinl f.2))) (key f l))

    \func isEquiv {g h : Nat} (f : Bouquet 1 g ->* Bouquet 1 h) : QEquiv (cofiberBottom1 f) \cowith
      | ret => inverse f
      | ret_f x => pmap {AddGroupHom (Coker (degreeHom f)) (Coker (degreeHom f))} (__ x)
                     (Coker.hom-ext (inverse f AddGroupHom.∘ cofiberBottom1 f) AddGroupHom.id \lam y => pmap {AddGroupHom (ZFree h) (Coker (degreeHom f))} (__ y)
                       (ZFree.hom-ext (inverse f AddGroupHom.∘ cofiberBottom1 f AddGroupHom.∘ Coker.proj (degreeHom f)) (Coker.proj (degreeHom f)) \lam b =>
                         pmap (\lam z => inverse f (Ab.map (piGroupMap 0 (Cof.inc f)) z)) (ZFree.extend-basis {Ab (PiGroup 0 (Bouquet 1 h))} (\lam a => in~ (circleBouquet.gen a)) b)
                         *> inverse-inc f (circleBouquet.gen b) *> pmap (Coker.proj (degreeHom f)) (bottom1.basis-generator b)))
      | f_sec y => pmap {AddGroupHom (Ab (PiGroup 0 (Cof.pointed f))) (Ab (PiGroup 0 (Cof.pointed f)))} (__ y)
                     (Ab.hom-ext {PiGroup 0 (Cof.pointed f)} {Ab (PiGroup 0 (Cof.pointed f))} (cofiberBottom1 f AddGroupHom.∘ inverse f) AddGroupHom.id \lam t =>
                       forward f _ *> pmap (\lam w => in~ (piMap 1 (shift (Cof.pointed f) (pmap pinl f.2)) w)) (path (\lam i => (Iso.f_hinv {iso f} @ i) _))
                       *> pmap in~ (shift-unshift (Cof.pointed f) (pmap pinl f.2) t))
  }
