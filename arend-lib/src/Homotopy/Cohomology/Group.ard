{- | The cohomology groups `CohomologyNat n X A` and `ReducedCohomologyNat n X A` in degree `n : Nat`.

 The carriers are the set truncations of `Cocycle n X A` and `ReducedCocycle n X A`, with the operations
 induced by the pointwise ones: `classOf` commutes with them definitionally. The group laws are those of the
 second homotopy group of the mapping space into `K A (n + 2)`, which `pi2Iso` identifies with cohomology.
 Recursors eliminate into any set and compute by `rec-eval` and `elim-eval`.
 -}

\import Algebra.Group
\import Algebra.Group.GroupCat
\import Algebra.Group.GroupHom
\import Algebra.Group.Transfer
\import Algebra.Monoid
\import Category (Iso)
\import Equiv
\import Function (IsInj)
\import Homotopy.Cohomology.Definition
\import Homotopy.EilenbergMacLane.Definition
\import Homotopy.HomotopyGroup
\import Homotopy.Pointed (Pointed, PointedEquiv)
\import Homotopy.Pointed.Mapping
\import Logic.Unique (isSet)
\import Paths
\import Set

\func CohomologyNat.{u} (n : Nat) (X : \Type u) (A : AbGroup.{u}) : AbGroup.{u}
  => injectiveAbGroup (pi2Target n X A) (toPi2-map n X A) (toPi2-inj n X A)
                      (in0 Cocycle.zero) (\lam c d => Trunc0.map2 c d Cocycle.add) (\lam c => Trunc0.map c Cocycle.neg)
                      (pmap in0 (Cocycle.toDoubleLoop n X A).map.2) (toPi2-+ n X A) (toPi2-neg n X A)
  \where {
    \func pi2Target.{u} (n : Nat) (X : \Type u) (A : AbGroup.{u}) : AbGroup.{u}
      => AbGroup.fromCGroup (PiCGroup 0 (Map X (K A (suc (suc n)))))

    \func toPi2-map.{u} (n : Nat) (X : \Type u) (A : AbGroup.{u}) (c : Trunc0 (Cocycle n X A)) : pi2Target n X A
      => Trunc0.map c (Cocycle.toDoubleLoop n X A).map.1

    \lemma toPi2-inj.{u} (n : Nat) (X : \Type u) (A : AbGroup.{u}) : IsInj (toPi2-map n X A)
      => \lam p => IsEquiv.isInj (Trunc0.map-isEquiv (Cocycle.toDoubleLoop n X A).map-isEquiv) p

    \lemma toPi2-+.{u} (n : Nat) (X : \Type u) (A : AbGroup.{u}) (c d : Trunc0 (Cocycle n X A))
      : toPi2-map n X A (Trunc0.map2 c d Cocycle.add) = (AddMonoid.+ {pi2Target n X A}) (toPi2-map n X A c) (toPi2-map n X A d) \elim c, d
      | in0 f, in0 g => pmap in0 (Cocycle.toDoubleLoop.add f g)

    \lemma toPi2-neg.{u} (n : Nat) (X : \Type u) (A : AbGroup.{u}) (c : Trunc0 (Cocycle n X A))
      : toPi2-map n X A (Trunc0.map c Cocycle.neg) = (AddGroup.negative {pi2Target n X A}) (toPi2-map n X A c) \elim c
      | in0 f => pmap in0 (Cocycle.toDoubleLoop.neg f)

    \func classOf.{u} {n : Nat} {X : \Type u} {A : AbGroup.{u}} (f : Cocycle n X A) : CohomologyNat n X A
      => in0 f

    \func rec.{u} {n : Nat} {X : \Type u} {A : AbGroup.{u}} {B : \Type} (p : isSet B) (f : Cocycle n X A -> B) (c : CohomologyNat n X A) : B
      => Trunc0.rec p c f

    \lemma rec-eval.{u} {n : Nat} {X : \Type u} {A : AbGroup.{u}} {B : \Type} {p : isSet B} {f : Cocycle n X A -> B} {g : Cocycle n X A}
      : rec p f (classOf g) = f g \level p _ _
      => Trunc0.rec-eval

    \func elim.{u} {n : Nat} {X : \Type u} {A : AbGroup.{u}} {P : CohomologyNat n X A -> \Type}
                   (p : \Pi (c : CohomologyNat n X A) -> isSet (P c)) (f : \Pi (g : Cocycle n X A) -> P (classOf g)) (c : CohomologyNat n X A) : P c
      => Trunc0.elim p c f

    \lemma elim-eval.{u} {n : Nat} {X : \Type u} {A : AbGroup.{u}} {P : CohomologyNat n X A -> \Type}
                         {p : \Pi (c : CohomologyNat n X A) -> isSet (P c)} {f : \Pi (g : Cocycle n X A) -> P (classOf g)} {g : Cocycle n X A}
      : elim p f (classOf g) = f g \level p _ _ _
      => Trunc0.elim-eval

    \func toPi2.{u} (n : Nat) (X : \Type u) (A : AbGroup.{u}) : AddGroupHom (CohomologyNat n X A) (pi2Target n X A) \cowith
      | func => toPi2-map n X A
      | func-+ => toPi2-+ n X A _ _

    \func pi2Iso.{u} (n : Nat) (X : \Type u) (A : AbGroup.{u}) : Iso {AbGroupCat} (toPi2 n X A)
      => AbGroupCat.isoOfEquiv (toPi2 n X A) (Trunc0.mapEquiv (IsEquiv.toQEquiv (Cocycle.toDoubleLoop n X A).map-isEquiv))
  }

\func ReducedCohomologyNat.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) : AbGroup.{u}
  => injectiveAbGroup (pi2Target n X A) (toPi2-map n X A) (toPi2-inj n X A)
                      (in0 ReducedCocycle.zero) (\lam c d => Trunc0.map2 c d ReducedCocycle.add) (\lam c => Trunc0.map c ReducedCocycle.neg)
                      (pmap in0 (ReducedCocycle.toDoubleLoop n X A).map.2) (toPi2-+ n X A) (toPi2-neg n X A)
  \where {
    \func pi2Target.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) : AbGroup.{u}
      => AbGroup.fromCGroup (PiCGroup 0 (Map* X (K A (suc (suc n)))))

    \func toPi2-map.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) (c : Trunc0 (ReducedCocycle n X A)) : pi2Target n X A
      => Trunc0.map c (ReducedCocycle.toDoubleLoop n X A).map.1

    \lemma toPi2-inj.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) : IsInj (toPi2-map n X A)
      => \lam p => IsEquiv.isInj (Trunc0.map-isEquiv (ReducedCocycle.toDoubleLoop n X A).map-isEquiv) p

    \lemma toPi2-+.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) (c d : Trunc0 (ReducedCocycle n X A))
      : toPi2-map n X A (Trunc0.map2 c d ReducedCocycle.add) = (AddMonoid.+ {pi2Target n X A}) (toPi2-map n X A c) (toPi2-map n X A d) \elim c, d
      | in0 f, in0 g => pmap in0 (ReducedCocycle.toDoubleLoop.add f g)

    \lemma toPi2-neg.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) (c : Trunc0 (ReducedCocycle n X A))
      : toPi2-map n X A (Trunc0.map c ReducedCocycle.neg) = (AddGroup.negative {pi2Target n X A}) (toPi2-map n X A c) \elim c
      | in0 f => pmap in0 (ReducedCocycle.toDoubleLoop.neg f)

    \func classOf.{u} {n : Nat} {X : Pointed.{u}} {A : AbGroup.{u}} (f : ReducedCocycle n X A) : ReducedCohomologyNat n X A
      => in0 f

    \func rec.{u} {n : Nat} {X : Pointed.{u}} {A : AbGroup.{u}} {B : \Type} (p : isSet B) (f : ReducedCocycle n X A -> B)
                  (c : ReducedCohomologyNat n X A) : B
      => Trunc0.rec p c f

    \lemma rec-eval.{u} {n : Nat} {X : Pointed.{u}} {A : AbGroup.{u}} {B : \Type} {p : isSet B} {f : ReducedCocycle n X A -> B}
                        {g : ReducedCocycle n X A}
      : rec p f (classOf g) = f g \level p _ _
      => Trunc0.rec-eval

    \func elim.{u} {n : Nat} {X : Pointed.{u}} {A : AbGroup.{u}} {P : ReducedCohomologyNat n X A -> \Type}
                   (p : \Pi (c : ReducedCohomologyNat n X A) -> isSet (P c)) (f : \Pi (g : ReducedCocycle n X A) -> P (classOf g))
                   (c : ReducedCohomologyNat n X A) : P c
      => Trunc0.elim p c f

    \lemma elim-eval.{u} {n : Nat} {X : Pointed.{u}} {A : AbGroup.{u}} {P : ReducedCohomologyNat n X A -> \Type}
                         {p : \Pi (c : ReducedCohomologyNat n X A) -> isSet (P c)} {f : \Pi (g : ReducedCocycle n X A) -> P (classOf g)}
                         {g : ReducedCocycle n X A}
      : elim p f (classOf g) = f g \level p _ _ _
      => Trunc0.elim-eval

    \func toPi2.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) : AddGroupHom (ReducedCohomologyNat n X A) (pi2Target n X A) \cowith
      | func => toPi2-map n X A
      | func-+ => toPi2-+ n X A _ _

    \func pi2Iso.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) : Iso {AbGroupCat} (toPi2 n X A)
      => AbGroupCat.isoOfEquiv (toPi2 n X A) (Trunc0.mapEquiv (IsEquiv.toQEquiv (ReducedCocycle.toDoubleLoop n X A).map-isEquiv))

    -- | The comparison with the fundamental group of the mapping space into `K A (n + 1)`.
    \func toPi1.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u})
      : AddGroupHom (ReducedCohomologyNat n X A) (AddGroup.fromGroup (PiGroup 0 (Map* X (K A (suc n))))) \cowith
      | func c => Trunc0.map c (ReducedCocycle.toLoop n X A).map.1
      | func-+ {c} {d} => \case \elim c, \elim d \with {
        | in0 f, in0 g => pmap in0 (ReducedCocycle.toLoop.add f g)
      }

    \lemma toPi1-inj.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) : IsInj (toPi1 n X A)
      => \lam p => IsEquiv.isInj (Trunc0.map-isEquiv (ReducedCocycle.toLoop n X A).map-isEquiv) p
  }
