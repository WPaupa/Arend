\import Homotopy.Cofiber
\import Homotopy.Cofiber.Null
\import Homotopy.Cofiber.NullCode
\import Homotopy.Pointed
\import Homotopy.Pointed.Mapping
\import Homotopy.Pushout \hiding (PushoutPointed)
\import Homotopy.Smash
\import Homotopy.Smash.Cofiber
\import Homotopy.Smash.LeftFib
\import Paths

\open ->* (∘*)
\open PushoutData (ppglue)

\func rKf.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (x : X) (z : K)
  : ->*.happly (rK.{u} f K) (Smash.proj.1 (x, z))
    = pmap (\lam (c : Cof f.1) => (Smash.proj.{u} {Cof.pointed f} {K}).1 (c, z)) (->*.happly (Cof.inc-null f) x)
      *> pmap (\lam (G : K ->* Smash.{u} (Cof.pointed f) K) => G.1 z) (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id).2
  => pmap (pmap (\lam (G : X ->* Map* K (Smash.{u} (Cof.pointed f) K)) => (G.1 x).1 z)) (etaK.{u} f K *> \peval bK.{u} f K)
     *> CofNull.mapsOut.pre.dist3 (\lam (G : X ->* Map* K (Smash.{u} (Cof.pointed f) K)) => (G.1 x).1 z)
          (cofSmashEquiv.pre'.{u} {X} {Y} {K} {Smash.{u} (Cof.pointed f) K} f (qK.{u} f K))
          (pmap (\lam (h : Y ->* Map* K (Smash.{u} (Cof.pointed f) K)) => h ∘* f) (aK.{u} f K)) (dK.{u} f K).2
     *> gen (pmap (\lam (d : CofNull.{u} f (Map* K (Smash.{u} (Cof.pointed f) K))) => (d.1.1 (f.1 x)).1 z)
                  (CofNull.mapsOut.eval.{u} {X} {Y} {Map* K (Smash.{u} (Cof.pointed f) K)} {f}
                                            (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id)))
            (pmap (\lam (G : K ->* Smash.{u} (Cof.pointed f) K) => G.1 z)
                  (Cof.restrict.axis (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id) (ppglue x)))
            (cofSmashEquiv.E.post.pre'-first.{u} f (qK.{u} f K) x z)
            (pmap (pmap (\lam (G : Y ->* Map* K (Smash.{u} (Cof.pointed f) K)) => (G.1 (f.1 x)).1 z)) (\peval aK.{u} f K)
             *> CofNull.mapsOut.pre.dist3 (\lam (G : Y ->* Map* K (Smash.{u} (Cof.pointed f) K)) => (G.1 (f.1 x)).1 z)
                  (cofSmashEquiv.pre'.{u} {Y} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} (Cof.inc f) ->*.id)
                  (inv (CofNull.mapsOut.star {X} {Y} {Map* K (Smash.{u} (Cof.pointed f) K)} {f}
                                             (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id)))
                  (pmap (\lam (d : CofNull.{u} f (Map* K (Smash.{u} (Cof.pointed f) K))) => d.1)
                        (inv (CofNull.mapsOut.eval.{u} {X} {Y} {Map* K (Smash.{u} (Cof.pointed f) K)} {f}
                                                       (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id)))))
            (cofSmashEquiv.E.post.pre'-first.{u} (Cof.inc f) ->*.id (f.1 x) z)
            (pmap_inv-comm (\lam (G : Y ->* Map* K (Smash.{u} (Cof.pointed f) K)) => (G.1 (f.1 x)).1 z)
                           (CofNull.mapsOut.star {X} {Y} {Map* K (Smash.{u} (Cof.pointed f) K)} {f}
                                                 (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id)))
            (pmap_inv-comm (\lam (d : CofNull.{u} f (Map* K (Smash.{u} (Cof.pointed f) K))) => (d.1.1 (f.1 x)).1 z)
                           (CofNull.mapsOut.eval.{u} {X} {Y} {Map* K (Smash.{u} (Cof.pointed f) K)} {f}
                                                     (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id)))
            (pmap (pmap (\lam (G : K ->* Smash.{u} (Cof.pointed f) K) => G.1 z))
                  (cone.{u} (CofNull.mapsOut.eval.{u} {X} {Y} {Map* K (Smash.{u} (Cof.pointed f) K)} {f}
                                                      (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id)) x)
             *> pmap_*>-comm (\lam (G : K ->* Smash.{u} (Cof.pointed f) K) => G.1 z) _ _)
     *> tl (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id).1 (\lam (G : K ->* Smash.{u} (Cof.pointed f) K) => G.1 z)
           (ppglue x) (ppglue base) (pmap pinl f.2) (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id).2
  \where {
    \func gen {T : \Type} {p q r : T} {A1 : p = p} {A2 : p = q} {A3 : q = r} {B1 B2 : p = p} {B3 : p = q} (W : q = p) (R : p = r)
              (h1 : A1 = idp) (h2 : A2 = B1 *> B2 *> B3) (hb1 : B1 = idp) (hb2 : B2 = idp) (hb3 : B3 = inv W) (h3 : A3 = W *> R)
      : A1 *> A2 *> A3 = R \elim h1, h2, hb1, hb2, hb3, h3
      | idp, idp, idp, idp, idp, idp => raw W R

    \func raw {T : \Type} {p q r : T} (W : q = p) (R : p = r) : idp *> (idp *> idp *> inv W) *> (W *> R) = R \elim W, R
      | idp, idp => idp

    \func tl {C D E : \Type} (g : C -> D) (e : D -> E) {a r b0 b1 : C} (Gx : a = r) (Gb : b0 = r) (F2 : b0 = b1) {d : D} (g2 : g b1 = d)
      : pmap e (pmap g Gx *> inv (pmap g Gb) *> pmap g F2 *> g2) = pmap (\lam c => e (g c)) (Gx *> inv Gb *> F2) *> pmap e g2 \elim r, Gb, F2, g2
      | _, idp, idp, idp => idp
  }
