\import Homotopy.Pointed
\import Homotopy.Pointed.Mapping
\import Homotopy.Pushout \hiding (PushoutPointed)
\import Homotopy.Smash
\import Homotopy.Smash.Code
\import Homotopy.Smash.Cofiber
\import Homotopy.Smash.CoreScalar
\import Homotopy.Smash.PostBeta
\import Paths

\open ->* (∘*)
\open PushoutData (ppglue)

\func lrp.{u} {X Y K T : Pointed.{u}} (h : Smash.{u} Y K ->* T) (f : X ->* Y) (x : X)
  : pmap (\lam (b : Ax.{u} {X} {K} {T} (Smash.restrict.{u} (h ∘* Smash.map.{u} f (->*.id {K}))).1) => b.1 x)
         (V.{u} {X} {K} {T} {Smash.restrict.{u} (h ∘* Smash.map.{u} f (->*.id {K}))} {Vc.ax.{u} (SmashCocone.pre.{u} f (->*.id {K}) (Smash.restrict.{u} h))}
                (Smash.restrict-pre.{u} h f (->*.id {K})) (Smash.restrict-pre.first.{u} h f (->*.id {K})))
    = cR {Smash.{u} Y K} (ppglue (pinl (f.1 x))) (ppglue (pinl (f.1 base))) (ppglue (pinl base)) h.1 h.2
  => pmap (pmap (\lam (b : Ax.{u} {X} {K} {T} (Smash.restrict.{u} (h ∘* Smash.map.{u} f (->*.id {K}))).1) => b.1 x)) (rp.{u} h f (->*.id {K}))
     *> cofSmashEquiv.E.post.ev4 (\lam (b : Ax.{u} {X} {K} {T} (Smash.restrict.{u} (h ∘* Smash.map.{u} f (->*.id {K}))).1) => b.1 x) _ _ _ _
     *> pmap2 (*>) (pmap (pmap (\lam (b : Ax.{u} {X} {K} {T} (Smash.restrict.{u} (h ∘* Smash.map.{u} f (->*.id {K}))).1) => b.1 x))
                         (rp.rpost.{u} h (Smash.map.{u} f (->*.id {K})))
                    *> Vc.axpath.left.{u} _ _ _ x)
       (pmap2 (*>) (pmap (pmap (\lam (b : Ax.{u} {X} {K} {T} (Smash.restrict.{u} (h ∘* Smash.map.{u} f (->*.id {K}))).1) => b.1 x))
                         (rp.bsec.{u} h (SmashCocone.pre.{u} f (->*.id {K}) (Smash.restrict.{u} (->*.id {Smash.{u} Y K})))))
         (pmap2 (*>) (pmap (pmap (\lam (b : Ax.{u} {X} {K} {T} (Smash.restrict.{u} (h ∘* Smash.map.{u} f (->*.id {K}))).1) => b.1 x))
                           (rp.ppost.{u} h f (->*.id {K}) (Smash.restrict.{u} (->*.id {Smash.{u} Y K})))
                      *> Vc.axpath.left.{u} _ _ _ x
                      *> pmap (`*> idp_*> _) (pax (\lam (y : K) => (pinl (f.1 x, y) : Smash.{u} Y K)) _ h.1 h.2))
           (pmap (pmap (\lam (b : Ax.{u} {X} {K} {T} (Smash.restrict.{u} (h ∘* Smash.map.{u} f (->*.id {K}))).1) => b.1 x))
                 (rp.rpD.{u} h f (->*.id {K}))
            *> pmap (pmap (idp *>))
                    (pmap_*>-comm (\lam (b : Ax.{u} {Y} {K} {T} (Smash.restrict.{u} (h ∘* ->*.id)).1) => b.1 (f.1 x)) _ _
                     *> pmap (`*> _) (pmap_inv-comm (\lam (b : Ax.{u} {Y} {K} {T} (Smash.restrict.{u} (h ∘* ->*.id)).1) => b.1 (f.1 x)) _
                                      *> pmap inv (pmap (pmap (\lam (b : Ax.{u} {Y} {K} {T} (Smash.restrict.{u} (h ∘* ->*.id)).1) => b.1 (f.1 x)))
                                                        (rp.rpost.{u} h (->*.id {Smash.{u} Y K}))
                                                   *> Vc.axpath.left.{u} _ _ _ (f.1 x)))))))

\func vP.{u} {X Y K T : Pointed.{u}} (f : X ->* Y) (h : Smash.{u} Y K ->* T) (x : X)
  : nc (->*.happly (cofSmashEquiv.pre'.{u} f h) x) (cofSmashEquiv.E.post.pre'-first.{u} f h x base)
    = cP {Smash.{u} Y K} (ppglue (pinl (f.1 x))) (ppglue (pinl (f.1 base))) (ppglue (pinl base)) h.1 h.2
  => nP'.{u} f h x *> pmap (_ *>) (pmap (_ *>) (pmap (_ *>) (pmap (_ *>) (pmap (_ *>) (pmap inv (lrp.{u} h f x))))))

\func vN.{l} {X Y T T' : Pointed.{l}} (k : T ->* T') (g : Smash.{l} X Y ->* T) (x : X)
  : nc (->*.happly (Smash.adjunction.post.{l} k g) x) (Smash.adjunction.post-first.{l} k g x base)
    = cN k.1 (pmap g.1 (ppglue (pinl x))) (pmap g.1 (ppglue (pinl base))) g.2 k.2
  => nN.{l} k g x
     *> pmap (\lam v => *>-assoc idp idp _ *> (pmap (idp *>) (idp_*> _) *> (idp_*> _ *> inv v)))
             (pmap (pmap (\lam (b : Ax.{l} {X} {Y} {T'} (Smash.restrict.{l} (k ∘* g)).1) => b.1 x)) (rp.rpost.{l} k g)
              *> Vc.axpath.left.{l} _ _ _ x)

\func ncat.{u} {X K T : Pointed.{u}} {h h' h'' : Smash.{u} X K ->* T} (Q1 : h = h') (Q2 : h' = h'') (x : X)
  : nc (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T}) (Q1 *> Q2)) x) idp
    = pmap (`*> ((Smash.adjunction.{u} {X} {K} {T} h'').1 x).2)
           (pmap_*>-comm (\lam (s : Smash.{u} X K ->* T) => ((Smash.adjunction.{u} {X} {K} {T} s).1 x).1 base) Q1 Q2)
      *> (*>-assoc _ _ _
      *> (pmap (pmap (\lam (s : Smash.{u} X K ->* T) => ((Smash.adjunction.{u} {X} {K} {T} s).1 x).1 base) Q1 *>)
               (nc (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T}) Q2) x) idp)
      *> nc (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T}) Q1) x) idp)) \elim Q2
  | idp => catl (pmap (\lam (s : Smash.{u} X K ->* T) => ((Smash.adjunction.{u} {X} {K} {T} s).1 x).1 base) Q1)
                ((Smash.adjunction.{u} {X} {K} {T} h').1 x).2 (nc (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T}) Q1) x) idp)
           *> pmap (\lam v => idp *> (*>-assoc _ idp _ *> (pmap (pmap (\lam (s : Smash.{u} X K ->* T) => ((Smash.adjunction.{u} {X} {K} {T} s).1 x).1 base) Q1 *>) v
                                                         *> nc (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T}) Q1) x) idp)))
                   (inv (nc.ev (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T}) (idp {Smash.{u} X K ->* T} {h'})) x) idp))

\func nposts.{u} {X K T T' : Pointed.{u}} (k : T ->* T') {h h' : Smash.{u} X K ->* T} (Q : h = h') (x : X)
  : nc (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T'}) (pmap (k ∘*) Q)) x) idp
    = pmap (pmap k.1 (pmap (\lam (s : Smash.{u} X K ->* T) => ((Smash.adjunction.{u} {X} {K} {T} s).1 x).1 base) Q) *>)
           (Smash.restrict-post.axis-post.{u} k h' (ppglue (pinl x)))
      *> (jj k.1 (pmap (\lam (s : Smash.{u} X K ->* T) => ((Smash.adjunction.{u} {X} {K} {T} s).1 x).1 base) Q)
             ((Smash.adjunction.{u} {X} {K} {T} h').1 x).2 k.2
      *> (pmap (\lam v => idp *> (pmap k.1 v *> k.2)) (nc (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T}) Q) x) idp)
      *> inv (Smash.restrict-post.axis-post.{u} k h (ppglue (pinl x))))) \elim Q
  | idp => nc.ev (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T'}) (idp {Smash.{u} X K ->* T'} {k ∘* h})) x) idp
           *> postl k.1 ((Smash.adjunction.{u} {X} {K} {T} h).1 x).2 k.2 (Smash.restrict-post.axis-post.{u} k h (ppglue (pinl x)))
           *> pmap (\lam v => pmap (idp *>) (Smash.restrict-post.axis-post.{u} k h (ppglue (pinl x)))
                              *> (jj k.1 idp ((Smash.adjunction.{u} {X} {K} {T} h).1 x).2 k.2
                              *> (pmap (\lam v => idp *> (pmap k.1 v *> k.2)) v *> inv (Smash.restrict-post.axis-post.{u} k h (ppglue (pinl x))))))
                   (inv (nc.ev (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T}) (idp {Smash.{u} X K ->* T} {h})) x) idp))

\func nas0.{l} {X K : Pointed.{l}} {E : \Type l} (h1 : Smash.{l} X K -> E) {e : E} {c c' : h1 (base {Smash.{l} X K}) = e} (q : idp *> c' = c) (x : X)
  => pmap (nc (->*.happly (pmap (Smash.adjunction.{l} {X} {K} {Pointed.make e}) (inv (->*.ext {Smash.{l} X K} {Pointed.make e} {h1, c} {h1, c'} (\lam _ => idp) q))) x))
          (inv (*>_inv (pmap_inv-comm (\lam (s : Smash.{l} X K ->* Pointed.make e) => ((Smash.adjunction.{l} {X} {K} {Pointed.make e} s).1 x).1 base)
                                      (->*.ext {Smash.{l} X K} {Pointed.make e} {h1, c} {h1, c'} (\lam _ => idp) q))))
     *> nc.end (->*.happly (pmap (Smash.adjunction.{l} {X} {K} {Pointed.make e}) (inv (->*.ext {Smash.{l} X K} {Pointed.make e} {h1, c} {h1, c'} (\lam _ => idp) q))) x)
               (pmap_inv-comm (\lam (s : Smash.{l} X K ->* Pointed.make e) => ((Smash.adjunction.{l} {X} {K} {Pointed.make e} s).1 x).1 base)
                              (->*.ext {Smash.{l} X K} {Pointed.make e} {h1, c} {h1, c'} (\lam _ => idp) q))
               (inv (pmap_inv-comm (\lam (s : Smash.{l} X K ->* Pointed.make e) => ((Smash.adjunction.{l} {X} {K} {Pointed.make e} s).1 x).1 base)
                                   (->*.ext {Smash.{l} X K} {Pointed.make e} {h1, c} {h1, c'} (\lam _ => idp) q)))
     *> pmap (_ *>) (nas.{l} h1 q x)

\func nzk.{u} {X K T : Pointed.{u}} {E : \Type u} (k1 : T -> E) {e : E} (k2 : k1 base = e) (x : X)
  : nc (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {Pointed.make e}) (->*.compose-zero {Smash.{u} X K} {T} {Pointed.make e} (k1, k2))) x) idp
    = Zk k2 \elim e, k2
  | _, idp => nc.ev (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {Pointed.make (k1 base)})
                                      (->*.compose-zero {Smash.{u} X K} {T} {Pointed.make (k1 base)} (k1, idp))) x) idp

\func nzk'.{u} {X K T : Pointed.{u}} {E : \Type u} (k1 : T -> E) {e : E} (k2 : k1 base = e) (x : X)
  : nc (->*.happly (->*.compose-zero {X} {Map* K T} {Map* K (Pointed.make e)} (Map*.post K {T} {Pointed.make e} (k1, k2))) x) idp
    = inv (idp_*> k2) \elim e, k2
  | _, idp => nc.ev (->*.happly (->*.compose-zero {X} {Map* K T} {Map* K (Pointed.make (k1 base))} (Map*.post K {T} {Pointed.make (k1 base)} (k1, idp))) x) idp

\func sa.{u} {X Y K T T' : Pointed.{u}} (f : X ->* Y) (k : T ->* T') (g : Smash.{u} Y K ->* T)
             (p : g ∘* Smash.map.{u} f (->*.id {K}) = base {Map* (Smash.{u} X K) T}) (x : X)
  => pmap (nc (->*.happly (inv (cofSmashEquiv.pre'.{u} f (k ∘* g))
                           *> pmap (Smash.adjunction.{u} {X} {K} {T'})
                                   (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k)) x))
          (ra (pmap_*>-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base) (inv (cofSmashEquiv.pre'.{u} f (k ∘* g)))
                            (pmap (Smash.adjunction.{u} {X} {K} {T'})
                                  (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k)))
              (pmap (`*> pmap (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base)))
                              (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k))
                    (pmap_inv-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base) (cofSmashEquiv.pre'.{u} f (k ∘* g))
                     *> pmap inv (cofSmashEquiv.E.post.pre'-first.{u} f (k ∘* g) x base)))
              (idp_*> (pmap (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base)))
                            (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k)))
              (pmap_*>-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base)))
                            (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K})))) (pmap (k ∘*) p *> ->*.compose-zero k)
               *> pmap2 (*>) (pmap_inv-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base)))
                                            (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))))
                             (pmap_*>-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base))) (pmap (k ∘*) p) (->*.compose-zero k))
               *> idp_*> (pmap k.1 (pmap (\lam (h : Smash.{u} X K ->* T) => h.1 (Smash.proj.1 (x, base))) p) *> k.2)))
     *> nc.end (->*.happly (inv (cofSmashEquiv.pre'.{u} f (k ∘* g))
                            *> pmap (Smash.adjunction.{u} {X} {K} {T'})
                                    (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k)) x)
               (pmap_*>-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base) (inv (cofSmashEquiv.pre'.{u} f (k ∘* g)))
                             (pmap (Smash.adjunction.{u} {X} {K} {T'})
                                   (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k))
                *> pmap (`*> pmap (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base)))
                                (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k))
                      (pmap_inv-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base) (cofSmashEquiv.pre'.{u} f (k ∘* g))
                       *> pmap inv (cofSmashEquiv.E.post.pre'-first.{u} f (k ∘* g) x base)))
               (idp_*> (pmap (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base)))
                             (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k))
                *> (pmap_*>-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base)))
                                 (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K})))) (pmap (k ∘*) p *> ->*.compose-zero k)
                    *> pmap2 (*>) (pmap_inv-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base)))
                                                 (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))))
                                  (pmap_*>-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base))) (pmap (k ∘*) p) (->*.compose-zero k))
                    *> idp_*> (pmap k.1 (pmap (\lam (h : Smash.{u} X K ->* T) => h.1 (Smash.proj.1 (x, base))) p) *> k.2)))
     *> pmap (_ *>)
          (ncc (inv (cofSmashEquiv.pre'.{u} f (k ∘* g)))
               (pmap (Smash.adjunction.{u} {X} {K} {T'})
                     (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k)) x
               (pmap_inv-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base) (cofSmashEquiv.pre'.{u} f (k ∘* g))
                *> pmap inv (cofSmashEquiv.E.post.pre'-first.{u} f (k ∘* g) x base))
               (idp {_} {pmap (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                              (pmap (Smash.adjunction.{u} {X} {K} {T'})
                                    (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k))})
           *> pmap (_ *>) (pmap2 (*>)
                (pmap (pmap (_ *>))
                  (ncat (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K})))) (pmap (k ∘*) p *> ->*.compose-zero k) x
                   *> pmap (_ *>) (pmap (_ *>) (pmap2 (*>)
                        (pmap (pmap (_ *>))
                          (ncat (pmap (k ∘*) p) (->*.compose-zero k) x
                           *> pmap (_ *>) (pmap (_ *>) (pmap2 (*>) (pmap (pmap (_ *>)) (nzk.{u} {X} {K} {T} k.1 k.2 x)) (nposts.{u} k p x)))))
                        (nas0.{u} (\lam s => k.1 (g.1 ((Smash.map.{u} f (->*.id {K})).1 s)))
                                  (idp_*> _ *> inv (pmap (`*> k.2) (pmap_*>-comm k.1 (pmap g.1 (Smash.map.{u} f (->*.id {K})).2) g.2) *> *>-assoc _ _ _)) x)))))
                (nci (cofSmashEquiv.pre'.{u} f (k ∘* g)) x (cofSmashEquiv.E.post.pre'-first.{u} f (k ∘* g) x base)
                 *> pmap (\lam u => pmap (inv idp *>) (inv u) *> nc.inverse.lem idp _) (vP.{u} f (k ∘* g) x))))

\func sb.{u} {X Y K T T' : Pointed.{u}} (f : X ->* Y) (k : T ->* T') (g : Smash.{u} Y K ->* T)
             (p : g ∘* Smash.map.{u} f (->*.id {K}) = base {Map* (Smash.{u} X K) T}) (x : X)
  => pmap (nc (->*.happly (pmap (\lam (F : Y ->* Map* K T') => F ∘* f) (Smash.adjunction.post.{u} k g)
                           *> inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)
                           *> pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p)
                           *> ->*.compose-zero (Map*.post K k)) x))
          (pmap (`*> cofSmashEquiv.E.post.fin4 (Smash.adjunction.post-first.{u} k g (f.1 x) base)
                                               (pmap_inv-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                                              (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                                               (pmap (pmap k.1) (cofSmashEquiv.E.post.pre'-ev.{u} f g {p} x base)))
                (edec (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                      (pmap (\lam (F : Y ->* Map* K T') => F ∘* f) (Smash.adjunction.post.{u} k g))
                      (inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                      (pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p))
                      (->*.compose-zero (Map*.post K k)))
           *> pmap (_ *>) (fdec (Smash.adjunction.post-first.{u} k g (f.1 x) base)
                                (pmap_inv-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                               (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                                (pmap (pmap k.1) (cofSmashEquiv.E.post.pre'-ev.{u} f g {p} x base)))
           *> il _ _ _ (Smash.adjunction.post-first.{u} k g (f.1 x) base)
                       (pmap_inv-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                      (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                       (pmap (pmap k.1) (cofSmashEquiv.E.post.pre'-ev.{u} f g {p} x base)) _)
     *> nc.end (->*.happly (pmap (\lam (F : Y ->* Map* K T') => F ∘* f) (Smash.adjunction.post.{u} k g)
                            *> inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)
                            *> pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p)
                            *> ->*.compose-zero (Map*.post K k)) x)
               (pmap_*>-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                             (pmap (\lam (F : Y ->* Map* K T') => F ∘* f) (Smash.adjunction.post.{u} k g))
                             (inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)
                              *> pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p)
                              *> ->*.compose-zero (Map*.post K k))
                *> pmap2 (*>) (Smash.adjunction.post-first.{u} k g (f.1 x) base)
                     (pmap_*>-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                   (inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                                   (pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p)
                                    *> ->*.compose-zero (Map*.post K k))
                      *> pmap2 (*>) (pmap_inv-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                                   (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                           (pmap_*>-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                         (pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p))
                                         (->*.compose-zero (Map*.post K k))
                            *> pmap2 (*>) (pmap (pmap k.1) (cofSmashEquiv.E.post.pre'-ev.{u} f g {p} x base)) idp)))
               (idp_*> _ *> idp_*> _)
     *> pmap (_ *>)
          (ncc (pmap (\lam (F : Y ->* Map* K T') => F ∘* f) (Smash.adjunction.post.{u} k g))
               (inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)
                *> pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p)
                *> ->*.compose-zero (Map*.post K k)) x
               (Smash.adjunction.post-first.{u} k g (f.1 x) base)
               (pmap_*>-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                             (inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                             (pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p)
                              *> ->*.compose-zero (Map*.post K k))
                *> pmap2 (*>) (pmap_inv-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                             (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                     (pmap_*>-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                   (pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p))
                                   (->*.compose-zero (Map*.post K k))
                      *> pmap2 (*>) (pmap (pmap k.1) (cofSmashEquiv.E.post.pre'-ev.{u} f g {p} x base)) idp))
           *> pmap (_ *>) (pmap2 (*>)
                (pmap (pmap (_ *>))
                  (ncc (inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                       (pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p)
                        *> ->*.compose-zero (Map*.post K k)) x
                       (pmap_inv-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                      (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)
                        *> pmap inv (idp {_} {pmap (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                                   (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)}))
                       (pmap_*>-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                     (pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p))
                                     (->*.compose-zero (Map*.post K k))
                        *> pmap2 (*>) (pmap (pmap k.1) (cofSmashEquiv.E.post.pre'-ev.{u} f g {p} x base)) idp)
                   *> pmap (_ *>) (pmap2 (*>)
                        (pmap (pmap (_ *>))
                          (ncc (pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p))
                               (->*.compose-zero (Map*.post K k)) x
                               (pmap (pmap k.1) (cofSmashEquiv.E.post.pre'-ev.{u} f g {p} x base))
                               (idp {_} {pmap (\lam (G : X ->* Map* K T') => (G.1 x).1 base) (->*.compose-zero (Map*.post K k))})
                           *> pmap (_ *>) (pmap2 (*>)
                                (pmap (pmap (_ *>)) (nzk'.{u} {X} {K} {T} k.1 k.2 x))
                                (nc.post k (->*.happly (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p) x)
                                         (cofSmashEquiv.E.post.pre'-ev.{u} f g {p} x base)
                                 *> pmap (\lam u => inv (*>-assoc (pmap k.1 (pmap (\lam (h : Smash.{u} X K ->* T) => h.1 (Smash.proj.1 (x, base))) p))
                                                                  (pmap k.1 ((Smash.adjunction.{u} {X} {K} {T} (base {Map* (Smash.{u} X K) T})).1 x).2) k.2)
                                                    *> pmap (`*> k.2) (inv (pmap_*>-comm k.1 (pmap (\lam (h : Smash.{u} X K ->* T) => h.1 (Smash.proj.1 (x, base))) p)
                                                                                         ((Smash.adjunction.{u} {X} {K} {T} (base {Map* (Smash.{u} X K) T})).1 x).2)
                                                                       *> pmap (pmap k.1) u))
                                         (sbR.{u} f g p x)))))
                        (nci (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f) x
                             (idp {_} {pmap (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                            (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)})
                         *> pmap (\lam u => pmap (inv (pmap (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                                           (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)) *>) (inv u)
                                            *> nc.inverse.lem _ _)
                                 (nc.ev (->*.happly (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f) x)
                                        (idp {_} {pmap (\lam (G : X ->* Map* K T') => (G.1 x).1 base)
                                                       (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)}))))))
                (vN.{u} k g (f.1 x))))

\func sbR.{u} {X Y K T : Pointed.{u}} (f : X ->* Y) (g : Smash.{u} Y K ->* T)
              (p : g ∘* Smash.map.{u} f (->*.id {K}) = base {Map* (Smash.{u} X K) T}) (x : X)
  => pmap (nc (->*.happly (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p) x))
          (inv (*>-assoc (pmap_*>-comm (\lam (G : X ->* Map* K T) => (G.1 x).1 base) (inv (cofSmashEquiv.pre'.{u} f g))
                                       (pmap (Smash.adjunction.{u} {X} {K} {T}) p))
                         (pmap (`*> pmap (\lam (h : Smash.{u} X K ->* T) => h.1 (Smash.proj.1 (x, base))) p)
                               (pmap_inv-comm (\lam (G : X ->* Map* K T) => (G.1 x).1 base) (cofSmashEquiv.pre'.{u} f g)
                                *> pmap inv (cofSmashEquiv.E.post.pre'-first.{u} f g x base)))
                         (idp_*> (pmap (\lam (h : Smash.{u} X K ->* T) => h.1 (Smash.proj.1 (x, base))) p))))
     *> nc.end (->*.happly (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p) x)
               (pmap_*>-comm (\lam (G : X ->* Map* K T) => (G.1 x).1 base) (inv (cofSmashEquiv.pre'.{u} f g))
                             (pmap (Smash.adjunction.{u} {X} {K} {T}) p)
                *> pmap (`*> pmap (\lam (h : Smash.{u} X K ->* T) => h.1 (Smash.proj.1 (x, base))) p)
                        (pmap_inv-comm (\lam (G : X ->* Map* K T) => (G.1 x).1 base) (cofSmashEquiv.pre'.{u} f g)
                         *> pmap inv (cofSmashEquiv.E.post.pre'-first.{u} f g x base)))
               (idp_*> (pmap (\lam (h : Smash.{u} X K ->* T) => h.1 (Smash.proj.1 (x, base))) p))
     *> pmap (_ *>)
          (ncc (inv (cofSmashEquiv.pre'.{u} f g)) (pmap (Smash.adjunction.{u} {X} {K} {T}) p) x
               (pmap_inv-comm (\lam (G : X ->* Map* K T) => (G.1 x).1 base) (cofSmashEquiv.pre'.{u} f g)
                *> pmap inv (cofSmashEquiv.E.post.pre'-first.{u} f g x base))
               (idp {_} {pmap (\lam (G : X ->* Map* K T) => (G.1 x).1 base) (pmap (Smash.adjunction.{u} {X} {K} {T}) p)})
           *> pmap (_ *>) (pmap (_ *>)
                (nci (cofSmashEquiv.pre'.{u} f g) x (cofSmashEquiv.E.post.pre'-first.{u} f g x base)
                 *> pmap (\lam u => pmap (inv idp *>) (inv u) *> nc.inverse.lem idp _) (vP.{u} f g x))))

\func eB.{u} {X Y K T T' : Pointed.{u}} (f : X ->* Y) (k : T ->* T') (g : Smash.{u} Y K ->* T)
             (p : g ∘* Smash.map.{u} f (->*.id {K}) = base {Map* (Smash.{u} X K) T}) (x : X)
  => sa.{u} f k g p x
     *> iS {Smash.{u} Y K} (ppglue (pinl (f.1 x))) (ppglue (pinl (f.1 base))) (ppglue (pinl base)) g.1 g.2 k.1 k.2
           (nc (->*.happly (pmap (Smash.adjunction.{u} {X} {K} {T}) p) x) idp)
           (pmap_*>-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base))) (pmap (k ∘*) p) (->*.compose-zero k))
           (pmap_inv-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base))) (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))))
           (pmap_*>-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, base)))
                         (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K})))) (pmap (k ∘*) p *> ->*.compose-zero k))
     *> inv (sb.{u} f k g p x)

\func cbi.{u} {X Y K T T' : Pointed.{u}} (f : X ->* Y) (k : T ->* T') (g : Smash.{u} Y K ->* T)
              (p : g ∘* Smash.map.{u} f (->*.id {K}) = base {Map* (Smash.{u} X K) T}) (x : X)
  => nc.bi {K} {T'} {_} {_}
           { ->*.happly (inv (cofSmashEquiv.pre'.{u} f (k ∘* g))
                        *> pmap (Smash.adjunction.{u} {X} {K} {T'})
                                (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ∘*) p *> ->*.compose-zero k)) x}
           { ->*.happly (pmap (\lam (F : Y ->* Map* K T') => F ∘* f) (Smash.adjunction.post.{u} k g)
                        *> inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)
                        *> pmap (Map*.post K k ∘*) (inv (cofSmashEquiv.pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p)
                        *> ->*.compose-zero (Map*.post K k)) x}
           (cofSmashEquiv.E.post.lhs.{u} f k g p x base) (cofSmashEquiv.E.post.rhs.{u} f k g p x base) (eB.{u} f k g p x)
