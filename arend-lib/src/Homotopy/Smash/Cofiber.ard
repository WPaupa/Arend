\func cofSmashEquivRight.{u} (K : Pointed.{u}) {X Y : Pointed.{u}} (g : X ->* Y)
  : PointedEquiv (Cof.pointed (Smash.map.{u} (->*.id {K}) g)) (Smash.{u} K (Cof.pointed g))
  => Smash.swap.equiv.{u} (Cof.pointed g) K PointedEquiv.∘~ cofSmashEquiv.{u} g K PointedEquiv.∘~ E.{u} K g
  \where
    \func inc.{u} (K : Pointed.{u}) {X Y : Pointed.{u}} (g : X ->* Y)
      : (cofSmashEquivRight.{u} K g).map ->*.∘* Cof.inc (Smash.map.{u} (->*.id {K}) g) = Smash.map.{u} (->*.id {K}) (Cof.inc g)
      => inv (->*.compose-assoc (Smash.swap.{u} (Cof.pointed g) K ->*.∘* (cofSmashEquiv.{u} g K).map) (E.{u} K g).map (Cof.inc (Smash.map.{u} (->*.id {K}) g)))
         *> pmap ((Smash.swap.{u} (Cof.pointed g) K ->*.∘* (cofSmashEquiv.{u} g K).map) ->*.∘*)
                 (Cof.equiv.inc.{u} {Smash.{u} K X} {Smash.{u} K Y} {Smash.{u} X K} {Smash.{u} Y K}
                                    {Smash.map.{u} (->*.id {K}) g} {Smash.map.{u} g (->*.id {K})} (Smash.swap.equiv.{u} K X) (Smash.swap.equiv.{u} K Y) (\lam x => inv (->*.happly (Smash.swap.natural.{u} (->*.id {K}) g) x)))
         *> ->*.compose-assoc (Smash.swap.{u} (Cof.pointed g) K ->*.∘* (cofSmashEquiv.{u} g K).map) (Cof.inc (Smash.map.{u} g (->*.id {K}))) (Smash.swap.{u} K Y)
         *> pmap (->*.∘* Smash.swap.{u} K Y)
                 (inv (->*.compose-assoc (Smash.swap.{u} (Cof.pointed g) K) (cofSmashEquiv.{u} g K).map (Cof.inc (Smash.map.{u} g (->*.id {K}))))
                  *> pmap (Smash.swap.{u} (Cof.pointed g) K ->*.∘*) (cofSmashEquiv.inc.{u} g K)
                  *> Smash.swap.natural.{u} (Cof.inc g) (->*.id {K}))
         *> inv (->*.compose-assoc (Smash.map.{u} (->*.id {K}) (Cof.inc g)) (Smash.swap.{u} Y K) (Smash.swap.{u} K Y))
         *> pmap (Smash.map.{u} (->*.id {K}) (Cof.inc g) ->*.∘*) (Smash.swap.invol.{u} {K} {Y})
         *> ->*.compose-id (Smash.map.{u} (->*.id {K}) (Cof.inc g))

    \func E.{u} (K : Pointed.{u}) {X Y : Pointed.{u}} (g : X ->* Y)
      => Cof.equiv.{u} {Smash.{u} K X} {Smash.{u} K Y} {Smash.{u} X K} {Smash.{u} Y K}
                       {Smash.map.{u} (->*.id {K}) g} {Smash.map.{u} g (->*.id {K})} (Smash.swap.equiv.{u} K X)
                       (Smash.swap.equiv.{u} K Y) (\lam x => inv (->*.happly (Smash.swap.natural.{u} (->*.id {K}) g) x))

\func smashCorner.{u} {A X B Y : Pointed.{u}} (f : A ->* X) (g : B ->* Y)
  : PointedEquiv (Cof.pointed (cornerQuotient.corner.{u} (Smash.map.{u} (->*.id {A}) g) (Smash.map.{u} f (->*.id {B}))))
                 (Wedge.pointed.{u} (Smash.{u} A (Cof.pointed g)) (Smash.{u} (Cof.pointed f) B))
  => Wedge.map.equiv.{u} (cofSmashEquivRight.{u} A g) (cofSmashEquiv.{u} f B)
       PointedEquiv.∘~ cornerQuotient.{u} (Smash.map.{u} (->*.id {A}) g) (Smash.map.{u} f (->*.id {B}))
  \where {
    \func branch-left.{u} {A X B Y : Pointed.{u}} (f : A ->* X) (g : B ->* Y) (t : Smash.{u} A Y)
      : (smashCorner.{u} f g).map.1 (pinl (pinl t)) = pinl ((Smash.map.{u} (->*.id {A}) (Cof.inc g)).1 t)
      => pmap (Wedge.map.{u} (cofSmashEquivRight.{u} A g).map (cofSmashEquiv.{u} f B).map).1
              (cornerQuotient.branch-left.{u} (Smash.map.{u} (->*.id {A}) g) (Smash.map.{u} f (->*.id {B})) t)
         *> pmap pinl (->*.happly (cofSmashEquivRight.inc.{u} A g) t)

    \func branch-right.{u} {A X B Y : Pointed.{u}} (f : A ->* X) (g : B ->* Y) (t : Smash.{u} X B)
      : (smashCorner.{u} f g).map.1 (pinl (pinr t)) = pinr ((Smash.map.{u} (Cof.inc f) (->*.id {B})).1 t)
      => pmap (Wedge.map.{u} (cofSmashEquivRight.{u} A g).map (cofSmashEquiv.{u} f B).map).1
              (cornerQuotient.branch-right.{u} (Smash.map.{u} (->*.id {A}) g) (Smash.map.{u} f (->*.id {B})) t)
         *> pmap pinr (->*.happly (cofSmashEquiv.inc.{u} f B) t)
  }
