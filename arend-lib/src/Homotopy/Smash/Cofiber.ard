\import Data.Bool
\import Data.Or
\import Equiv
\import Equiv.Path
\import Equiv.Sigma
\import Homotopy.Cofiber
\import Homotopy.Cofiber.Corner
\import Homotopy.Cofiber.Null
\import Homotopy.Pointed
\import Homotopy.Pointed.Mapping
\import Homotopy.Pointed.Yoneda
\import Homotopy.Pushout \hiding (PushoutPointed)
\import Homotopy.Pushout.Grid
\import Homotopy.Smash
\import Homotopy.Smash.Pushout
\import Homotopy.Wedge
\import Logic
\import Logic.Unique
\import Paths

\open PushoutData (ppglue, congr, rec, homotopy)
\open SmashPushout (side, corner)

\func cofSmash.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u})
  : Cof.pointed (SmashPushout.map f (->*.id {K})) ->* SmashPushout (Cof.pointed f) K
  => (\lam c => cols f K (Grid.comparison (grid f K) (rows f K c)), pmap (cols f K) (Grid.comparison.corner02 (grid f K) (base, base)))
  \where {
    \func unit.{v} (X : Pointed.{v}) : X ->* UnitPointed
      => (\lam _ => (), idp)

    \func grid.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) : Grid \cowith
      | A00 => Bool
      | A01 => Or Y K
      | A02 => \Sigma Y K
      | A10 => Bool
      | A11 => Or X K
      | A12 => \Sigma X K
      | A20 => Bool
      | A21 => Or (\Sigma) K
      | A22 => \Sigma (\Sigma) K
      | f01 => side Y K
      | f03 => corner Y K
      | f11 => side X K
      | f13 => corner X K
      | f21 => side UnitPointed K
      | f23 => corner UnitPointed K
      | g10 b => b
      | g30 b => b
      | g11 => Or.map __ f.1 (->*.id {K}).1
      | g31 => Or.map __ (unit X).1 (->*.id {K}).1
      | g12 t => (f.1 t.1, (->*.id {K}).1 t.2)
      | g32 t => ((unit X).1 t.1, (->*.id {K}).1 t.2)
      | s00 => SmashPushout.map.alpha f.1 (->*.id {K}).1
      | s02 => SmashPushout.map.beta f ->*.id
      | s20 => SmashPushout.map.alpha (unit X).1 (->*.id {K}).1
      | s22 => SmashPushout.map.beta (unit X) ->*.id

    \func center.{u} (K : Pointed.{u}) : SmashPushout UnitPointed K
      => Contr.center {SmashPushout.unit-left K}

    \func centerEquiv.{u} (K : Pointed.{u}) : QEquiv {\Sigma} {SmashPushout UnitPointed K} \cowith
      | f _ => center K
      | ret _ => ()
      | ret_f _ => idp
      | f_sec => Contr.contraction {SmashPushout.unit-left K}

    \func rows.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (c : Cof (SmashPushout.map f (->*.id {K})).1) : Grid.Prows {grid f K}
      => congr _ _ (Grid.r0 {grid f K}) (Grid.r2 {grid f K}) (\lam s => s) (\lam s => s) (centerEquiv K) (\lam _ => idp)
               (\lam s => inv (Contr.contraction {SmashPushout.unit-left K} (Grid.r2 {grid f K} s))) c

    \lemma rows-isEquiv.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) : IsEquiv (rows f K)
      => congr.isEquiv _ _ _ _ idEquiv idEquiv (centerEquiv K) (\lam _ => idp)
                       (\lam s => inv (Contr.contraction {SmashPushout.unit-left K} (Grid.r2 {grid f K} s)))

    \func cols.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (z : Grid.Pcols (grid f K)) : SmashPushout (Cof.pointed f) K
      => congr (Grid.r0 {Grid.transpose (grid f K)}) (Grid.r2 {Grid.transpose (grid f K)}) (side (Cof.pointed f) K) (corner (Cof.pointed f) K)
               (jTo f.1) (PushoutData.collapse (\lam (b : Bool) => b)) (bTo f.1) (alpha f K) (beta f K) z

    \lemma cols-isEquiv.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) : IsEquiv (cols f K)
      => congr.isEquiv _ _ _ _ (jEquiv f.1) (PushoutData.collapse (\lam (b : Bool) => b)) (bEquiv f.1) (alpha f K) (beta f K)

    \lemma isEquiv.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) : IsEquiv (cofSmash f K).1
      => IsEquiv.trans (rows-isEquiv f K) (IsEquiv.trans (inP (Grid.comparison (grid f K))) (cols-isEquiv f K))

    \func inc.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (t : \Sigma Y K)
      : (cofSmash f K).1 (pinl (pinr t)) = pinr ((Cof.inc f).1 t.1, t.2)
      => pmap (cols f K) (Grid.comparison.corner02 (grid f K) t)

    \func inc-natural.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u})
      : cofSmash f K ->*.∘* Cof.inc (SmashPushout.map f (->*.id {K})) = SmashPushout.map (Cof.inc f) (->*.id {K})
      => ->*.ext (homotopy {_} {_} {_} {_} {_} {_} {\lam s => cols f K (Grid.comparison (grid f K) (pinl s))} {(SmashPushout.map (Cof.inc f) (->*.id {K})).1}
                          (\lam b => pmap (cols f K) (Grid.comparison.corner00 (grid f K) b)) (inc f K) (inc-glue f K))
                 (inv (idp_*> _))
      \where {
        \func inc-glue.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (w : Or Y K)
          : pmap (cols f K) (Grid.comparison.corner00 (grid f K) (side Y K w)) *> pmap (SmashPushout.map (Cof.inc f) (->*.id {K})).1 (ppglue w)
            = pmap (\lam s => cols f K (Grid.comparison (grid f K) (pinl s))) (ppglue w) *> inc f K (corner Y K w) \elim w
          | inl y => cancel-end _ _ _ *> inv (pmap (`*> inc f K (corner Y K (inl y))) (edge f K (inl y)))
          | inr k => cancel-end _ _ _ *> inv (pmap (`*> inc f K (corner Y K (inr k))) (edge f K (inr k)))

        \func edge.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (w : Or Y K)
          : pmap (\lam s => cols f K (Grid.comparison (grid f K) (pinl s))) (ppglue w)
            = pmap (cols f K) (Grid.comparison.corner00 (grid f K) (side Y K w)) *> pmap (cols f K) (ppglue (pinl w))
              *> inv (pmap (cols f K) (Grid.comparison.corner02 (grid f K) (corner Y K w)))
          => pmap (pmap (cols f K)) (Grid.comparison.edge01 (grid f K) w) *> dist (cols f K) _ _ _

        \func dist {S T : \Type} (h : S -> T) {a b c d : S} (p : a = b) (q : b = c) (r : d = c)
          : pmap h (p *> q *> inv r) = pmap h p *> pmap h q *> inv (pmap h r) \elim c, r
          | _, idp => pmap_*>-comm h p q

        \func cancel-end {T : \Type} {a b c d : T} (p : a = b) (q : b = c) (r : d = c) : p *> q = (p *> q *> inv r) *> r \elim d, r
          | _, idp => idp
      }

    \func jTo {X Y K : \Type} (f : X -> Y)
              (z : PushoutData {Or X K} {Or Y K} {Or (\Sigma) K} (Or.map __ f (\lam k => k)) (Or.map __ (\lam _ => ()) (\lam k => k))) : Or (Cof f) K
      => rec (Or.map __ pinl (\lam k => k)) (Or.map __ (\lam _ => apex f) (\lam k => k)) (jglue f) z

    \func jglue {X Y K : \Type} (f : X -> Y) (w : Or X K)
      : Or.map (Or.map w f (\lam k => k)) pinl (\lam k => k) = Or.map (Or.map w (\lam _ => ()) (\lam k => k)) (\lam _ => apex f) (\lam k => k) \elim w
      | inl x => pmap inl (ppglue x)
      | inr _ => idp

    \func apex {X Y : \Type} (f : X -> Y) : Cof f
      => pinr ()

    \func jFrom {X Y K : \Type} (f : X -> Y) (o : Or (Cof f) K)
      : PushoutData {Or X K} {Or Y K} {Or (\Sigma) K} (Or.map __ f (\lam k => k)) (Or.map __ (\lam _ => ()) (\lam k => k)) \elim o
      | inl c => rec (\lam y => pinl (inl y)) (\lam _ => pinr (inl ())) (\lam x => ppglue (inl x)) c
      | inr k => pinl (inr k)

    \func jEquiv {X Y K : \Type} (f : X -> Y) : QEquiv (jTo {X} {Y} {K} f) \cowith
      | ret => jFrom f
      | ret_f => homotopy {_} {_} {_} {_} {_} {_} {\lam z => jFrom f (jTo f z)} {\lam z => z} jl jr
                          (\case \elim __ \with {
                            | inl _ => idp_*> _
                            | inr _ => idp
                          })
      | f_sec o => \case \elim o \with {
        | inl c => homotopy {_} {_} {_} {_} {_} {_} {\lam c => jTo f (jFrom f (inl c))} {inl} (\lam _ => idp) (\lam _ => idp) (\lam _ => idp_*> _) c
        | inr _ => idp
      }
      \where {
        \func jl {X Y K : \Type} {f : X -> Y} (w : Or Y K) : jFrom {X} {Y} {K} f (jTo f (pinl w)) = pinl w \elim w
          | inl _ => idp
          | inr _ => idp

        \func jr {X Y K : \Type} {f : X -> Y} (w : Or (\Sigma) K) : jFrom {X} {Y} {K} f (jTo f (pinr w)) = pinr w \elim w
          | inl _ => idp
          | inr k => ppglue (inr k)
      }

    \func bTo {X Y K : \Type} (f : X -> Y) (z : PushoutData {\Sigma X K} {\Sigma Y K} {\Sigma (\Sigma) K} (\lam t => (f t.1, t.2)) (\lam t => ((), t.2)))
      : \Sigma (Cof f) K
      => rec (\lam t => (pinl t.1, t.2)) (\lam t => (pinr (), t.2)) (\lam t => pmap (\lam c => (c, t.2)) (ppglue t.1)) z

    \func bFrom {X Y K : \Type} (f : X -> Y) (k : K) (c : Cof f)
      : PushoutData {\Sigma X K} {\Sigma Y K} {\Sigma (\Sigma) K} (\lam t => (f t.1, t.2)) (\lam t => ((), t.2))
      => rec (\lam y => pinl (y, k)) (\lam _ => pinr ((), k)) (\lam x => ppglue (x, k)) c

    \func bEquiv {X Y K : \Type} (f : X -> Y) : QEquiv (bTo {X} {Y} {K} f) \cowith
      | ret t => bFrom f t.2 t.1
      | ret_f => homotopy {_} {_} {_} {_} {_} {_} {\lam z => bFrom f (bTo f z).2 (bTo f z).1} {\lam z => z} (\lam _ => idp) (\lam _ => idp) (\lam _ => idp_*> _)
      | f_sec t => homotopy {_} {_} {_} {_} {_} {_} {\lam c => bTo f (bFrom f t.2 c)} {\lam c => (c, t.2)} (\lam _ => idp) (\lam _ => idp) (\lam _ => idp_*> _) t.1

    \func alpha.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (z : Grid.R1 {Grid.transpose (grid f K)})
      : side (Cof.pointed f) K (jTo f.1 z) = PushoutData.collapse.map (\lam (b : Bool) => b) (Grid.r0 {Grid.transpose (grid f K)} z)
      => homotopy {_} {_} {_} {_} {_} {_} {\lam z => side (Cof.pointed f) K (jTo f.1 z)} {\lam z => PushoutData.collapse.map (\lam (b : Bool) => b) (Grid.r0 {Grid.transpose (grid f K)} z)}
                  (al f K) (ar f K) (\lam _ => set-pi) z
      \where {
        \func al.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (w : Or Y K) : side (Cof.pointed f) K (Or.map w pinl (\lam k => k)) = side Y K w \elim w
          | inl _ => idp
          | inr _ => idp

        \func ar.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (w : Or (\Sigma) K)
          : side (Cof.pointed f) K (Or.map w (\lam _ => pinr ()) (\lam k => k)) = side UnitPointed K w \elim w
          | inl _ => idp
          | inr _ => idp
      }

    \func beta.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (z : Grid.R1 {Grid.transpose (grid f K)})
      : corner (Cof.pointed f) K (jTo f.1 z) = bTo f.1 (Grid.r2 {Grid.transpose (grid f K)} z)
      => homotopy {_} {_} {_} {_} {_} {_} {\lam z => corner (Cof.pointed f) K (jTo f.1 z)} {\lam z => bTo f.1 (Grid.r2 {Grid.transpose (grid f K)} z)}
                  (bl f K) (br f K) (\case \elim __ \with {
                    | inl x => trim (bTo f.1) (ppglue (x, base))
                    | inr k => base-glue f.1 k f.2
                  }) z
      \where {
        \func bl.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (w : Or Y K)
          : corner (Cof.pointed f) K (Or.map w pinl (\lam k => k)) = (pinl (corner Y K w).1, (corner Y K w).2) \elim w
          | inl _ => idp
          | inr _ => idp

        \func br.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) (w : Or (\Sigma) K)
          : corner (Cof.pointed f) K (Or.map w (\lam _ => pinr ()) (\lam k => k)) = (pinr (), (corner UnitPointed K w).2) \elim w
          | inl _ => idp
          | inr k => pmap (\lam c => (c, k)) (pmap pinl (inv f.2) *> ppglue base)

        \func trim {S T : \Type} (E : S -> T) {s s' : S} (Q : s = s') : idp *> pmap E (idp *> Q) = pmap E Q \elim Q
          | idp => idp

        \func lift {S T : \Type} (E : S -> T) {s s' : S} (Q : s = s') : pmap E (idp *> Q) = idp *> pmap E Q \elim Q
          | idp => idp

        \func base-glue {X Y K : \Type} (f : X -> Y) (k : K) {x0 : X} {y0 : Y} (e : f x0 = y0)
          : idp *> pmap (bTo f) (pmap pinl (inv (inv (pmap (\lam y => (y, k)) (inv e)))) *> ppglue (x0, k))
            = idp *> pmap (\lam c => (c, k)) (pmap pinl (inv e) *> ppglue x0) \elim e
          | idp => pmap (idp *>) (lift (bTo f) (ppglue (x0, k)) *> inv (lift (\lam c => (c, k)) (ppglue x0)))
      }
  }

\func cofSmashEquiv.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) : PointedEquiv (Cof.pointed (Smash.map.{u} f (->*.id {K}))) (Smash.{u} (Cof.pointed f) K)
  => representFam.{u} {Cof.pointed (Smash.map.{u} f (->*.id {K}))} {Smash.{u} (Cof.pointed f) K} {\lam T => CofNull.{u} f (Map* K T)}
       (\lam T => L.{u} f K T) (\lam T => R.{u} f K T) (\lam k => CofNull.post.{u} (Map*.post K k))
       (\lam k g => Lp.{u} f K k g) (\lam k g => Rp.{u} f K k g)
  \where {
    \func eval.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u})
      : L.{u} f K (Smash.{u} (Cof.pointed f) K) (cofSmashEquiv.{u} f K).map = R.{u} f K (Smash.{u} (Cof.pointed f) K) ->*.id
      => representFam.eval.{u} {Cof.pointed (Smash.map.{u} f (->*.id {K}))} {Smash.{u} (Cof.pointed f) K} {\lam T => CofNull.{u} f (Map* K T)}
           (\lam T => L.{u} f K T) (\lam T => R.{u} f K T) (\lam  k => CofNull.post.{u} (Map*.post K k))
           (\lam k g => Lp.{u} f K k g) (\lam k g => Rp.{u} f K k g)

    \func inc.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u})
      : (cofSmashEquiv.{u} f K).map ->*.∘* Cof.inc (Smash.map.{u} f (->*.id {K})) = Smash.map.{u} (Cof.inc f) (->*.id {K})
      => QEquiv.isInj {Smash.adjunction.{u} {Y} {K} {Smash.{u} (Cof.pointed f) K}}
           (pmap (Smash.adjunction.{u} {Y} {K} {Smash.{u} (Cof.pointed f) K})
                 (inv (CofNull.mapsOut.star {Smash.{u} X K} {Smash.{u} Y K} {Smash.{u} (Cof.pointed f) K} {Smash.map.{u} f (->*.id {K})} (cofSmashEquiv.{u} f K).map)
                  *> pmap (\lam (d : CofNull.{u} (Smash.map.{u} f (->*.id {K})) (Smash.{u} (Cof.pointed f) K)) => d.1)
                          (inv (CofNull.mapsOut.eval.{u} (cofSmashEquiv.{u} f K).map)))
            *> pmap (\lam (d : CofNull.{u} f (Map* K (Smash.{u} (Cof.pointed f) K))) => d.1)
                    (inv (E.eval.{u} f K (Smash.{u} (Cof.pointed f) K) (CofNull.mapsOut.{u} (cofSmashEquiv.{u} f K).map))
                     *> inv (L.eval.{u} f K (Smash.{u} (Cof.pointed f) K) (cofSmashEquiv.{u} f K).map)
                     *> eval.{u} f K *> R.eval.{u} f K (Smash.{u} (Cof.pointed f) K) ->*.id
                     *> CofNull.mapsOut.eval.{u} (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id))
            *> CofNull.mapsOut.star {X} {Y} {Map* K (Smash.{u} (Cof.pointed f) K)} {f} (Smash.adjunction.{u} {Cof.pointed f} {K} {Smash.{u} (Cof.pointed f) K} ->*.id)
            *> inv (pre'.{u} (Cof.inc f) ->*.id))

    \sfunc L.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K T : Pointed.{u}) : QEquiv {Cof.pointed (Smash.map.{u} f (->*.id {K})) ->* T} {CofNull.{u} f (Map* K T)}
      => transQEquiv (CofNull.mapsOut.{u} {Smash.{u} X K} {Smash.{u} Y K} {T} {Smash.map.{u} f (->*.id {K})}) (E.{u} f K T)
      \where
        \func eval.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K T : Pointed.{u}) (g : Cof.pointed (Smash.map.{u} f (->*.id {K})) ->* T)
          : L.{u} f K T g = E.{u} f K T (CofNull.mapsOut.{u} g)
          => pmap (\lam (e : QEquiv {Cof.pointed (Smash.map.{u} f (->*.id {K})) ->* T} {CofNull.{u} f (Map* K T)}) => e g) (\peval L.{u} f K T)

    \sfunc R.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K T : Pointed.{u}) : QEquiv {Smash.{u} (Cof.pointed f) K ->* T} {CofNull.{u} f (Map* K T)}
      => transQEquiv (Smash.adjunction.{u} {Cof.pointed f} {K} {T}) (CofNull.mapsOut.{u} {X} {Y} {Map* K T} {f})
      \where
        \func eval.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K T : Pointed.{u}) (g : Smash.{u} (Cof.pointed f) K ->* T)
          : R.{u} f K T g = CofNull.mapsOut.{u} {X} {Y} {Map* K T} {f} (Smash.adjunction.{u} {Cof.pointed f} {K} {T} g)
          => pmap (\lam (e : QEquiv {Smash.{u} (Cof.pointed f) K ->* T} {CofNull.{u} f (Map* K T)}) => e g) (\peval R.{u} f K T)

    \sfunc j5 {A B : \Type} (F : A -> B) {x y z : B} {w v : A} (p : x = y) (q : y = z) (r : z = F v) (s : w = v) : x = F w
      => p *> q *> r *> pmap F (inv s)

    \func Lp.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) {T T' : Pointed.{u}} (k : T ->* T') (g : Cof.pointed (Smash.map.{u} f (->*.id {K})) ->* T)
      : L.{u} f K T' (k ->*.∘* g) = CofNull.post.{u} (Map*.post K k) (L.{u} f K T g)
      => j5 (CofNull.post.{u} {X} {Y} {Map* K T} {Map* K T'} {f} (Map*.post K k)) {L.{u} f K T' (k ->*.∘* g)} {E.{u} f K T' (CofNull.mapsOut.{u} (k ->*.∘* g))}
            {E.{u} f K T' (CofNull.post.{u} {Smash.{u} X K} {Smash.{u} Y K} {T} {T'} {Smash.map.{u} f (->*.id {K})} k (CofNull.mapsOut.{u} g))}
            {L.{u} f K T g} {E.{u} f K T (CofNull.mapsOut.{u} g)}
            (L.eval.{u} f K T' (k ->*.∘* g)) (pmap (E.{u} f K T') (CofNull.mapsOut.post.{u} k g)) (E.post.{u} f K k (CofNull.mapsOut.{u} g)) (L.eval.{u} f K T g)

    \func Rp.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) {T T' : Pointed.{u}} (k : T ->* T') (g : Smash.{u} (Cof.pointed f) K ->* T)
      : R.{u} f K T' (k ->*.∘* g) = CofNull.post.{u} (Map*.post K k) (R.{u} f K T g)
      => j5 (CofNull.post.{u} {X} {Y} {Map* K T} {Map* K T'} {f} (Map*.post K k)) {R.{u} f K T' (k ->*.∘* g)}
            {CofNull.mapsOut.{u} {X} {Y} {Map* K T'} {f} (Smash.adjunction.{u} {Cof.pointed f} {K} {T'} (k ->*.∘* g))}
            {CofNull.mapsOut.{u} {X} {Y} {Map* K T'} {f} (Map*.post K k ->*.∘* Smash.adjunction.{u} {Cof.pointed f} {K} {T} g)}
            {R.{u} f K T g} {CofNull.mapsOut.{u} {X} {Y} {Map* K T} {f} (Smash.adjunction.{u} {Cof.pointed f} {K} {T} g)}
            (R.eval.{u} f K T' (k ->*.∘* g))
            (pmap (CofNull.mapsOut.{u} {X} {Y} {Map* K T'} {f}) {Smash.adjunction.{u} {Cof.pointed f} {K} {T'} (k ->*.∘* g)}
                  {Map*.post K k ->*.∘* Smash.adjunction.{u} {Cof.pointed f} {K} {T} g} (Smash.adjunction.post.{u} k g))
            (CofNull.mapsOut.post.{u} (Map*.post K k) (Smash.adjunction.{u} {Cof.pointed f} {K} {T} g)) (R.eval.{u} f K T g)

    \func pre'.{u} {X Y K T : Pointed.{u}} (f : X ->* Y) (g : Smash.{u} Y K ->* T)
      : Smash.adjunction.{u} {X} {K} {T} (g ->*.∘* Smash.map.{u} f (->*.id {K})) = Smash.adjunction.{u} {Y} {K} {T} g ->*.∘* f
      => Smash.adjunction.pre.{u} g f ->*.id
         *> pmap (\lam (P : Map* K T ->* Map* K T) => (P ->*.∘* Smash.adjunction.{u} {Y} {K} {T} g) ->*.∘* f) (Map*.pre.id {K} {T})

    \func concatL {A : \Type} {a b c : A} (p : a = b) : QEquiv {b = c} {a = c} \cowith
      | f q => p *> q
      | ret r => inv p *> r
      | ret_f q => lem p q
      | f_sec r => lem' p r
      \where {
        \func lem {A : \Type} {a b c : A} (p : a = b) (q : b = c) : inv p *> (p *> q) = q \elim p
          | idp => idp_*> _ *> idp_*> q

        \func lem' {A : \Type} {a b c : A} (p : a = b) (r : a = c) : p *> (inv p *> r) = r \elim p
          | idp => idp_*> _ *> idp_*> r
      }

    \sfunc E.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K T : Pointed.{u}) : QEquiv {CofNull.{u} (Smash.map.{u} f (->*.id {K})) T} {CofNull.{u} f (Map* K T)}
      => sigma-equiv (Smash.adjunction.{u} {Y} {K} {T})
                     (\lam (g : Smash.{u} Y K ->* T) =>
                        transQEquiv (IsEquiv.toQEquiv (pmapIsEquiv {_} {_} {Smash.adjunction.{u} {X} {K} {T}} (inP Smash.adjunction.{u})
                                                                   {g ->*.∘* Smash.map.{u} f (->*.id {K})} {base {Map* (Smash.{u} X K) T}}))
                                    (concatL {X ->* Map* K T} {Smash.adjunction.{u} {Y} {K} {T} g ->*.∘* f}
                                             {Smash.adjunction.{u} {X} {K} {T} (g ->*.∘* Smash.map.{u} f (->*.id {K}))} {base {Map* X (Map* K T)}} (inv (pre'.{u} f g))))
      \where {
        \func eval.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K T : Pointed.{u}) (d : CofNull.{u} (Smash.map.{u} f (->*.id {K})) T)
          : E.{u} f K T d = ((Smash.adjunction.{u} {Y} {K} {T} d.1, inv (pre'.{u} f d.1) *> pmap (Smash.adjunction.{u} {X} {K} {T}) d.2) : CofNull.{u} f (Map* K T))
          => pmap (\lam (e : QEquiv {CofNull.{u} (Smash.map.{u} f (->*.id {K})) T} {CofNull.{u} f (Map* K T)}) => e d) (\peval E.{u} f K T)

        \func eval'.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K T : Pointed.{u}) (g : Smash.{u} Y K ->* T)
                        (p : g ->*.∘* Smash.map.{u} f (->*.id {K}) = base {Map* (Smash.{u} X K) T})
          : E.{u} f K T (g, p) = ((Smash.adjunction.{u} {Y} {K} {T} g, inv (pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p) : CofNull.{u} f (Map* K T))
          => eval.{u} f K T (g, p)

        \func post.{u} {X Y : Pointed.{u}} (f : X ->* Y) (K : Pointed.{u}) {T T' : Pointed.{u}} (k : T ->* T') (d : CofNull.{u} (Smash.map.{u} f (->*.id {K})) T)
          : E.{u} f K T' (CofNull.post.{u} {Smash.{u} X K} {Smash.{u} Y K} {T} {T'} {Smash.map.{u} f (->*.id {K})} k d)
            = CofNull.post.{u} {X} {Y} {Map* K T} {Map* K T'} {f} (Map*.post K k) (E.{u} f K T d)
          => j3 (CofNull.post.{u} {X} {Y} {Map* K T} {Map* K T'} {f} (Map*.post K k))
                {E.{u} f K T' (CofNull.post.{u} {Smash.{u} X K} {Smash.{u} Y K} {T} {T'} {Smash.map.{u} f (->*.id {K})} k d)}
                {((Smash.adjunction.{u} {Y} {K} {T'} (k ->*.∘* d.1),
                   inv (pre'.{u} f (k ->*.∘* d.1)) *> pmap (Smash.adjunction.{u} {X} {K} {T'})
                                                         (inv (->*.compose-assoc k d.1 (Smash.map.{u} f (->*.id {K}))) *> pmap (k ->*.∘*) d.2 *> ->*.compose-zero k))
                  : CofNull.{u} f (Map* K T'))}
                {((Smash.adjunction.{u} {Y} {K} {T} d.1, inv (pre'.{u} f d.1) *> pmap (Smash.adjunction.{u} {X} {K} {T}) d.2) : CofNull.{u} f (Map* K T))}
                {E.{u} f K T d}
                (eval'.{u} f K T' (k ->*.∘* d.1) (inv (->*.compose-assoc k d.1 (Smash.map.{u} f (->*.id {K}))) *> pmap (k ->*.∘*) d.2 *> ->*.compose-zero k))
                (core.{u} f k d.1 d.2) (eval.{u} f K T d)
          \where {
            \sfunc j3 {A B : \Type} (F : A -> B) {x y : B} {z w : A} (p : x = y) (q : y = F z) (r : w = z) : x = F w => p *> q *> pmap F (inv r)

            \func core.{u} {X Y K T T' : Pointed.{u}} (f : X ->* Y) (k : T ->* T') (g : Smash.{u} Y K ->* T)
                           (p : g ->*.∘* Smash.map.{u} f (->*.id {K}) = base {Map* (Smash.{u} X K) T})
              : ((Smash.adjunction.{u} {Y} {K} {T'} (k ->*.∘* g),
                  inv (pre'.{u} f (k ->*.∘* g)) *> pmap (Smash.adjunction.{u} {X} {K} {T'})
                                                     (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ->*.∘*) p *> ->*.compose-zero k))
                  : CofNull.{u} f (Map* K T'))
                = (Map*.post K k ->*.∘* Smash.adjunction.{u} {Y} {K} {T} g,
                   inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)
                   *> pmap (Map*.post K k ->*.∘*) (inv (pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p) *> ->*.compose-zero (Map*.post K k))
              => CofNull.ext.{u} {X} {Y} {Map* K T'} {f} {Smash.adjunction.{u} {Y} {K} {T'} (k ->*.∘* g)} {Map*.post K k ->*.∘* Smash.adjunction.{u} {Y} {K} {T} g}
                   {inv (pre'.{u} f (k ->*.∘* g)) *> pmap (Smash.adjunction.{u} {X} {K} {T'})
                                                       (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ->*.∘*) p *> ->*.compose-zero k)}
                   {inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)
                    *> pmap (Map*.post K k ->*.∘*) (inv (pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p) *> ->*.compose-zero (Map*.post K k)}
                   (Smash.adjunction.post.{u} k g)
                   (mapLoop*.ext2-base {X} {K} {T'} {Smash.adjunction.{u} {Y} {K} {T'} (k ->*.∘* g) ->*.∘* f}
                     {inv (pre'.{u} f (k ->*.∘* g)) *> pmap (Smash.adjunction.{u} {X} {K} {T'})
                                                         (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ->*.∘*) p *> ->*.compose-zero k)}
                     {pmap (\lam (F : Y ->* Map* K T') => F ->*.∘* f) (Smash.adjunction.post.{u} k g)
                      *> inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)
                      *> pmap (Map*.post K k ->*.∘*) (inv (pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p) *> ->*.compose-zero (Map*.post K k)}
                     (\lam x z => lhs.{u} f k g p x z *> inv (rhs.{u} f k g p x z)))

            \func pre'-first.{u} {X Y K T : Pointed.{u}} (f : X ->* Y) (h : Smash.{u} Y K ->* T) (x : X) (z : K)
              : pmap (\lam (G : X ->* Map* K T) => (G.1 x).1 z) (pre'.{u} f h) = idp
              => pmap_*>-comm (\lam (G : X ->* Map* K T) => (G.1 x).1 z) (Smash.adjunction.pre.{u} h f ->*.id)
                              (pmap (\lam (P : Map* K T ->* Map* K T) => (P ->*.∘* Smash.adjunction.{u} {Y} {K} {T} h) ->*.∘* f) (Map*.pre.id {K} {T}))
                 *> pmap (`*> idp) (Smash.adjunction.pre-first.{u} h f ->*.id x z)

            \func pre'-ev.{u} {X Y K T : Pointed.{u}} (f : X ->* Y) (h : Smash.{u} Y K ->* T)
                              {q : h ->*.∘* Smash.map.{u} f (->*.id {K}) = base {Map* (Smash.{u} X K) T}} (x : X) (z : K)
              : pmap (\lam (G : X ->* Map* K T) => (G.1 x).1 z) (inv (pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {K} {T}) q)
                = pmap (\lam (h' : Smash.{u} X K ->* T) => h'.1 (Smash.proj.1 (x, z))) q
              => pmap_*>-comm (\lam (G : X ->* Map* K T) => (G.1 x).1 z) (inv (pre'.{u} f h)) (pmap (Smash.adjunction.{u} {X} {K} {T}) q)
                 *> pmap (`*> _) (pmap_inv-comm (\lam (G : X ->* Map* K T) => (G.1 x).1 z) (pre'.{u} f h) *> pmap inv (pre'-first.{u} f h x z))
                 *> idp_*> _

            \func fin4 {A : \Type} {t0 t1 t2 : A} {a b : t0 = t0} {c c' : t0 = t1} {d : t1 = t2} (ha : a = idp) (hb : b = idp) (hc : c = c')
              : a *> b *> c *> d = c' *> d \elim ha, hb, hc
              | idp, idp, idp => idp_*> _ *> idp_*> _

            \func ev4 {S T : \Type} (F : S -> T) {s0 s1 s2 s3 s4 : S} (a : s0 = s1) (b : s1 = s2) (c : s2 = s3) (d : s3 = s4)
              : pmap F (a *> b *> c *> d) = pmap F a *> pmap F b *> pmap F c *> pmap F d \elim s2, s3, s4, b, c, d
              | _, _, _, idp, idp, idp => idp

            \func lhs.{u} {X Y K T T' : Pointed.{u}} (f : X ->* Y) (k : T ->* T') (g : Smash.{u} Y K ->* T)
                          (p : g ->*.∘* Smash.map.{u} f (->*.id {K}) = base {Map* (Smash.{u} X K) T}) (x : X) (z : K)
              : pmap (\lam (G : X ->* Map* K T') => (G.1 x).1 z)
                     (inv (pre'.{u} f (k ->*.∘* g)) *> pmap (Smash.adjunction.{u} {X} {K} {T'})
                                                         (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))) *> pmap (k ->*.∘*) p *> ->*.compose-zero k))
                = pmap k.1 (pmap (\lam (h : Smash.{u} X K ->* T) => h.1 (Smash.proj.1 (x, z))) p) *> k.2
              => pre'-ev.{u} f (k ->*.∘* g) x z
                 *> pmap_*>-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, z))) (inv (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))))
                                 (pmap (k ->*.∘*) p *> ->*.compose-zero k)
                 *> pmap2 (*>) (pmap_inv-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, z))) (->*.compose-assoc k g (Smash.map.{u} f (->*.id {K}))))
                          (pmap_*>-comm (\lam (h : Smash.{u} X K ->* T') => h.1 (Smash.proj.1 (x, z))) (pmap (k ->*.∘*) p) (->*.compose-zero k))
                 *> idp_*> _

            \func rhs.{u} {X Y K T T' : Pointed.{u}} (f : X ->* Y) (k : T ->* T') (g : Smash.{u} Y K ->* T)
                          (p : g ->*.∘* Smash.map.{u} f (->*.id {K}) = base {Map* (Smash.{u} X K) T}) (x : X) (z : K)
              : pmap (\lam (G : X ->* Map* K T') => (G.1 x).1 z)
                     (pmap (\lam (F : Y ->* Map* K T') => F ->*.∘* f) (Smash.adjunction.post.{u} k g)
                      *> inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f)
                      *> pmap (Map*.post K k ->*.∘*) (inv (pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p)
                      *> ->*.compose-zero (Map*.post K k))
                = pmap k.1 (pmap (\lam (h : Smash.{u} X K ->* T) => h.1 (Smash.proj.1 (x, z))) p) *> k.2
              => ev4 (\lam (G : X ->* Map* K T') => (G.1 x).1 z) (pmap (\lam (F : Y ->* Map* K T') => F ->*.∘* f) (Smash.adjunction.post.{u} k g))
                     (inv (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                     (pmap (Map*.post K k ->*.∘*) (inv (pre'.{u} f g) *> pmap (Smash.adjunction.{u} {X} {K} {T}) p)) (->*.compose-zero (Map*.post K k))
                 *> fin4 (Smash.adjunction.post-first.{u} k g (f.1 x) z)
                         (pmap_inv-comm (\lam (G : X ->* Map* K T') => (G.1 x).1 z) (->*.compose-assoc (Map*.post K k) (Smash.adjunction.{u} {Y} {K} {T} g) f))
                         (pmap (pmap k.1) (pre'-ev.{u} f g x z))
          }

        \func pre.{l} {X Y X' Y' : Pointed.{l}} {u : X ->* Y} {u' : X' ->* Y'} (a : X ->* X') (b : Y ->* Y') (s : b ->*.∘* u = u' ->*.∘* a) (K T : Pointed.{l})
                      (d : CofNull.{l} (Smash.map.{l} u' (->*.id {K})) T)
          : E.{l} u K T (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                         {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d)
            = CofNull.pre.{l} {X} {Y} {X'} {Y'} {Map* K T} {u} {u'} a b s (E.{l} u' K T d)
          => post.j3 (CofNull.pre.{l} {X} {Y} {X'} {Y'} {Map* K T} {u} {u'} a b s)
               {E.{l} u K T (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                             {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d)}
               {((Smash.adjunction.{l} {Y} {K} {T} (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                                                    {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d).1,
                  inv (pre'.{l} u (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                                   {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d).1)
                  *> pmap (Smash.adjunction.{l} {X} {K} {T})
                          (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                           {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d).2)
                 : CofNull.{l} u (Map* K T))}
               {((Smash.adjunction.{l} {Y'} {K} {T} d.1, inv (pre'.{l} u' d.1) *> pmap (Smash.adjunction.{l} {X'} {K} {T}) d.2) : CofNull.{l} u' (Map* K T))}
               {E.{l} u' K T d}
               (eval.{l} u K T (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                                {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d))
               (core.{l} a b s K T d) (eval.{l} u' K T d)
          \where {
            \func core.{l} {X Y X' Y' : Pointed.{l}} {u : X ->* Y} {u' : X' ->* Y'} (a : X ->* X') (b : Y ->* Y') (s : b ->*.∘* u = u' ->*.∘* a) (K T : Pointed.{l})
                           (d : CofNull.{l} (Smash.map.{l} u' (->*.id {K})) T)
              : ((Smash.adjunction.{l} {Y} {K} {T} (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                                                   {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d).1,
                  inv (pre'.{l} u (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                                   {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d).1)
                  *> pmap (Smash.adjunction.{l} {X} {K} {T})
                          (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                           {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d).2)
                  : CofNull.{l} u (Map* K T))
                = CofNull.pre.{l} {X} {Y} {X'} {Y'} {Map* K T} {u} {u'} a b s
                    ((Smash.adjunction.{l} {Y'} {K} {T} d.1, inv (pre'.{l} u' d.1) *> pmap (Smash.adjunction.{l} {X'} {K} {T}) d.2) : CofNull.{l} u' (Map* K T))
              => CofNull.ext.{l} {X} {Y} {Map* K T} {u}
                   {Smash.adjunction.{l} {Y} {K} {T} (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                                                     {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d).1}
                   {Smash.adjunction.{l} {Y'} {K} {T} d.1 ->*.∘* b}
                   {_} {_}
                   (pre'.{l} b d.1)
                   (mapLoop*.ext2-base (\lam x k => lhs.{l} a b s K T d x k *> inv (rhs.{l} a b s K T d x k)))

            \func lhs.{l} {X Y X' Y' : Pointed.{l}} {u : X ->* Y} {u' : X' ->* Y'} (a : X ->* X') (b : Y ->* Y') (s : b ->*.∘* u = u' ->*.∘* a) (K T : Pointed.{l})
                          (d : CofNull.{l} (Smash.map.{l} u' (->*.id {K})) T) (x : X) (k : K)
              : pmap (\lam (G : X ->* Map* K T) => (G.1 x).1 k)
                     (inv (pre'.{l} u (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
                                                       {Smash.map.{l} u' (->*.id {K})} (Smash.map.{l} a (->*.id {K})) (Smash.map.{l} b (->*.id {K})) (square.{l} a b s K) d).1)
                      *> pmap (Smash.adjunction.{l} {X} {K} {T})
                              (CofNull.pre.{l} {Smash.{l} X K} {Smash.{l} Y K} {Smash.{l} X' K} {Smash.{l} Y' K} {T} {Smash.map.{l} u (->*.id {K})}
