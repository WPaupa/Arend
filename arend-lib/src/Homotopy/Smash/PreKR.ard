\import Homotopy.Pointed
\import Homotopy.Pointed.Mapping
\import Homotopy.Smash
\import Homotopy.Smash.Cofiber
\import Homotopy.Smash.CoreBeta
\import Homotopy.Smash.PostBeta
\import Paths

\open ->* (∘*)

\func sR4.{u} {X Y B' T : Pointed.{u}} (f : X ->* Y) (h : Smash.{u} Y B' ->* T)
              (q : h ∘* Smash.map.{u} f (->*.id {B'}) = base {Map* (Smash.{u} X B') T}) (x : X)
  => pmap (nc (->*.happly (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q) x))
          (inv (*>_inv (pmap_*>-comm (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (inv (cofSmashEquiv.pre'.{u} f h)) (pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                        *> pmap2 (*>) (pmap_inv-comm (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (cofSmashEquiv.pre'.{u} f h)
                                       *> pmap inv (cofSmashEquiv.E.post.pre'-first.{u} f h x base))
                                      (idp {_} {pmap (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (pmap (Smash.adjunction.{u} {X} {B'} {T}) q)}))))
     *> nc.end (->*.happly (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q) x)
               (pmap_*>-comm (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (inv (cofSmashEquiv.pre'.{u} f h)) (pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                *> pmap2 (*>) (pmap_inv-comm (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (cofSmashEquiv.pre'.{u} f h)
                               *> pmap inv (cofSmashEquiv.E.post.pre'-first.{u} f h x base))
                              (idp {_} {pmap (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (pmap (Smash.adjunction.{u} {X} {B'} {T}) q)}))
               (inv (pmap_*>-comm (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (inv (cofSmashEquiv.pre'.{u} f h)) (pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                     *> pmap2 (*>) (pmap_inv-comm (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (cofSmashEquiv.pre'.{u} f h)
                                    *> pmap inv (cofSmashEquiv.E.post.pre'-first.{u} f h x base))
                                   (idp {_} {pmap (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (pmap (Smash.adjunction.{u} {X} {B'} {T}) q)})))
     *> pmap (_ *>)
          (ncc (inv (cofSmashEquiv.pre'.{u} f h)) (pmap (Smash.adjunction.{u} {X} {B'} {T}) q) x
               (pmap_inv-comm (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (cofSmashEquiv.pre'.{u} f h)
                *> pmap inv (cofSmashEquiv.E.post.pre'-first.{u} f h x base))
               (idp {_} {pmap (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) (pmap (Smash.adjunction.{u} {X} {B'} {T}) q)})
           *> pmap (_ *>) (pmap (_ *>)
                (nci (cofSmashEquiv.pre'.{u} f h) x (cofSmashEquiv.E.post.pre'-first.{u} f h x base)
                 *> pmap (\lam u => pmap (inv idp *>) (inv u) *> nc.inverse.lem idp _) (vP.{u} f h x))))
