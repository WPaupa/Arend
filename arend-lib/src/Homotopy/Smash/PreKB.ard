\import Homotopy.Pointed
\import Homotopy.Pointed.Mapping
\import Homotopy.Pushout \hiding (PushoutPointed)
\import Homotopy.Smash
\import Homotopy.Smash.Cofiber
\import Homotopy.Smash.CoreBeta
\import Homotopy.Smash.CoreScalar
\import Homotopy.Smash.PostBeta
\import Homotopy.Smash.PreKInner
\import Homotopy.Smash.PreKR
\import Homotopy.Smash.PreKScalar
\import Paths

\open ->* (∘*)
\open PushoutData (ppglue)

\func nprGe.{l} {X B B' T : Pointed.{l}} (g : B ->* B') {F F' : X ->* Map* B' T} (R : F = F') (x : X)
            {N : (pmap (\lam (G : X ->* Map* B' T) => (G.1 x).1 base) R) *> (F'.1 x).2 = (F.1 x).2} (e : nc (->*.happly R x) idp = N)
  : nc (->*.happly (pmap (Map*.pre g T ∘*) R) x) idp = pg (natE (\lam (H : X ->* Map* B' T) (b : B') => (H.1 x).1 b) R g.2) N
  => nprG.{l} g R x *> pmap (pg (natE (\lam (H : X ->* Map* B' T) (b : B') => (H.1 x).1 b) R g.2)) e

\func nprGe2.{l} {X B B' T : Pointed.{l}} (g : B ->* B') {F : X ->* Map* B' T} {G G' : Smash.{l} X B' ->* T}
              (R1 : F = Smash.adjunction.{l} {X} {B'} {T} G) (Q : G = G') (x : X)
              {N : pmap (\lam (H : X ->* Map* B' T) => (H.1 x).1 base) (R1 *> pmap (Smash.adjunction.{l} {X} {B'} {T}) Q)
                   *> ((Smash.adjunction.{l} {X} {B'} {T} G').1 x).2 = (F.1 x).2}
              (e : nc (->*.happly (R1 *> pmap (Smash.adjunction.{l} {X} {B'} {T}) Q) x) idp = N)
  => nprGe.{l} g (R1 *> pmap (Smash.adjunction.{l} {X} {B'} {T}) Q) x e
     *> pgl (natEcatN (Smash.adjunction.{l} {X} {B'} {T}) (\lam (H : X ->* Map* B' T) (b : B') => (H.1 x).1 b) R1 Q g.2) N

\func sK4.{u} {Y B B' T : Pointed.{u}} (g : B ->* B') (h : Smash.{u} Y B' ->* T) (y : Y)
  => ncc (Smash.adjunction.pre.{u} h (->*.id {Y}) g) (->*.compose-id (Map*.pre g T ∘* Smash.adjunction.{u} {Y} {B'} {T} h)) y
         (Smash.adjunction.pre-first.{u} h (->*.id {Y}) g y base) idp
     *> pmap (_ *>) (pmap2 (*>) (pmap (pmap (idp *>)) (nc.ev (->*.happly (->*.compose-id (Map*.pre g T ∘* Smash.adjunction.{u} {Y} {B'} {T} h)) y) idp))
                                (nAP.{u} h (->*.id {Y}) g y
                                 *> pmap (_ *>) (pmap (_ *>) (pmap (\lam v => idp_*> _ *> inv v) (lrpV.{u} h (->*.id {Y}) g y)))))

\func sb4.{u} {X Y B B' T : Pointed.{u}} (f : X ->* Y) (g : B ->* B') (h : Smash.{u} Y B' ->* T)
              (q : h ∘* Smash.map.{u} f (->*.id {B'}) = base {Map* (Smash.{u} X B') T}) (x : X)
  => pmap (nc (->*.happly (pmap (\lam (F : Y ->* Map* B T) => F ∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h)
                           *> inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)
                           *> pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                           *> ->*.compose-zero (Map*.pre g T)) x))
          (pmap (`*> cofSmashEquiv.E.post.fin4 {_} {_} {_} {_} {_} {_} {_} {_} {idp} (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 x) base)
                                               (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                                              (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                                               (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} x (g.1 base)))
                (edec (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                      (pmap (\lam (F : Y ->* Map* B T) => F ∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h))
                      (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                      (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q))
                      (->*.compose-zero (Map*.pre g T)))
           *> pmap (_ *>) (fdec {_} {_} {_} {_} {_} {_} {_} {_} {idp} (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 x) base)
                                (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                               (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                                (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} x (g.1 base)))
           *> il {_} {_} {_} {_} {_} {_} {_} {_} {_} {_} {_} {_}
                 {pmap (\lam (G : X ->* Map* B T) => (G.1 x).1 base) (->*.compose-zero (Map*.pre g T))}
                 _ _ _ (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 x) base)
                       (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                      (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                       (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} x (g.1 base)) _)
     *> nc.end (->*.happly (pmap (\lam (F : Y ->* Map* B T) => F ∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h)
                            *> inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)
                            *> pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                            *> ->*.compose-zero (Map*.pre g T)) x)
               (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                             (pmap (\lam (F : Y ->* Map* B T) => F ∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h))
                             (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)
                              *> pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                              *> ->*.compose-zero (Map*.pre g T))
                *> pmap2 (*>) (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 x) base)
                     (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                   (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                                   (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                                    *> ->*.compose-zero (Map*.pre g T))
                      *> pmap2 (*>) (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                                   (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                           (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                         (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q))
                                         (->*.compose-zero (Map*.pre g T))
                            *> pmap2 (*>) (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} x (g.1 base))
                                     (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 x).1 base) (->*.compose-zero (Map*.pre g T))}))))
               (idp_*> _ *> idp_*> _)
     *> pmap (_ *>)
          (ncc (pmap (\lam (F : Y ->* Map* B T) => F ∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h))
               (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)
                *> pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                *> ->*.compose-zero (Map*.pre g T)) x
               (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 x) base)
               (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                             (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                             (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                              *> ->*.compose-zero (Map*.pre g T))
                *> pmap2 (*>) (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                             (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                     (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                   (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q))
                                   (->*.compose-zero (Map*.pre g T))
                      *> pmap2 (*>) (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} x (g.1 base))
                               (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 x).1 base) (->*.compose-zero (Map*.pre g T))})))
           *> pmap (_ *>) (pmap2 (*>)
                (pmap (pmap (_ *>))
                  (ncc (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                       (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                        *> ->*.compose-zero (Map*.pre g T)) x
                       (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                      (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)
                        *> pmap inv (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                                   (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)}))
                       (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                     (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q))
                                     (->*.compose-zero (Map*.pre g T))
                        *> pmap2 (*>) (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} x (g.1 base))
                                 (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 x).1 base) (->*.compose-zero (Map*.pre g T))}))
                   *> pmap (_ *>) (pmap2 (*>)
                        (pmap (pmap (_ *>))
                          (ncc (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q))
                               (->*.compose-zero (Map*.pre g T)) x
                               (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} x (g.1 base))
                               (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 x).1 base) (->*.compose-zero (Map*.pre g T))})
                           *> pmap (_ *>) (pmap2 (*>)
                                (pmap (pmap (_ *>)) (nc.ev (->*.happly (->*.compose-zero {X} {Map* B' T} {Map* B T} (Map*.pre g T)) x) idp))
                                (pmap (nc (->*.happly (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)) x))
                                      (inv (idp_*> (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} x (g.1 base))))
                                 *> nc.end (->*.happly (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)) x)
                                           idp (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} x (g.1 base))
                                 *> pmap (_ *>) (nprGe2.{u} {X} {B} {B'} {T} g {_} {h ∘* Smash.map.{u} f (->*.id {B'})} {base {Map* (Smash.{u} X B') T}}
                                                            (inv (cofSmashEquiv.pre'.{u} f h)) q x (sR4.{u} f h q x))))))
                        (nci (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f) x
                             (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                            (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)})
                         *> pmap (\lam u => pmap (inv (pmap (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                                           (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)) *>) (inv u)
                                            *> nc.inverse.lem _ _)
                                 (nc.ev (->*.happly (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f) x)
                                        (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 x).1 base)
                                                       (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)}))))))
                (sK4.{u} g h (f.1 x))))
