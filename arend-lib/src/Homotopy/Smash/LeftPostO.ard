                       *> (Smash.map.{u} f (->*.id {Cof.pointed g})).2)))

\sfunc opostNULL.{u} {A X B Y : Pointed.{u}} (f : A ->* X) (g : B ->* Y) (b : B)
  : pmap (\lam v => idp *> (pmap (Smash.map.{u} f (->*.id {Cof.pointed g})).1 v *> (Smash.map.{u} f (->*.id {Cof.pointed g})).2))
         (ob (\lam (G : B ->* Smash.{u} A (Cof.pointed g)) => G.1 b) (pmap (Smash.adjunction.{u} {A} {B} {Smash.{u} A (Cof.pointed g)}) (inv (pushoutLeft.null.{u} A g))) idp)
    = oPN.{u} f g b
  => ophiN.{u} f g b
