\func oAK.{u} {X Y B B' T : Pointed.{u}} (f : X ->* Y) (g : B ->* B') (h : Smash.{u} Y B' ->* T) (y : B)
  => ob.ev (\lam (G : B ->* T) => G.1 y) (pmap (`∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h)) (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 base) y)
     *> pmap (_ *>) (pmap (_ *>)
          (pmap (pmap (pmap (\lam (G : B ->* T) => G.1 y))) (mapLoop*.happly-base_pre f (cofSmashEquiv.naturalK.adjK.{u} g h))
           *> pcl (\lam (G : B ->* T) => G.1 y) f.2 (->*.happly (cofSmashEquiv.naturalK.adjK.{u} g h)) (->*.happly-base (cofSmashEquiv.naturalK.adjK.{u} g h))
           *> pmap (_ *>) (pmap (_ *>) (pmap (`*> inv (pmap_*>-comm (\lam (G : B ->* T) => G.1 y)
                                                                    (pmap (Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).1 f.2)
                                                                    (Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).2))
                (pmap (\lam (u : pmap (\lam (G : B ->* T) => G.1 y) (->*.happly (cofSmashEquiv.naturalK.adjK.{u} g h) base)
                                 *> pmap (\lam (G : B ->* T) => G.1 y) (Map*.pre g T ∘* Smash.adjunction.{u} {Y} {B'} {T} h).2
                                 = pmap (\lam (G : B ->* T) => G.1 y) (Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).2)
                         => mapLoop*.preCoh {Y} {T} {f.1 base} {base} f.2
                                            {\lam e => ((Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).1 e).1 y}
                                            {\lam e => ((Map*.pre g T ∘* Smash.adjunction.{u} {Y} {B'} {T} h).1 e).1 y}
                                            (\lam e => pmap (\lam (G : B ->* T) => G.1 y) (->*.happly (cofSmashEquiv.naturalK.adjK.{u} g h) e))
                                            {(base {Map* B T}).1 y}
                                            {pmap (\lam (G : B ->* T) => G.1 y) (Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).2}
                                            {pmap (\lam (G : B ->* T) => G.1 y) (Map*.pre g T ∘* Smash.adjunction.{u} {Y} {B'} {T} h).2} u)
                      (inv (nc.bi.lem (cofSmashEquiv.naturalK.adjK.first.{u} g h base y)
                                      (inv (pmap_*>-comm (\lam (G : B ->* T) => G.1 y) (->*.happly (cofSmashEquiv.naturalK.adjK.{u} g h) base)
                                                         (Map*.pre g T ∘* Smash.adjunction.{u} {Y} {B'} {T} h).2)
                                       *> pmap (pmap (\lam (G : B ->* T) => G.1 y)) (->*.happly-base (cofSmashEquiv.naturalK.adjK.{u} g h))))
                       *> pmap (pmap (`*> pmap (\lam (G : B ->* T) => G.1 y) (Map*.pre g T ∘* Smash.adjunction.{u} {Y} {B'} {T} h).2)
                                     (cofSmashEquiv.naturalK.adjK.first.{u} g h base y) *>)
                               (inv (ob.ev (\lam (G : B ->* T) => G.1 y) (cofSmashEquiv.naturalK.adjK.{u} g h) (cofSmashEquiv.naturalK.adjK.first.{u} g h base y))
                                *> oK.{u} g h y)))))))

\func sbK.{u} {X Y B B' T : Pointed.{u}} (f : X ->* Y) (g : B ->* B') (h : Smash.{u} Y B' ->* T)
              (q : h ∘* Smash.map.{u} f (->*.id {B'}) = base {Map* (Smash.{u} X B') T}) (y : B)
  => pmap (ob (\lam (G : B ->* T) => G.1 y)
              (pmap (\lam (F : Y ->* Map* B T) => F ∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h)
               *> inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)
               *> pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
               *> ->*.compose-zero (Map*.pre g T)))
          (pmap (`*> cofSmashEquiv.E.post.fin4 {_} {_} {_} {_} {_} {_} {_} {_} {idp} (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 base) y)
                                               (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                                              (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                                               (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} base (g.1 y)))
                (edec (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                      (pmap (\lam (F : Y ->* Map* B T) => F ∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h))
                      (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                      (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q))
                      (->*.compose-zero (Map*.pre g T)))
           *> pmap (_ *>) (fdec {_} {_} {_} {_} {_} {_} {_} {_} {idp} (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 base) y)
                                (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                               (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                                (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} base (g.1 y)))
           *> il {_} {_} {_} {_} {_} {_} {_} {_} {_} {_} {_} {_}
                 {pmap (\lam (G : X ->* Map* B T) => (G.1 base).1 y) (->*.compose-zero (Map*.pre g T))}
                 _ _ _ (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 base) y)
                       (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                      (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                       (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} base (g.1 y)) _)
     *> ob.end (\lam (G : B ->* T) => G.1 y)
               (pmap (\lam (F : Y ->* Map* B T) => F ∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h)
                *> inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)
                *> pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                *> ->*.compose-zero (Map*.pre g T))
               (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                             (pmap (\lam (F : Y ->* Map* B T) => F ∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h))
                             (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)
                              *> pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                              *> ->*.compose-zero (Map*.pre g T))
                *> pmap2 (*>) (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 base) y)
                     (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                   (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                                   (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                                    *> ->*.compose-zero (Map*.pre g T))
                      *> pmap2 (*>) (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                                   (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                           (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                         (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q))
                                         (->*.compose-zero (Map*.pre g T))
                            *> pmap2 (*>) (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} base (g.1 y))
                                     (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 base).1 y) (->*.compose-zero (Map*.pre g T))}))))
               (idp_*> _ *> idp_*> _)
     *> pmap (_ *>)
          (ob.cat (\lam (G : B ->* T) => G.1 y) (pmap (\lam (F : Y ->* Map* B T) => F ∘* f) (cofSmashEquiv.naturalK.adjK.{u} g h))
                  (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)
                   *> pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                   *> ->*.compose-zero (Map*.pre g T))
                  (cofSmashEquiv.naturalK.adjK.first.{u} g h (f.1 base) y)
                  (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                                (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                                 *> ->*.compose-zero (Map*.pre g T))
                   *> pmap2 (*>) (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                                (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                        (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                      (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q))
                                      (->*.compose-zero (Map*.pre g T))
                         *> pmap2 (*>) (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} base (g.1 y))
                                  (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 base).1 y) (->*.compose-zero (Map*.pre g T))})))
           *> pmap (_ *>) (pmap2 (*>)
                (pmap (pmap (_ *>))
                  (ob.cat (\lam (G : B ->* T) => G.1 y)
                          (inv (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f))
                          (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q)
                           *> ->*.compose-zero (Map*.pre g T))
                          (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                         (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)
                           *> pmap inv (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                                      (->*.compose-assoc (Map*.pre g T) (Smash.adjunction.{u} {Y} {B'} {T} h) f)}))
                          (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                        (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q))
                                        (->*.compose-zero (Map*.pre g T))
                           *> pmap2 (*>) (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} base (g.1 y))
                                    (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 base).1 y) (->*.compose-zero (Map*.pre g T))}))
                   *> pmap (_ *>) (pmap2 (*>)
                        (pmap (pmap (_ *>))
                          (ob.cat (\lam (G : B ->* T) => G.1 y)
                                  (pmap (Map*.pre g T ∘*) (inv (cofSmashEquiv.pre'.{u} f h) *> pmap (Smash.adjunction.{u} {X} {B'} {T}) q))
                                  (->*.compose-zero (Map*.pre g T))
                                  (cofSmashEquiv.E.post.pre'-ev.{u} f h {q} base (g.1 y))
                                  (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 base).1 y) (->*.compose-zero (Map*.pre g T))})
                           *> pmap (_ *>) (pmap2 (*>) (pmap (pmap (_ *>)) (oDg {X} {B} {B'} {T} g y)) (oCg.{u} f g h q y))))
                        (oBg.{u} f g h y))))
                (oAK.{u} f g h y)))
