\import Homotopy.Cofiber.Null
\import Homotopy.Pointed
\import Homotopy.Pointed.Mapping
\import Homotopy.Pushout \hiding (PushoutPointed)
\import Homotopy.Smash
\import Homotopy.Smash.Cofiber
\import Homotopy.Smash.CoreScalar
\import Homotopy.Smash.OuterBeta
\import Homotopy.Smash.PreKInner
\import Homotopy.Smash.PreKOG
\import Homotopy.Smash.PreKOuter
\import Homotopy.Smash.PostBeta
\import Paths

\open ->* (∘*)
\open PushoutData (ppglue)

\func soK.{u} {X Y B B' T : Pointed.{u}} (f : X ->* Y) (g : B ->* B') (h : Smash.{u} Y B' ->* T)
              (q : h ∘* Smash.map.{u} f (->*.id {B'}) = base {Map* (Smash.{u} X B') T}) (y : B)
  => pmap (ob (\lam (G : B ->* T) => G.1 y)
              (inv (cofSmashEquiv.pre'.{u} f (h ∘* Smash.map.{u} (->*.id {Y}) g))
               *> pmap (Smash.adjunction.{u} {X} {B} {T})
                       (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B})))
                        *> pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                        *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                        *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q)))
          (cofSmashEquiv.naturalK.preK.lhsF.ev.{u} f g T h q base y)
     *> soKG.{u} f g h q y (cofSmashEquiv.pre'.{u} f (h ∘* Smash.map.{u} (->*.id {Y}) g))
                 (cofSmashEquiv.E.post.pre'-first.{u} f (h ∘* Smash.map.{u} (->*.id {Y}) g) base y) (vPo.{u} f (h ∘* Smash.map.{u} (->*.id {Y}) g) y)

\sfunc soKG.{u} {X Y B B' T : Pointed.{u}} (f : X ->* Y) (g : B ->* B') (h : Smash.{u} Y B' ->* T)
                (q : h ∘* Smash.map.{u} f (->*.id {B'}) = base {Map* (Smash.{u} X B') T}) (y : B)
                (P : Smash.adjunction.{u} {X} {B} {T} ((h ∘* Smash.map.{u} (->*.id {Y}) g) ∘* Smash.map.{u} f (->*.id {B}))
                     = Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g) ∘* f)
                (pf : pmap (\lam (G : X ->* Map* B T) => (G.1 base).1 y) P = idp)
                (vp : ob (\lam (G : B ->* T) => G.1 y) P pf = vPoR.{u} f (h ∘* Smash.map.{u} (->*.id {Y}) g) y)
  => pmap (ob (\lam (G : B ->* T) => G.1 y)
              (inv P
               *> pmap (Smash.adjunction.{u} {X} {B} {T})
                       (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B})))
                        *> pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                        *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                        *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q)))
          (ra (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y) (inv P)
                            (pmap (Smash.adjunction.{u} {X} {B} {T})
                                  (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B})))
                                   *> pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                                   *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                                   *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q)))
              (pmap (`*> pmap (\lam (h' : Smash.{u} X B ->* T) => h'.1 (Smash.proj.1 (base, y)))
                              (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B})))
                               *> pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                               *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                               *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q))
                    (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y) P
                     *> pmap inv pf))
              (idp_*> (pmap (\lam (h' : Smash.{u} X B ->* T) => h'.1 (Smash.proj.1 (base, y)))
                            (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B})))
                             *> pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                             *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                             *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q)))
              (CofNull.pre.ev.{u} {Smash.{u} X B} {Smash.{u} Y B} {Smash.{u} X B'} {Smash.{u} Y B'} {T} {Smash.map.{u} f (->*.id {B})} {Smash.map.{u} f (->*.id {B'})}
                                  (Smash.map.{u} (->*.id {X}) g) (Smash.map.{u} (->*.id {Y}) g) (cofSmashEquiv.naturalK.squareK.{u} f g)
                                  ((h, q) : CofNull.{u} (Smash.map.{u} f (->*.id {B'})) T) (Smash.proj.1 (base, y))
               *> pmap (`*> _) (pmap (pmap h.1) (cofSmashEquiv.naturalK.squareK.first.{u} f g base y))
               *> idp_*> _)
           *> pmap (_ *>) (pmap (_ *>) (pmap (`*> _) (pmap (`*> _)
                (edecM (\lam (G : Smash.{u} X B ->* T) => G.1 (Smash.proj.1 (base, y)))
                       (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B}))))
                       (pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g))
                       (->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g))
                       (pmap (`∘* Smash.map.{u} (->*.id {X}) g) q))))))
     *> ob.end (\lam (G : B ->* T) => G.1 y)
               (inv P
                *> pmap (Smash.adjunction.{u} {X} {B} {T})
                        (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B})))
                         *> pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                         *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                         *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q))
               (pmap_*>-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y) (inv P)
                             (pmap (Smash.adjunction.{u} {X} {B} {T})
                                   (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B})))
                                    *> pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                                    *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                                    *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q))
                *> pmap (`*> pmap (\lam (h' : Smash.{u} X B ->* T) => h'.1 (Smash.proj.1 (base, y)))
                                (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B})))
                                 *> pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                                 *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                                 *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q))
                      (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y) P
                       *> pmap inv pf))
               _
     *> pmap (_ *>)
          (ob.cat (\lam (G : B ->* T) => G.1 y) (inv P)
                  (pmap (Smash.adjunction.{u} {X} {B} {T})
                        (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B})))
                         *> pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                         *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                         *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q))
                  (pmap_inv-comm (\lam (G : X ->* Map* B T) => (G.1 base).1 y) P
                   *> pmap inv pf)
                  (idp {_} {pmap (\lam (G : X ->* Map* B T) => (G.1 base).1 y)
                                 (pmap (Smash.adjunction.{u} {X} {B} {T})
                                       (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B})))
                                        *> pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                                        *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                                        *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q))})
           *> pmap (_ *>) (pmap2 (*>)
                (pmap (pmap (_ *>))
                  (ocat.{u} (inv (->*.compose-assoc h (Smash.map.{u} (->*.id {Y}) g) (Smash.map.{u} f (->*.id {B}))))
                            (pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g)
                             *> ->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                             *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q) y
                   *> pmap (_ *>) (pmap (_ *>) (pmap2 (*>)
                        (pmap (pmap (_ *>))
                          (ocat.{u} (pmap (h ∘*) (cofSmashEquiv.naturalK.squareK.{u} f g))
                                    (->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g)
                                     *> pmap (`∘* Smash.map.{u} (->*.id {X}) g) q) y
                           *> pmap (_ *>) (pmap (_ *>) (pmap2 (*>)
                                (pmap (pmap (_ *>))
                                  (ocat.{u} (->*.compose-assoc h (Smash.map.{u} f (->*.id {B'})) (Smash.map.{u} (->*.id {X}) g))
                                            (pmap (`∘* Smash.map.{u} (->*.id {X}) g) q) y
                                   *> pmap (_ *>) (pmap (_ *>) (pmap2 (*>)
                                        (pmap (pmap (_ *>)) (opre3.{u} f g h q y))
                                        (oasF.{u} (\lam s => h.1 ((Smash.map.{u} f (->*.id {B'})).1 ((Smash.map.{u} (->*.id {X}) g).1 s)))
                                                  (idp_*> _ *> inv (pmap (`*> h.2) (pmap_*>-comm h.1 (pmap (Smash.map.{u} f (->*.id {B'})).1 (Smash.map.{u} (->*.id {X}) g).2)
                                                                                                 (Smash.map.{u} f (->*.id {B'})).2) *> *>-assoc _ _ _)) y)))))
                                (oposts.{u} h (cofSmashEquiv.naturalK.squareK.{u} f g) y
                                 *> pmap (_ *>) (pmap (_ *>) (pmap (`*> _) (pmap (pmap (\lam v => idp *> (pmap h.1 v *> h.2))) (oS.{u} f g y)))))))))
                        (oas0.{u} (\lam s => h.1 ((Smash.map.{u} (->*.id {Y}) g).1 ((Smash.map.{u} f (->*.id {B})).1 s)))
                                  (idp_*> _ *> inv (pmap (`*> h.2) (pmap_*>-comm h.1 (pmap (Smash.map.{u} (->*.id {Y}) g).1 (Smash.map.{u} f (->*.id {B})).2)
                                                                                 (Smash.map.{u} (->*.id {Y}) g).2) *> *>-assoc _ _ _)) y)))))
                (ob.inverse (\lam (G : B ->* T) => G.1 y) P
                            pf
                 *> pmap (\lam u => pmap (inv idp *>) (inv u) *> nc.inverse.lem idp _)
                         (vp
                          *> cPon (Smash.map.{u} (->*.id {Y}) g).1 h.1 (pmap (\lam (x : Y) => (pinl (x, y) : Smash.{u} Y B)) f.2)
                                  (ppglue (pinr y)) (ppglue (pinl base)) (ppglue (pinl (f.1 base))) (h ∘* Smash.map.{u} (->*.id {Y}) g).2
                                  (pmap_*>-comm (\lam (G : B ->* T) => G.1 y) (pmap (Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).1 f.2)
                                                (Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).2)
                                  (pmap_*>-comm (\lam (G : B ->* T) => G.1 y)
                                                (->*.happly (pmap (`∘* Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)) (Map*.pre.id {B} {T})) (f.1 base))
                                                (pmap (->*.id {Map* B T} ∘* Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).1 f.2
                                                 *> (->*.id {Map* B T} ∘* Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).2))
                                  (pmap_*>-comm (\lam (G : B ->* T) => G.1 y)
                                                (->*.happly (Map*.pre.id {B} {T}) ((Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).1 base))
                                                (pmap (->*.id {Map* B T}).1 (Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).2 *> (->*.id {Map* B T}).2))
                                  (pmap_*>-comm (\lam (G : B ->* T) => G.1 y)
                                                (pmap (Map*.pre (->*.id {B}) T ∘* Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).1 f.2)
                                                (pmap (Map*.pre (->*.id {B}) T).1 (Smash.adjunction.{u} {Y} {B} {T} (h ∘* Smash.map.{u} (->*.id {Y}) g)).2))))))
