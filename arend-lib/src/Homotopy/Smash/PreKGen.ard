\import Homotopy.Cofiber.Null
\import Homotopy.Smash
\import Homotopy.Smash.CoreScalar
\import Homotopy.Smash.PostBeta
\import Homotopy.Smash.PreKScalar
\import Paths

\func Ec {S : \Type} {a o z : S} (G : a = z) (G0 : o = z) : a = o
  => pmap (\lam s => s) G *> inv (pmap (\lam s => s) G0) *> idp

\func bS4 {S T D : \Type} (jx jb j0 : D -> S) {d1 d0 : D} (v : d1 = d0)
          {z : S} (Gx : jx d0 = z) (Gb : jb d0 = z) (G0 : j0 d0 = z) (h1 : S -> T) {t0 : T} (h2 : h1 (j0 d0) = t0)
          {es : h1 (jx d1) = t0} {e1 : h1 (jx d0) = t0}
          (nW : es *> idp = pmap h1 (pmap jx v) *> e1)
          (np : e1 *> (idp *> inv idp *> idp) = pmap h1 (idp *> Ec Gx G0) *> inv (pmap h1 (idp *> Ec Gb G0)) *> (pmap h1 (idp *> Ec Gb G0) *> h2))
          {Hfam : \Pi (b : D) -> h1 (jx b) = h1 (jx b)} (Sig : Hfam = (\lam b => idp))
          {eR0 : h1 (jx d0) = t0} (commR0 : eR0 = Hfam d0 *> e1)
          {eR1 : h1 (jx d1) = t0} (commR1 : eR1 = Hfam d1 *> es)
  => pmap (`*> idp) (inv (idp_*> (idp *> es) *> idp_*> es))
     *> (*>-assoc idp (inv idp *> es) idp
     *> (pmap (idp *>)
          (*>-assoc (inv idp) es idp
           *> (pmap (inv idp *>)
                 (*>-assoc es idp idp
                  *> (pmap (es *>) (idp {t0 = t0} {idp})
                  *> (pmap (`*> idp) (inv (commR1 *> (pmap (`*> es) (pmap (\lam (H : \Pi (b : D) -> h1 (jx b) = h1 (jx b)) => H d1) Sig) *> idp_*> es)))
                      *> pg {T} {h1 (jx d1)} {t0} {h1 (jx d0)} {t0} {t0} {eR1} {idp} {pmap h1 (pmap jx v)} {eR0} {idp}
                            {pmap h1 Gx *> inv (pmap h1 G0) *> h2}
                            (pmap (`*> idp {T} {t0}) commR1 *> *>-assoc (Hfam d1) es (idp {T} {t0}) *> pmap (Hfam d1 *>) nW
                             *> inv (*>-assoc (Hfam d1) (pmap h1 (pmap jx v)) e1) *> pmap (`*> e1) (natN Hfam v)
                             *> *>-assoc (pmap h1 (pmap jx v)) (Hfam d0) e1 *> pmap (pmap h1 (pmap jx v) *>) (inv commR0))
                            (pmap (`*> idp) (inv (inv (commR0 *> pmap2 (*>) (pmap (\lam (H : \Pi (b : D) -> h1 (jx b) = h1 (jx b)) => H d0) Sig) (idp {_} {e1}))))
                             *> (*>-assoc (inv idp) e1 idp
                             *> (pmap (inv idp *>) np
                             *> (pmap (inv idp *>) (inv (cP Gx Gb G0 h1 h2)) *> nc.inverse.lem idp (pmap h1 Gx *> inv (pmap h1 G0) *> h2))))))))
           *> (pmap (inv idp *>) (inv (pmap (`*> (pmap h1 (pmap jx v) *> (pmap h1 Gx *> inv (pmap h1 G0) *> h2))) (inv idp)
                                        *> idp_*> (pmap h1 (pmap jx v) *> (pmap h1 Gx *> inv (pmap h1 G0) *> h2))))
               *> nc.inverse.lem idp (pmap h1 (pmap jx v) *> (pmap h1 Gx *> inv (pmap h1 G0) *> h2)))))
     *> (*>-assoc idp idp (pmap h1 (pmap jx v) *> (pmap h1 Gx *> inv (pmap h1 G0) *> h2))
         *> (pmap (idp *>) (idp *> idp_*> (pmap h1 (pmap jx v) *> (pmap h1 Gx *> inv (pmap h1 G0) *> h2)))
         *> (*>-assoc idp idp (pmap h1 (pmap jx v) *> (pmap h1 Gx *> inv (pmap h1 G0) *> h2))
         *> (pmap (idp *>) (idp_*> (pmap h1 (pmap jx v) *> (pmap h1 Gx *> inv (pmap h1 G0) *> h2)))
         *> (idp_*> (pmap h1 (pmap jx v) *> (pmap h1 Gx *> inv (pmap h1 G0) *> h2))
             *> inv (cRV (pmap jx v) (pmap j0 v) Gx G0 G0 h1 h2))))))))

\func aS4 {S T D B0 : \Type} (jx jb j0 : D -> S) (g1 : B0 -> D) {b0 : B0} {d0 : D} (v : g1 b0 = d0)
          {z : S} (Gx : jx d0 = z) (Gb : jb d0 = z) (G0 : j0 d0 = z) (h1 : S -> T) {t0 : T} (h2 : h1 (j0 d0) = t0)
          {Psni : j0 d0 = j0 (g1 b0)} (invN : Psni = inv (pmap j0 v *> Ec G0 G0))
          {Psnx' : jx (g1 b0) = j0 (g1 b0)} (commN : Psnx' = (pmap jx v *> Ec Gx G0) *> Psni)
          {Psnx : jx (g1 b0) = j0 (g1 b0)} (chiNx : Psnx = idp *> Psnx')
          {Psnb' : jb (g1 b0) = j0 (g1 b0)} (commNb : Psnb' = (pmap jb v *> Ec Gb G0) *> Psni)
          {Psnb : jb (g1 b0) = j0 (g1 b0)} (chiNb : Psnb = idp *> Psnb')
          {Psmi : j0 d0 = jb d0} (invM : Psmi = inv (idp *> Ec Gb G0))
          {PsmE : jx d0 = jb d0} (commM : PsmE = (idp *> Ec Gx G0) *> Psmi)
          {Psmx : jx (g1 b0) = jb d0} (chiMx : Psmx = pmap jx v *> PsmE)
          {PsmE0 : jb d0 = jb d0} (commM0 : PsmE0 = (idp *> Ec Gb G0) *> Psmi)
          {Psm0 : jb (g1 b0) = jb d0} (chiM0 : Psm0 = pmap jb v *> PsmE0)
          {sAt : jx (g1 b0) = jx (g1 b0)} (sqf : sAt = idp)
          {es : h1 (jx (g1 b0)) = t0} {e1 : h1 (jx d0) = t0} {eo : h1 (jb d0) = t0}
          (nW : es *> idp = pmap h1 (pmap jx v) *> e1)
          (np : e1 *> (idp *> inv idp *> idp) = pmap h1 (idp *> Ec Gx G0) *> inv (pmap h1 (idp *> Ec Gb G0)) *> (pmap h1 (idp *> Ec Gb G0) *> h2))
          (hb : eo *> idp = pmap h1 (idp *> Ec Gb G0) *> h2)
          {uA : h1 (jx (g1 b0)) = h1 (jx (g1 b0))} (YA : uA = inv idp)
          {Psi3 : h1 (jx (g1 b0)) = t0} (chiC : Psi3 = idp *> es)
          {Psi2 : h1 (jx (g1 b0)) = t0} (chiB : Psi2 = pmap h1 sAt *> Psi3)
          {Psi1 : h1 (jx (g1 b0)) = t0} (chiA : Psi1 = uA *> Psi2)
  => pmap (`*> idp) (inv (idp_*> Psi1 *> (((chiA *> pmap (uA *>) (chiB *> pmap (pmap h1 sAt *>) chiC))
                                           *> CofNull.mapsOut.pre.fin2 {_} {_} {_} {_} {uA} {pmap h1 sAt} {idp} {es} YA idp)
                                          *> (pmap (`*> es) (pmap (pmap h1) sqf) *> idp_*> es))))
     *> (*>-assoc (inv idp) Psi1 idp
     *> (pmap (inv idp *>)
          (pmap (`*> idp) chiA
           *> (*>-assoc uA Psi2 idp
           *> (pmap (uA *>)
                 (pmap (`*> idp) chiB
                  *> (*>-assoc (pmap h1 sAt) Psi3 idp
                  *> (pmap (pmap h1 sAt *>)
                        (pmap (`*> idp) chiC
                         *> (*>-assoc idp es idp
                         *> (pmap (idp *>) (MQ jx jb j0 v Gx Gb G0 h1 h2 invM commM chiMx commM0 chiM0 nW np hb)
                         *> MF jx jb j0 v Gx Gb G0 h1 h2 chiM0)))
                  *> MP jx jb j0 g1 v Gx Gb G0 h1 h2 invN commN chiNx commNb chiNb invM commM chiMx commM0 chiM0 sqf)))
           *> MA jx jb j0 v Gx Gb G0 h1 h2 chiNb YA)))
     *> OI jx jb j0 v Gx Gb G0 h1 h2 invN commN chiNx commNb chiNb))
  \where {
    \func MQ {S T D : \Type} (jx jb j0 : D -> S) {d1 d0 : D} (v : d1 = d0)
             {z : S} (Gx : jx d0 = z) (Gb : jb d0 = z) (G0 : j0 d0 = z) (h1 : S -> T) {t0 : T} (h2 : h1 (j0 d0) = t0)
             {Psmi : j0 d0 = jb d0} (invM : Psmi = inv (idp *> Ec Gb G0))
             {PsmE : jx d0 = jb d0} (commM : PsmE = (idp *> Ec Gx G0) *> Psmi)
             {Psmx : jx d1 = jb d0} (chiMx : Psmx = pmap jx v *> PsmE)
             {PsmE0 : jb d0 = jb d0} (commM0 : PsmE0 = (idp *> Ec Gb G0) *> Psmi)
             {Psm0 : jb d1 = jb d0} (chiM0 : Psm0 = pmap jb v *> PsmE0)
             {es : h1 (jx d1) = t0} {e1 : h1 (jx d0) = t0} {eo : h1 (jb d0) = t0}
             (nW : es *> idp = pmap h1 (pmap jx v) *> e1)
             (np : e1 *> (idp *> inv idp *> idp) = pmap h1 (idp *> Ec Gx G0) *> inv (pmap h1 (idp *> Ec Gb G0)) *> (pmap h1 (idp *> Ec Gb G0) *> h2))
             (hb : eo *> idp = pmap h1 (idp *> Ec Gb G0) *> h2)
      => pcP (pmap h1 Psmx) idp (pmap h1 Psm0) idp (pmap h1 (idp *> Ec Gb G0) *> h2) idp
             (NXP {_} {_} {_} {_} {_} {_} {_} {_} {idp} {_} {idp}
                  (pmap (pmap h1) chiMx *> pmap_*>-comm h1 (pmap jx v) PsmE) idp
                  (KNP (pmap h1 (idp *> Ec Gx G0)) (pmap h1 (idp *> Ec Gb G0)) idp idp
                       ((pmap (pmap h1) commM *> pmap_*>-comm h1 (idp *> Ec Gx G0) Psmi)
                        *> pmap (pmap h1 (idp *> Ec Gx G0) *>) (pmap (pmap h1) invM *> pmap_inv-comm h1 (idp *> Ec Gb G0)))
                       idp (pmap h1 (idp *> Ec Gb G0) *> h2) idp np hb)
                  nW)
             hb

    \func MF {S T D : \Type} (jx jb j0 : D -> S) {d1 d0 : D} (v : d1 = d0)
             {z : S} (Gx : jx d0 = z) (Gb : jb d0 = z) (G0 : j0 d0 = z) (h1 : S -> T) {t0 : T} (h2 : h1 (j0 d0) = t0)
             {Psmx : jx d1 = jb d0} {PsmE0 : jb d0 = jb d0} {Psm0 : jb d1 = jb d0} (chiM0 : Psm0 = pmap jb v *> PsmE0)
      => idp_*> (pmap h1 Psmx *> inv (pmap h1 Psm0) *> (pmap h1 Psm0 *> (pmap h1 (idp *> Ec Gb G0) *> h2)))
         *> pmap (\lam w => pmap h1 Psmx *> inv (pmap h1 Psm0) *> w)
                 (inv (idp_*> (pmap h1 Psm0 *> (pmap h1 (idp *> Ec Gb G0) *> h2)))
                  *> (idp_*> (pmap h1 Psm0 *> (pmap h1 (idp *> Ec Gb G0) *> h2))
                      *> inv (pmap (`*> h2) (pmap_*>-comm h1 Psm0 (idp *> Ec Gb G0)) *> *>-assoc (pmap h1 Psm0) (pmap h1 (idp *> Ec Gb G0)) h2)))

    \func MA {S T D : \Type} (jx jb j0 : D -> S) {d1 d0 : D} (v : d1 = d0)
             {z : S} (Gx : jx d0 = z) (Gb : jb d0 = z) (G0 : j0 d0 = z) (h1 : S -> T) {t0 : T} (h2 : h1 (j0 d0) = t0)
             {Psnx : jx d1 = j0 d1} {Psnb' : jb d1 = j0 d1} {Psnb : jb d1 = j0 d1} (chiNb : Psnb = idp *> Psnb')
             {uA : h1 (jx d1) = h1 (jx d1)} (YA : uA = inv idp)
      => pmap (`*> (pmap h1 Psnx *> inv (pmap h1 Psnb) *> (pmap h1 (Psnb *> (pmap j0 v *> Ec G0 G0)) *> h2))) (inv (inv YA))
         *> (idp_*> (pmap h1 Psnx *> inv (pmap h1 Psnb) *> (pmap h1 (Psnb *> (pmap j0 v *> Ec G0 G0)) *> h2))
             *> pmap (\lam w => pmap h1 Psnx *> inv (pmap h1 Psnb) *> w)
                     (inv (idp_*> (pmap h1 Psnb *> (pmap h1 (pmap j0 v *> Ec G0 G0) *> h2))
                           *> inv (pmap (`*> h2) (pmap_*>-comm h1 Psnb (pmap j0 v *> Ec G0 G0))
                                   *> *>-assoc (pmap h1 Psnb) (pmap h1 (pmap j0 v *> Ec G0 G0)) h2))
                      *> idp_*> (pmap h1 Psnb *> (pmap h1 (pmap j0 v *> Ec G0 G0) *> h2))))

    \func LMC1 {S D B0 : \Type} (jx jb j0 : D -> S) (g1 : B0 -> D) {b0 : B0} {d0 : D} (v : g1 b0 = d0)
               {z : S} (Gx : jx d0 = z) (Gb : jb d0 = z) (G0 : j0 d0 = z)
               {Psni : j0 d0 = j0 (g1 b0)} (invN : Psni = inv (pmap j0 v *> Ec G0 G0))
               {Psnx' : jx (g1 b0) = j0 (g1 b0)} (commN : Psnx' = (pmap jx v *> Ec Gx G0) *> Psni)
               {Psnx : jx (g1 b0) = j0 (g1 b0)} (chiNx : Psnx = idp *> Psnx')
               {Psnb' : jb (g1 b0) = j0 (g1 b0)} (commNb : Psnb' = (pmap jb v *> Ec Gb G0) *> Psni)
               {Psnb : jb (g1 b0) = j0 (g1 b0)} (chiNb : Psnb = idp *> Psnb')
      => pmap (\lam w => (pmap jx (idp *> v) *> Ec Gx G0) *> w) (inv_*> (pmap jb (idp *> v) *> Ec Gb G0))
         *> ((SmashCocone.pre.comp-axis jx g1 (idp {B0} {b0}) v (Ec Gx G0) *> idp_*> (idp *> (pmap jx v *> Ec Gx G0)))
         *> inv ((pmap2 (\lam u w => pmap (\lam s => s) u *> inv (pmap (\lam s => s) w) *> (pmap (\lam s => s) w *> (pmap j0 v *> Ec G0 G0)))
                        (chiNx *> pmap (idp *>) (commN *> pmap ((pmap jx v *> Ec Gx G0) *>) invN))
                        (chiNb *> pmap (idp *>) (commNb *> pmap ((pmap jb v *> Ec Gb G0) *>) invN))
                  *> cRV idp idp (pmap jx v *> Ec Gx G0) (pmap jb v *> Ec Gb G0) (pmap j0 v *> Ec G0 G0) (\lam s => s) (pmap j0 v *> Ec G0 G0))
                 *> pmap (idp *>) (pmap (\lam w => (pmap jx v *> Ec Gx G0) *> w) (inv_*> (pmap j0 v *> Ec G0 G0)))))

    \func LMC2 {S D : \Type} (jx jb j0 : D -> S) {d1 d0 : D} (v : d1 = d0)
               {z : S} (Gx : jx d0 = z) (Gb : jb d0 = z) (G0 : j0 d0 = z)
               {Psmi : j0 d0 = jb d0} (invM : Psmi = inv (idp *> Ec Gb G0))
               {PsmE : jx d0 = jb d0} (commM : PsmE = (idp *> Ec Gx G0) *> Psmi)
               {Psmx : jx d1 = jb d0} (chiMx : Psmx = pmap jx v *> PsmE)
               {PsmE0 : jb d0 = jb d0} (commM0 : PsmE0 = (idp *> Ec Gb G0) *> Psmi)
               {Psm0 : jb d1 = jb d0} (chiM0 : Psm0 = pmap jb v *> PsmE0)
      => pmap (\lam w => (pmap jx (pmap (\lam b => b) v) *> Ec Gx G0) *> w) (inv_*> (pmap jb (pmap (\lam b => b) v) *> Ec Gb G0))
         *> ((SmashCocone.pre.comp-axis jx (\lam b => b) v idp (Ec Gx G0) *> idp_*> (pmap jx v *> (idp *> Ec Gx G0)))
         *> inv ((pmap2 (\lam u w => pmap (\lam s => s) u *> inv (pmap (\lam s => s) w) *> (pmap (\lam s => s) w *> (idp *> Ec Gb G0)))
                        (chiMx *> pmap (pmap jx v *>) (commM *> pmap ((idp *> Ec Gx G0) *>) invM))
                        (chiM0 *> pmap (pmap jb v *>) (commM0 *> pmap ((idp *> Ec Gb G0) *>) invM))
                  *> cRV (pmap jx v) (pmap jb v) (idp *> Ec Gx G0) (idp *> Ec Gb G0) (idp *> Ec Gb G0) (\lam s => s) (idp *> Ec Gb G0))
                 *> pmap (pmap jx v *>) (pmap (\lam w => (idp *> Ec Gx G0) *> w) (inv_*> (idp *> Ec Gb G0)))))

    \func MP {S T D B0 : \Type} (jx jb j0 : D -> S) (g1 : B0 -> D) {b0 : B0} {d0 : D} (v : g1 b0 = d0)
             {z : S} (Gx : jx d0 = z) (Gb : jb d0 = z) (G0 : j0 d0 = z) (h1 : S -> T) {t0 : T} (h2 : h1 (j0 d0) = t0)
             {Psni : j0 d0 = j0 (g1 b0)} (invN : Psni = inv (pmap j0 v *> Ec G0 G0))
             {Psnx' : jx (g1 b0) = j0 (g1 b0)} (commN : Psnx' = (pmap jx v *> Ec Gx G0) *> Psni)
             {Psnx : jx (g1 b0) = j0 (g1 b0)} (chiNx : Psnx = idp *> Psnx')
             {Psnb' : jb (g1 b0) = j0 (g1 b0)} (commNb : Psnb' = (pmap jb v *> Ec Gb G0) *> Psni)
             {Psnb : jb (g1 b0) = j0 (g1 b0)} (chiNb : Psnb = idp *> Psnb')
             {Psmi : j0 d0 = jb d0} (invM : Psmi = inv (idp *> Ec Gb G0))
             {PsmE : jx d0 = jb d0} (commM : PsmE = (idp *> Ec Gx G0) *> Psmi)
             {Psmx : jx (g1 b0) = jb d0} (chiMx : Psmx = pmap jx v *> PsmE)
             {PsmE0 : jb d0 = jb d0} (commM0 : PsmE0 = (idp *> Ec Gb G0) *> Psmi)
             {Psm0 : jb (g1 b0) = jb d0} (chiM0 : Psm0 = pmap jb v *> PsmE0)
             {sAt : jx (g1 b0) = jx (g1 b0)} (sqf : sAt = idp)
      => pmap (pmap h1 sAt *>) (Smash.restrict-post.lem h1 Psmx Psm0 (Psm0 *> (idp *> Ec Gb G0)) h2)
         *> (jj h1 sAt (Psmx *> inv Psm0 *> (Psm0 *> (idp *> Ec Gb G0))) h2
         *> (pmap (\lam v' => idp *> (pmap h1 v' *> h2))
                  (pmap (`*> (Psmx *> inv Psm0 *> (Psm0 *> (idp *> Ec Gb G0)))) (inv (inv sqf))
                   *> (idp_*> (Psmx *> inv Psm0 *> (Psm0 *> (idp *> Ec Gb G0)))
                       *> inv (inv (LMC1 jx jb j0 g1 v Gx Gb G0 invN commN chiNx commNb chiNb)
                               *> (idp *> (pmap (\lam (c : g1 b0 = d0) => (pmap jx c *> Ec Gx G0) *> inv (pmap jb c *> Ec Gb G0) *> (pmap jb c *> Ec Gb G0))
                                                (inv idp *> idp_*> v)
                                           *> LMC2 jx jb j0 v Gx Gb G0 invM commM chiMx commM0 chiM0)))))
         *> inv (Smash.restrict-post.lem h1 Psnx Psnb (Psnb *> (pmap j0 v *> Ec G0 G0)) h2)))

    \func OI {S T D : \Type} (jx jb j0 : D -> S) {d1 d0 : D} (v : d1 = d0)
             {z : S} (Gx : jx d0 = z) (Gb : jb d0 = z) (G0 : j0 d0 = z) (h1 : S -> T) {t0 : T} (h2 : h1 (j0 d0) = t0)
             {Psni : j0 d0 = j0 d1} (invN : Psni = inv (pmap j0 v *> Ec G0 G0))
             {Psnx' : jx d1 = j0 d1} (commN : Psnx' = (pmap jx v *> Ec Gx G0) *> Psni)
             {Psnx : jx d1 = j0 d1} (chiNx : Psnx = idp *> Psnx')
             {Psnb' : jb d1 = j0 d1} (commNb : Psnb' = (pmap jb v *> Ec Gb G0) *> Psni)
             {Psnb : jb d1 = j0 d1} (chiNb : Psnb = idp *> Psnb')
      => pmap (inv idp *>)
              (inv (cP (pmap jx v *> Ec Gx G0) (pmap jb v *> Ec Gb G0) (pmap j0 v *> Ec G0 G0) h1 (pmap h1 (pmap j0 v *> Ec G0 G0) *> h2)
                    *> inv (pmap2 (\lam u w => pmap h1 u *> inv (pmap h1 w) *> (pmap h1 w *> (pmap h1 (pmap j0 v *> Ec G0 G0) *> h2)))
                                  (chiNx *> pmap (idp *>) (commN *> pmap ((pmap jx v *> Ec Gx G0) *>) invN))
                                  (chiNb *> pmap (idp *>) (commNb *> pmap ((pmap jb v *> Ec Gb G0) *>) invN)))))
         *> nc.inverse.lem idp (pmap h1 (pmap jx v *> Ec Gx G0) *> inv (pmap h1 (pmap j0 v *> Ec G0 G0)) *> (pmap h1 (pmap j0 v *> Ec G0 G0) *> h2))
  }

\func iS4 {S T D B0 : \Type} (jx jb j0 : D -> S) (g1 : B0 -> D) {b0 : B0} {d0 : D} (v : g1 b0 = d0)
          {z : S} (Gx : jx d0 = z) (Gb : jb d0 = z) (G0 : j0 d0 = z) (h1 : S -> T) {t0 : T} (h2 : h1 (j0 d0) = t0)
          {Psni : j0 d0 = j0 (g1 b0)} (invN : Psni = inv (pmap j0 v *> Ec G0 G0))
          {Psnx' : jx (g1 b0) = j0 (g1 b0)} (commN : Psnx' = (pmap jx v *> Ec Gx G0) *> Psni)
          {Psnx : jx (g1 b0) = j0 (g1 b0)} (chiNx : Psnx = idp *> Psnx')
          {Psnb' : jb (g1 b0) = j0 (g1 b0)} (commNb : Psnb' = (pmap jb v *> Ec Gb G0) *> Psni)
          {Psnb : jb (g1 b0) = j0 (g1 b0)} (chiNb : Psnb = idp *> Psnb')
          {Psmi : j0 d0 = jb d0} (invM : Psmi = inv (idp *> Ec Gb G0))
          {PsmE : jx d0 = jb d0} (commM : PsmE = (idp *> Ec Gx G0) *> Psmi)
          {Psmx : jx (g1 b0) = jb d0} (chiMx : Psmx = pmap jx v *> PsmE)
          {PsmE0 : jb d0 = jb d0} (commM0 : PsmE0 = (idp *> Ec Gb G0) *> Psmi)
          {Psm0 : jb (g1 b0) = jb d0} (chiM0 : Psm0 = pmap jb v *> PsmE0)
          {sAt : jx (g1 b0) = jx (g1 b0)} (sqf : sAt = idp)
          {es : h1 (jx (g1 b0)) = t0} {e1 : h1 (jx d0) = t0} {eo : h1 (jb d0) = t0}
          (nW : es *> idp = pmap h1 (pmap jx v) *> e1)
          (np : e1 *> (idp *> inv idp *> idp) = pmap h1 (idp *> Ec Gx G0) *> inv (pmap h1 (idp *> Ec Gb G0)) *> (pmap h1 (idp *> Ec Gb G0) *> h2))
          (hb : eo *> idp = pmap h1 (idp *> Ec Gb G0) *> h2)
          {uA : h1 (jx (g1 b0)) = h1 (jx (g1 b0))} (YA : uA = inv idp)
          {Psi3 : h1 (jx (g1 b0)) = t0} (chiC : Psi3 = idp *> es)
          {Psi2 : h1 (jx (g1 b0)) = t0} (chiB : Psi2 = pmap h1 sAt *> Psi3)
          {Psi1 : h1 (jx (g1 b0)) = t0} (chiA : Psi1 = uA *> Psi2)
          {Hfam : \Pi (b : D) -> h1 (jx b) = h1 (jx b)} (Sig : Hfam = (\lam b => idp))
          {eR0 : h1 (jx d0) = t0} (commR0 : eR0 = Hfam d0 *> e1)
          {eR1 : h1 (jx (g1 b0)) = t0} (commR1 : eR1 = Hfam (g1 b0) *> es)
  : aS4 jx jb j0 g1 v Gx Gb G0 h1 h2 invN commN chiNx commNb chiNb invM commM chiMx commM0 chiM0 sqf nW np hb YA chiC chiB chiA
    = bS4 jx jb j0 v Gx Gb G0 h1 h2 nW np Sig commR0 commR1 \elim v, Sig
  | idp, idp => iS4c {S} {T} {D} {B0} {jx (g1 b0)} {jb (g1 b0)} {j0 (g1 b0)} g1 {b0} Gx Gb G0 h1 h2 invN commN chiNx commNb chiNb invM commM chiMx commM0 chiM0
                     sqf nW np hb YA chiC chiB chiA commR0 commR1

\func iS4c {S T D B0 : \Type} {a c o : S} (g1 : B0 -> D) {b0 : B0}
           {z : S} (Gx : a = z) (Gb : c = z) (G0 : o = z) (h1 : S -> T) {t0 : T} (h2 : h1 o = t0)
           {Psni : o = o} (invN : Psni = inv (idp *> Ec G0 G0))
           {Psnx' : a = o} (commN : Psnx' = (idp *> Ec Gx G0) *> Psni)
           {Psnx : a = o} (chiNx : Psnx = idp *> Psnx')
           {Psnb' : c = o} (commNb : Psnb' = (idp *> Ec Gb G0) *> Psni)
           {Psnb : c = o} (chiNb : Psnb = idp *> Psnb')
           {Psmi : o = c} (invM : Psmi = inv (idp *> Ec Gb G0))
           {PsmE : a = c} (commM : PsmE = (idp *> Ec Gx G0) *> Psmi)
           {Psmx : a = c} (chiMx : Psmx = idp *> PsmE)
           {PsmE0 : c = c} (commM0 : PsmE0 = (idp *> Ec Gb G0) *> Psmi)
           {Psm0 : c = c} (chiM0 : Psm0 = idp *> PsmE0)
           {sAt : a = a} (sqf : sAt = idp)
           {es : h1 a = t0} {e1 : h1 a = t0} {eo : h1 c = t0}
           (nW : es *> idp = idp *> e1)
           (np : e1 *> (idp *> inv idp *> idp) = pmap h1 (idp *> Ec Gx G0) *> inv (pmap h1 (idp *> Ec Gb G0)) *> (pmap h1 (idp *> Ec Gb G0) *> h2))
           (hb : eo *> idp = pmap h1 (idp *> Ec Gb G0) *> h2)
           {uA : h1 a = h1 a} (YA : uA = inv idp)
           {Psi3 : h1 a = t0} (chiC : Psi3 = idp *> es)
           {Psi2 : h1 a = t0} (chiB : Psi2 = pmap h1 sAt *> Psi3)
           {Psi1 : h1 a = t0} (chiA : Psi1 = uA *> Psi2)
           {eR0 : h1 a = t0} (commR0 : eR0 = idp *> e1)
           {eR1 : h1 a = t0} (commR1 : eR1 = idp *> es)
  : aS4 (\lam (_ : D) => a) (\lam (_ : D) => c) (\lam (_ : D) => o) g1 (idp {D} {g1 b0}) Gx Gb G0 h1 h2 invN commN chiNx commNb chiNb
        invM commM chiMx commM0 chiM0 sqf nW np hb YA chiC chiB chiA
    = bS4 (\lam (_ : D) => a) (\lam (_ : D) => c) (\lam (_ : D) => o) (idp {D} {g1 b0}) Gx Gb G0 h1 h2 nW np
          {\lam (_ : D) => idp} idp commR0 commR1
  \elim Gx, Gb, G0, t0, h2, invN, commN, chiNx, commNb, chiNb, invM, commM, chiMx, commM0, chiM0, sqf, nW, np, hb, YA, chiC, chiB, chiA, commR0, commR1
  | idp, idp, idp, _, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp, idp => idp
