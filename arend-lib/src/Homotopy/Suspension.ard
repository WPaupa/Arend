\import Equiv
\import Homotopy.Pointed
\import Homotopy.Pushout \hiding (PushoutPointed)
\import Paths

\func Susp (A : \Type) => PushoutData {A} (\lam _ => ()) (\lam _ => ())
  \where {
    \func rec {A B : \Type} (b1 b2 : B) (f : A -> b1 = b2) (x : Susp A) : B \elim x
      | north => b1
      | south => b2
      | pglue a => f a

    \func map {A B : \Type} (f : A -> B) : Susp A -> Susp B
      => rec north south (\lam a => pmerid (f a))

    \func mapEquiv {A B : \Type} (e : QEquiv {A} {B}) : QEquiv (map e) \cowith
      | ret => map e.ret
      | ret_f => PushoutData.homotopy {_} {_} {_} {_} {_} {_} {\lam s => map e.ret (map e s)} {\lam s => s}
                                      (\lam _ => idp) (\lam _ => idp) (\lam a => idp_*> _ *> pmap pmerid (inv (e.ret_f a)))
      | f_sec => PushoutData.homotopy {_} {_} {_} {_} {_} {_} {\lam s => map e (map e.ret s)} {\lam s => s}
                                      (\lam _ => idp) (\lam _ => idp) (\lam b => idp_*> _ *> pmap pmerid (inv (e.f_sec b)))

    \func pointed (A : \Type) => \new Pointed (Susp A) north

    \func func {A B : \Type} (f : A -> B) : pointed A ->* pointed B
      => (map f, idp)
      \where {
        \sfunc comp {A B C : \Type} (g : B -> C) (f : A -> B) : func (\lam a => g (f a)) = func g ->*.∘* func f
          => ->*.ext (PushoutData.homotopy {_} {_} {_} {_} {_} {_} {map (\lam a => g (f a))} {\lam x => map g (map f x)}
                                           (\lam _ => idp) (\lam _ => idp) (\lam _ => idp_*> _)) idp

        \sfunc const {A B : \Type} (b : B) : func {A} (\lam _ => b) = ->*.zero _ _
          => ->*.ext (PushoutData.homotopy {_} {_} {_} {_} {_} {_} {map (\lam _ => b)} {\lam _ => north}
                                           (\lam _ => idp) (\lam _ => inv (pmerid b)) (\lam _ => inv (*>_inv (pmerid b)))) idp
      }

    \func unit : QEquiv {\Sigma} {Susp (\Sigma)} \cowith
      | f _ => north
      | ret _ => ()
      | ret_f _ => idp
      | f_sec => PushoutData.homotopy {_} {_} {_} {_} {_} {_} {\lam _ => north} {\lam x => x} (\lam _ => idp) (\lam _ => pmerid ()) (\lam _ => idp)

    \func flip (X : Pointed) : pointed X ->* pointed X
      => (rec south north (\lam x => inv (pmerid x)), inv (pmerid base))

    \func flip-flip (X : Pointed) : flip X ->*.∘* flip X = ->*.id
      => ->*.ext {pointed X} {pointed X}
                 (PushoutData.homotopy {_} {_} {_} {_} {_} {_} (\lam _ => idp) (\lam _ => idp)
                   (\lam x => idp_*> _ *> inv (pmap_inv-comm (flip X).1 (pmerid x) *> inv_inv (pmerid x))))
                 (inv (pmap (`*> _) (pmap_inv-comm (flip X).1 (pmerid (base {X})) *> inv_inv (pmerid (base {X}))) *> *>_inv (pmerid (base {X}))))

    \func pushout.{u} (A : \Type u) => pushoutData {A} (\lam _ => ()) (\lam _ => ())
  }

\func Susp-Func {X Y : Pointed} (f : X ->* Y) : Susp.pointed X ->* Susp.pointed Y
  => (Susp.map f.1, idp)
  \where {
    \sfunc comp {X Y Z : Pointed} (g : Y ->* Z) (f : X ->* Y) : Susp-Func (g ->*.∘* f) = Susp-Func g ->*.∘* Susp-Func f
      => ->*.ext (PushoutData.homotopy {_} {_} {_} {_} {_} {_} {\lam x => Susp.map (\lam x => g.1 (f.1 x)) x} {\lam x => Susp.map g.1 (Susp.map f.1 x)}
                                       (\lam _ => idp) (\lam _ => idp) (\lam _ => idp_*> _)) idp

    \sfunc id {X : Pointed} : Susp-Func (->*.id {X}) = ->*.id
      => ->*.ext (PushoutData.homotopy {_} {_} {_} {_} {_} {_} {Susp.map (\lam x => x)} {\lam x => x}
                                       (\lam _ => idp) (\lam _ => idp) (\lam _ => idp_*> _)) idp

    \sfunc zero {X Y : Pointed} : Susp-Func (->*.zero X Y) = ->*.zero _ _
      => ->*.ext (PushoutData.homotopy {_} {_} {_} {_} {_} {_} {Susp.map (\lam _ => base)} {\lam _ => north}
                                       (\lam _ => idp) (\lam _ => inv (pmerid base)) (\lam _ => inv (*>_inv (pmerid base)))) idp
  }

\cons north {A : \Type} : Susp A => pinl ()

\cons south {A : \Type} : Susp A => pinr ()

\func pmerid {A : \Type} (a : A) : north = south => path (pglue a)
