\import Equiv
\import Equiv.Fiber
\import Function
\import Homotopy.Connectivity
\import Homotopy.Loop
\import Homotopy.Pointed
\import Logic
\import Logic.Meta
\import Logic.Unique
\import Paths
\import Set

\func componentsMap {A B : \Type} (f : A -> B) (t : Trunc0 A) : Trunc0 B
  => Trunc0.map t f

\lemma componentsMap-surj {A B : \Type} {f : A -> B} (s : IsSurj (componentsMap f)) : IsSurj f
  => \lam b => \case s (in0 b) \with {
    | inP (t, p) => fib t p
  }
  \where
    \lemma fib {A B : \Type} {f : A -> B} {b : B} (t : Trunc0 A) (p : componentsMap f t = in0 b) : ∃ (a : A) (f a = b) \elim t
      | in0 a => TruncP.map (transport (\lam (Q : \Prop) => Q) (Trunc0.equality (f a) b) p) (\lam q => (a, q))

-- | The HoTT book, Theorem 8.8.1.
\lemma whiteheadPaths {A B : \Type} (f : A -> B) (s : IsSurj (componentsMap f))
                      (paths : \Pi (x y : A) -> IsEquiv (pmap f {x} {y}))
  : IsEquiv f
  => IsEquiv.fromEmbSurj (\new Embedding f (\lam x y => IsEquiv.toQEquiv (paths x y))) (componentsMap-surj s)

-- | The HoTT book, Corollary 8.8.2.
\lemma whiteheadLoops {A B : \Type} (f : A -> B) (e0 : IsEquiv (componentsMap f))
                      (loops : \Pi (a : A) -> IsEquiv (pmap f {a} {a}))
  : IsEquiv f
  => whiteheadPaths f (IsEquiv.isSurj e0) \lam x y => contrFibers=>IsEquiv \lam q =>
      \case transport (\lam (Q : \Prop) => Q) (Trunc0.equality x y) (IsEquiv.isInj e0 (pmap in0 q)) \with {
        | inP p => IsEquiv=>contrFibers (paths f loops p) q
      }
  \where
    \lemma paths {A B : \Type} (f : A -> B) (loops : \Pi (a : A) -> IsEquiv (pmap f {a} {a})) {x y : A} (p : x = y)
      : IsEquiv (pmap f {x} {y}) \elim p
      | idp => loops x

\lemma whiteheadPointed.{u} {X Y : Pointed.{u}} (f : X ->* Y) (cX : isNConnectedType 1 X) (cY : isNConnectedType 1 Y)
                            (e : IsEquiv (Loop-Func f).1)
  : IsEquiv f.1
  => whiteheadLoops f.1 (contr-equiv (components-contr cX) (components-contr cY))
       \lam a => \case nconnected1-path cX (base {X}) a \with {
         | inP q => transport (\lam a => IsEquiv (pmap f.1 {a} {a})) q (base-loops f.1 f.2 e)
       }
  \where {
    \lemma components-contr.{u} {X : Pointed.{u}} (c : isNConnectedType 1 X) : Contr (Trunc0 X)
      => Contr.make (in0 base) \lam t => \case \elim t \with {
        | in0 x => \case nconnected1-path c (base {X}) x \with {
          | inP q => pmap in0 q
        }
      }

    \lemma base-loops {A B : \Type} (f : A -> B) {a : A} {b : B} (q : f a = b) (e : IsEquiv (loopMap f q)) : IsEquiv (pmap f {a} {a}) \elim b, q
      | _, idp => transport IsEquiv (path \lam i z => idp_*> (pmap f z) @ i) e
  }
