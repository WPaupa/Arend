{- | Numeric connectedness, the HoTT book, Section 7.5, indexed as in {ofHLevel_-1+} rather than as in the book:
     ``isNConnectedType n`` is the book's ``(n-1)``-connectedness, so ``n = 0`` is mere inhabitedness and
     ``n = 1`` is ordinary connectedness. The same shift applies to {isNConnectedMap} and {isNTruncatedMap}.
 -}

\import Equiv
\import Homotopy.Fibration
\import Homotopy.HLevel
\import Arith.Nat
\import Homotopy.Join
\import Homotopy.Localization.Accessible
\import Homotopy.Localization.Connected
\import Homotopy.Localization.Equiv
\import Homotopy.Localization.Truncation
\import Homotopy.Localization.Universe
\import Homotopy.Loop
\import Homotopy.Pointed
\import Homotopy.Sphere
\import Homotopy.Suspension
\import Homotopy.Truncation
\import Logic
\import Logic.Unique
\import Order.PartialOrder
\import Paths
\import Paths.Meta

\func isNConnectedType.{u} (n : Nat) (A : \Type u) : \Prop
  => isConnectedType {truncUniverse n} A

\func isNConnectedMap.{u} (n : Nat) {A B : \Type u} (f : A -> B) : \Prop
  => isConnectedMap {truncUniverse n} f

\func isNTruncatedMap.{u} (n : Nat) {A B : \Type u} (f : A -> B) : \Prop
  => \Pi (b : B) -> Fib f b ofHLevel_-1+ n

\lemma nconnected-iff-trunc-contr.{u} (n : Nat) (A : \Type u) : isNConnectedType n A = Contr (Trunc_-1+ n A)
  => propExt (isConnected=>contr {truncUniverse n} A) (contr=>isConnected {truncUniverse n} A)

\lemma nconnected-map-fibers.{u} (n : Nat) {A B : \Type u} (f : A -> B)
  : isNConnectedMap n f = (\Pi (b : B) -> Contr (Trunc_-1+ n (Fib f b)))
  => path \lam i => \Pi (b : B) -> nconnected-iff-trunc-contr n (Fib f b) @ i

\lemma nconnected-equiv.{u} (n : Nat) {A B : \Type u} (e : QEquiv {A} {B}) (c : isNConnectedType n A) : isNConnectedType n B
  => isConnected-equiv {truncUniverse n} e c

\lemma nconnected-contr.{u} (n : Nat) {A : \Type u} (c : Contr A) : isNConnectedType n A
  => contr=>isConnectedType {truncUniverse n} c

\lemma nconnected-map-equiv.{u} (n : Nat) {A B : \Type u} {f : A -> B} (e : IsEquiv f) : isNConnectedMap n f
  => equiv=>isConnectedMap {truncUniverse n} e

\lemma nconnected-map-mono.{u} {m n : Nat} {A B : \Type u} {f : A -> B} (p : m <= n)
                               (c : isNConnectedMap n f) : isNConnectedMap m f
  => propExt.conv (nconnected-map-fibers m f)
      (\lam b => propExt.dir (nconnected-iff-trunc-contr m (Fib f b))
          (nconnected-mono p (propExt.conv (nconnected-iff-trunc-contr n (Fib f b))
                                           (propExt.dir (nconnected-map-fibers n f) c b))))

\func TruncMap.{u} (n : Nat) {A B : \Type u} (f : A -> B) (x : Trunc_-1+ n A) : Trunc_-1+ n B
  => Trunc_-1+.elim (\lam _ => Trunc_-1+.level n B) (\lam a => inT (f a)) x
  \where {
    \func =lmap.{u} {n : Nat} {A B : \Type u} (f : A -> B) (x : Trunc_-1+ n A) : TruncMap n f x = lmap {truncUniverse n} f x
      => trunc-unique (Trunc_-1+.level n B) (TruncMap n f) (lmap {truncUniverse n} f)
                      (\lam a => inv (Localization.lift-prop {localization {truncUniverse n} A} (\lam a => inT (f a)) a)) x

    \func equiv.{u} {n : Nat} {A B : \Type u} (e : QEquiv {A} {B}) : QEquiv {Trunc_-1+ n A} {Trunc_-1+ n B}
      => transport (\lam T => QEquiv {Trunc_-1+ n A} {Trunc_-1+ n T}) (QEquiv_= e) idEquiv
  }

-- | The HoTT Book, Lemma 7.5.14.
\lemma nconnected-map=>trunc-equiv.{u} {n : Nat} {A B : \Type u} (f : A -> B) (c : isNConnectedMap n f)
  : IsEquiv (TruncMap n f)
  => transport IsEquiv (inv (path \lam i x => TruncMap.=lmap f x i))
                       (transport (\lam X => X) (localEquivMap {truncUniverse n} f) (connected_isLocalEquiv f c))

-- | Corollary 7.5.8.
\lemma trunc-in-nconnected.{u} {n : Nat} {A : \Type u} : isNConnectedMap n (inT {n} {A})
  => lEta-connected {truncUniverse n}

\lemma inhabited=>nconnected0.{u} {A : \Type u} (a : A) : isNConnectedType 0 A
  => propExt.conv (nconnected-iff-trunc-contr 0 A)
                  (isProp=>isContr (ToProp.fromProp (isTruncated {Trunc_-1+.level 0 A})) (inT a))

\lemma nconnected-mono.{u} {m n : Nat} {A : \Type u} (p : m <= n) (c : isNConnectedType n A) : isNConnectedType m A
  => \lam Z => c (\new Local {truncUniverse n} Z (HLevel_-1_<= m n p Z.local))

\lemma loop-nconnected.{u} {n : Nat} (X : Pointed.{u}) (c : isNConnectedType (suc n) X) : isNConnectedType n (Loop X)
  => propExt.conv (nconnected-iff-trunc-contr n (Loop X))
      (Contr.Contr_QEquiv (Trunc_-1+.equality base base)
        (isProp=>PathContr (Trunc_-1+ (suc n) X)
                           (isContr=>isProp (propExt.dir (nconnected-iff-trunc-contr (suc n) X) c))
                           (inT base) (inT base)))

\lemma nconnected_join.{u} {m n : Nat} (X Y : \Type u) (cx : isNConnectedType m X) (cy : isNConnectedType n Y)
  : isNConnectedType (suc (m Nat.+ n)) (Join X Y)
  => propExt.conv (toSphereNull (suc (m Nat.+ n)) (Join X Y))
      (rewriteI (Join_Sphere_Sphere m n)
                (connected_join X Y (Sphere m) (Sphere n) (propExt.dir (toSphereNull m X) cx)
                                                          (propExt.dir (toSphereNull n Y) cy)))
  \where
    \lemma toSphereNull.{u} (n : Nat) (X : \Type u) : isNConnectedType n X = isConnectedType {nullTypeUniverse (Sphere n)} X
      => connectedType-local-cong {truncUniverse n} {nullTypeUniverse (Sphere n)} (\lam Z => inv (sphereNull_iff_truncated n Z)) X

\lemma sphere0-nconnected.{u} : isNConnectedType.{u} 0 (Sphere 0)
  => inhabited=>nconnected0 north

\lemma susp-nconnected.{u} {n : Nat} {A : \Type u} (c : isNConnectedType n A) : isNConnectedType (suc n) (Susp A)
  => nconnected-equiv (suc n) (Join_Sphere0 A) (nconnected_join.{u} {0} {n} (Sphere 0) A sphere0-nconnected.{u} c)

\lemma sphere-nconnected.{u} (n : Nat) : isNConnectedType.{u} n (Sphere n) \elim n
  | 0 => sphere0-nconnected
  | suc n => susp-nconnected (sphere-nconnected n)
