\import Algebra.Group
\import Algebra.Group.GradedComplex
\import Algebra.Group.GroupHom
\import Algebra.Monoid
\import Algebra.Monoid.MonoidHom
\import Algebra.Pointed
\import Arith.Nat (pred)
\import Paths

\record CochainComplex \extends GradedComplex {
  | Ix => Nat
  | src => pred
  | tgt => suc
  | delta (n : Nat) : AddGroupHom (D n) (D (suc n))
  | delta-delta (n : Nat) (x : D n) : delta (suc n) (delta n x) = 0
  | dIn n => \case \elim n \with {
    | 0 => AddGroupHom.zero
    | suc n => delta n
  }
  | dOut => delta
  | dOut-dIn n x => \case \elim n, \elim x \with {
    | 0, _ => AddMonoidHom.func-zro {delta 0}
    | suc n, x => delta-delta n x
  }
}

\record CochainMap (CX CY : CochainComplex) \extends ComplexMap {
  | Ix => Nat
  | src => pred
  | tgt => suc
  | X => CX
  | Y => CY
  | commIn n x => \case \elim n, \elim x \with {
    | 0, _ => inv (AddMonoidHom.func-zro {f 0})
    | suc n, x => commOut n x
  }
}

\record CochainHomotopy {X Y : CochainComplex} (F G : CochainMap X Y) {
  | L (n : Nat) : AddGroupHom (X.D (suc n)) (Y.D n)
  | homotopy0 (x : X.D 0) : F.f 0 x - G.f 0 x = L 0 (X.delta 0 x)
  | homotopy (n : Nat) (x : X.D (suc n)) : F.f (suc n) x - G.f (suc n) x = L (suc n) (X.delta (suc n) x) + Y.delta n (L n x)
}
