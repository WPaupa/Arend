-- | Group structures and homomorphisms detected by injective homomorphisms.

\import Algebra.Group
\import Algebra.Group.GroupHom
\import Algebra.Monoid
\import Algebra.Pointed
\import Function (IsInj)
\import Paths

-- | The abelian group on `E` with the given operations, when an injective map carries them to those of `B`.
\func injectiveAbGroup {E : \Set} (B : AbGroup) (f : E -> B) (f-inj : IsInj f)
                       (z : E) (add : E -> E -> E) (neg : E -> E)
                       (f-zro : f z = 0) (f-+ : \Pi (x y : E) -> f (add x y) = f x + f y)
                       (f-negative : \Pi (x : E) -> f (neg x) = negative (f x)) : AbGroup E \cowith
  | zro => z
  | + => add
  | zro-left {x} => f-inj (f-+ z x *> pmap (\lam t => t + f x) f-zro *> B.zro-left)
  | +-assoc {x} {y} {w} => f-inj (f-+ _ w *> pmap (\lam t => t + f w) (f-+ x y) *> B.+-assoc
                                  *> inv (f-+ x _ *> pmap (f x +) (f-+ y w)))
  | negative => neg
  | negative-left {x} => f-inj (f-+ _ x *> pmap (\lam t => t + f x) (f-negative x) *> B.negative-left *> inv f-zro)
  | +-comm {x} {y} => f-inj (f-+ x y *> B.+-comm *> inv (f-+ y x))

-- | A map is additive if injective homomorphisms carry it to a homomorphism.
\func squareHom {A B C D : AddGroup} (fA : AddGroupHom A C) (fB : AddGroupHom B D) (fB-inj : IsInj fB)
                (F : A -> B) (G : AddGroupHom C D) (sq : \Pi (a : A) -> fB (F a) = G (fA a)) : AddGroupHom A B \cowith
  | func => F
  | func-+ {x} {y} => fB-inj (sq _ *> pmap G fA.func-+ *> G.func-+ *> inv (fB.func-+ *> pmap2 (+) (sq x) (sq y)))
