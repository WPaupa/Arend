{- | The HoTT book, Lemma 8.4.7, for groups that need not be abelian. -}

\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Group.GroupCat
\import Algebra.Group.GroupHom
\import Algebra.Pointed.Exact
\import Category \hiding (id, o)
\import Equiv
\import Function
\import Logic
\import Logic.Meta
\import Logic.Unique
\import Paths

\lemma exact-middle-injective {K G H : Group} {u : GroupHom K G} {f : GroupHom G H}
                              (e : ExactAt u f) (Kc : Contr K) : IsInj f
  => f.injective (\lam {a} q => \case (e a).1 q \with {
    | inP (k,p) => inv p *> pmap u (isContr=>isProp Kc k ide) *> u.func-ide
  })

\func exact-middle-iso.{l} {K G H Q : Group.{l}} {u : GroupHom K G} {f : GroupHom G H} {v : GroupHom H Q}
                           (e1 : ExactAt u f) (e2 : ExactAt f v) (Kc : Contr K) (Qc : Contr Q)
  : Iso {GroupCat.{l}} f
  => GroupCat.isoOfEquiv f (QEquiv.fromInjSurj (exact-middle-injective e1 Kc) (exact-middle-surjective e2 Qc))

\func AbExactAt {U V W : AbGroup} (f : AddGroupHom U V) (g : AddGroupHom V W) : \Prop
  => ExactAt (AddGroupHom.toGroupHom f) (AddGroupHom.toGroupHom g)
  \where {
    \lemma zero {U V W : AbGroup} {f : AddGroupHom U V} {g : AddGroupHom V W} (e : AbExactAt f g) (u : U) : g (f u) = 0
      => (e (f u)).2 (inP (u, idp))

    \lemma lift {U V W : AbGroup} {f : AddGroupHom U V} {g : AddGroupHom V W} (e : AbExactAt f g) {v : V} (p : g v = 0)
      : ∃ (u : U) (f u = v)
      => (e v).1 p

    \lemma transport {U U' V V' W W' : AbGroup} (f : AddGroupHom U V) (g : AddGroupHom V W)
                     (f' : AddGroupHom U' V') (g' : AddGroupHom V' W')
                     (a : AddGroupHom U' U) (as : IsSurj a) (b : AddGroupHom V V') (bs : IsSurj b) (bi : IsInj b)
                     (c : AddGroupHom W W') (ci : IsInj c)
                     (sq1 : \Pi (u : U') -> f' u = b (f (a u))) (sq2 : \Pi (v : V) -> g' (b v) = c (g v)) (e : AbExactAt f g)
      : AbExactAt f' g'
      => ExactAt-transport {_} {_} {_} {_} {_} {_} {AddGroupHom.toGroupHom f} {AddGroupHom.toGroupHom g}
                           (AddGroupHom.toGroupHom f') (AddGroupHom.toGroupHom g') (AddGroupHom.toGroupHom a) as
                           (AddGroupHom.toGroupHom b) bs bi (AddGroupHom.toGroupHom c) ci sq1 sq2 e
  }

\func short-five.{l} {A B C A' B' C' : AbGroup.{l}} {i : AddGroupHom A B} {p : AddGroupHom B C} {i' : AddGroupHom A' B'} {p' : AddGroupHom B' C'}
                     (e : AbExactAt i p) (ps : IsSurj p) (e' : AbExactAt i' p') (i'i : IsInj i')
                     {a : AddGroupHom A A'} (ai : Iso {AbGroupCat.{l}} a) {b : AddGroupHom B B'} {c : AddGroupHom C C'} (ci : Iso {AbGroupCat.{l}} c)
                     (sq1 : \Pi (x : A) -> b (i x) = i' (a x)) (sq2 : \Pi (y : B) -> c (p y) = p' (b y))
  : Iso {AbGroupCat.{l}} b
  => AbGroupCat.isoOfEquiv b (QEquiv.fromInjSurj
      (injective e i'i (\lam q => (AbGroupCat.equivOfIso ai).isInj q) (\lam q => (AbGroupCat.equivOfIso ci).isInj q) sq1 sq2)
      (surjective ps e' (AbGroupCat.equivOfIso ai).isSurj (AbGroupCat.equivOfIso ci).isSurj sq1 sq2))
  \where {
    \lemma add-sub {G : AbGroup} {b y : G} : b + (y - b) = y
      => equation.abGroup

    \lemma injective {A B C A' B' C' : AbGroup} {i : AddGroupHom A B} {p : AddGroupHom B C} {i' : AddGroupHom A' B'} {p' : AddGroupHom B' C'}
                     (e : AbExactAt i p) (i'i : IsInj i') {a : AddGroupHom A A'} (ai : IsInj a) {b : AddGroupHom B B'} {c : AddGroupHom C C'} (ci : IsInj c)
                     (sq1 : \Pi (x : A) -> b (i x) = i' (a x)) (sq2 : \Pi (y : B) -> c (p y) = p' (b y)) : IsInj b
      => b.injective \lam {y} by=0 => \case AbExactAt.lift e (ci (sq2 y *> pmap p' by=0 *> p'.func-zro *> inv c.func-zro)) \with {
        | inP (x, ix) => inv ix *> pmap i (ai (i'i (inv (sq1 x) *> pmap b ix *> by=0 *> inv i'.func-zro) *> inv a.func-zro)) *> i.func-zro
      }

    \lemma surjective {A B C A' B' C' : AbGroup} {i : AddGroupHom A B} {p : AddGroupHom B C} {i' : AddGroupHom A' B'} {p' : AddGroupHom B' C'}
                      (ps : IsSurj p) (e' : AbExactAt i' p') {a : AddGroupHom A A'} (as : IsSurj a) {b : AddGroupHom B B'} {c : AddGroupHom C C'} (cs : IsSurj c)
                      (sq1 : \Pi (x : A) -> b (i x) = i' (a x)) (sq2 : \Pi (y : B) -> c (p y) = p' (b y)) : IsSurj b
      => \lam y' => \case cs (p' y') \with {
        | inP (w, cw) => \case ps w \with {
          | inP (z, pz) => \case AbExactAt.lift e' {y' - b z} (p'.func-minus *> pmap (_ -) (inv (sq2 z) *> pmap c pz *> cw) *> AddGroup.toZero idp) \with {
            | inP (x', ix') => \case as x' \with {
              | inP (x, ax) => inP (z + i x, b.func-+ *> pmap (_ +) (sq1 x *> pmap i' ax *> ix') *> add-sub)
            }
          }
        }
      }
  }
