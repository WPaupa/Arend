\import Algebra.Group
\import Algebra.Group.Cochain
\import Algebra.Group.GradedComplex
\import Algebra.Module
\import Algebra.Module.GradedComplex
\import Algebra.Module.Graded
\import Algebra.Module.LinearMap
\import Algebra.Module.Quotient
\import Algebra.Module.SubLModule
\import Algebra.Ring
\import Algebra.Ring.DGA
\import Paths
\import Paths.Meta

\record LCochainComplex.{u} \extends CochainComplex, LGradedComplex.{u}
  | dIn-*c {n} {_} {x} => \case \elim n, \elim x \with {
    | 0, _ => inv LModule.*c_zro-right
    | suc n, _ => dOut-*c
  }

\record LCochainPairing.{u} {R : Ring.{u}} (LX LY LZ : LCochainComplex.{u} R) \extends CochainPairing {
  | X => LX
  | Y => LY
  | Z => LZ
  | *c-mul-left {p q : Nat} {r : R} {a : LX.D p} {b : LY.D q} : mul p q (r *c a) b = r *c mul p q a b
  | *c-mul-right {p q : Nat} {r : R} {a : LX.D p} {b : LY.D q} : mul p q a (r *c b) = r *c mul p q a b

  \func graded : LGradedPairing R \cowith
    | H => LX.D
    | K => LY.D
    | L => LZ.D
    | mul => mul
    | *c-left => *c-mul-left
    | *c-right => *c-mul-right

  \func lcohomologyPairing : LGradedPairing R
    => LGradedPairing.quotient (LGradedPairing.sub graded LX.LIsCycle LY.LIsCycle LZ.LIsCycle cocycle-mul)
                               LX.LIsBoundary LY.LIsBoundary LZ.LIsBoundary coboundary-left coboundary-right
}

\record LDGA.{u} \extends LCochainComplex.{u}, DGA {
  | mul-*c-left {p q : Nat} {r : R} {a : D p} {b : D q} : mul p q (r *c a) b = r *c mul p q a b
  | mul-*c-right {p q : Nat} {r : R} {a : D p} {b : D q} : mul p q a (r *c b) = r *c mul p q a b
} \where {
  \func lpairing.{u} {R : Ring.{u}} (A : LDGA.{u} R) : LCochainPairing A A A \cowith
    | CochainPairing => A.pairing
    | *c-mul-left => A.mul-*c-left
    | *c-mul-right => A.mul-*c-right

  \func graded.{u} {R : Ring.{u}} (A : LDGA.{u} R) : LGradedProduct R \cowith
    | H => A.D
    | mul => A.mul
    | one => A.one
    | mul-assoc => A.mul-assoc
    | one-left => A.one-left
    | one-right => A.one-right
    | *c-left => A.mul-*c-left
    | *c-right => A.mul-*c-right

  \func lcohomologyProduct.{u} {R : Ring.{u}} (A : LDGA.{u} R) : LGradedProduct R
    => LGradedProduct.quotient (LGradedProduct.sub (graded A) A.LIsCycle A.pairing.cocycle-mul A.one-cocycle) A.LIsBoundary
                               A.pairing.coboundary-left A.pairing.coboundary-right
}

\record LDGModule.{u} \extends DGModule, LCochainComplex.{u} {
  \override A : LDGA.{u}
  | R => LDGA.R {A}
  | act-*c-left {p q : Nat} {r : R} {a : A.D p} {x : D q} : mul p q (r *c a) x = r *c mul p q a x
  | act-*c-right {p q : Nat} {r : R} {a : A.D p} {x : D q} : mul p q a (r *c x) = r *c mul p q a x
} \where {
  \func lpairing.{u} {B : LDGA.{u}} (M : LDGModule.{u} B) : LCochainPairing B M M \cowith
    | CochainPairing => M.pairing
    | *c-mul-left => M.act-*c-left
    | *c-mul-right => M.act-*c-right

  \func graded.{u} {B : LDGA.{u}} (M : LDGModule.{u} B) : LGradedModule (LDGA.graded B) \cowith
    | K => M.D
    | mul => M.mul
    | act-assoc => M.act-assoc
    | act-ide => M.act-ide
    | *c-act-left => M.act-*c-left
    | *c-act-right => M.act-*c-right

  \func lcohomologyModule.{u} {B : LDGA.{u}} (M : LDGModule.{u} B) : LGradedModule (LDGA.lcohomologyProduct B)
    => LGradedModule.quotient (LGradedModule.sub (graded M) B.LIsCycle B.pairing.cocycle-mul B.one-cocycle M.LIsCycle M.pairing.cocycle-mul)
                              B.LIsBoundary B.pairing.coboundary-left B.pairing.coboundary-right M.LIsBoundary M.pairing.coboundary-left M.pairing.coboundary-right
}
