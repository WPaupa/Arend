\import Algebra.Group
\import Algebra.Group.Exact
\import Algebra.Meta
\import Algebra.Group.GradedComplex
\import Algebra.Module
\import Algebra.Module.BilinearMap
\import Algebra.Module.GradedComplex
\import Algebra.Module.LinearMap
\import Algebra.Module.Quotient
\import Algebra.Module.SubLModule
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Ring
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta
\import Relation.Equivalence

\func GradedMap {R : Ring} {G : AbGroup} (A B : G -> LModule R) (a : G) : \Type
  => \Pi {x y : G} -> x + a = y -> LinearMap (A x) (B y)
  \where {
    \lemma pre {G : AbGroup} (y a : G) : y - a + a = y
      => +-assoc *> pmap (y +) negative-left *> zro-right

    \lemma source {G : AbGroup} {x y a : G} (p : x + a = y) : x = y - a
      => inv (pmap (`- a) (inv p) *> +-assoc *> pmap (x +) negative-right *> zro-right)

    \func id {R : Ring} {G : AbGroup} {A : G -> LModule R} : GradedMap A A 0
      => \lam {x} p => transport (\lam z => LinearMap (A x) (A z)) (inv zro-right *> p) LinearMap.id

    \lemma id-eval {R : Ring} {G : AbGroup} {A : G -> LModule R} {x : G} (p : x + 0 = x) (u : A x) : id p u = u
      => pmap (\lam (e : x = x) => transport (\lam z => LinearMap (A x) (A z)) e LinearMap.id u) (prop-pi {x = x} {inv zro-right *> p} {idp})

    \lemma id-zero {R : Ring} {G : AbGroup} {A : G -> LModule R} {x y : G} (p : x + 0 = y) {u : A x} (h : id p u = 0) : u = 0
      => aux (inv zro-right *> p) p h
      \where
        \lemma aux {R : Ring} {G : AbGroup} {A : G -> LModule R} {x y : G} (s : x = y) (p : x + 0 = y) {u : A x} (h : id p u = 0) : u = 0 \elim y, s
          | _, idp => inv (id-eval p u) *> h

    \lemma id-right {R : Ring} {G : AbGroup} {A B : G -> LModule R} {a : G} (f : GradedMap A B a) {x w y : G} (p : x + 0 = w) (q : w + a = y) (q' : x + a = y) (u : A x)
      : f q (id p u) = f q' u
      => aux f (inv zro-right *> p) p q q' u
      \where
        \lemma aux {R : Ring} {G : AbGroup} {A B : G -> LModule R} {a : G} (f : GradedMap A B a) {x w y : G} (s : x = w) (p : x + 0 = w) (q : w + a = y) (q' : x + a = y) (u : A x)
          : f q (id p u) = f q' u \elim w, s
          | _, idp => pmap (f q) (id-eval p u) *> pmap (\lam r => f r u) prop-pi

    \lemma id-left {R : Ring} {G : AbGroup} {A B : G -> LModule R} {a : G} (f : GradedMap A B a) {x w y : G} (q : x + a = w) (p : w + 0 = y) (q' : x + a = y) (u : A x)
      : id p (f q u) = f q' u
      => aux f (inv zro-right *> p) q p q' u
      \where
        \lemma aux {R : Ring} {G : AbGroup} {A B : G -> LModule R} {a : G} (f : GradedMap A B a) {x w y : G} (s : w = y) (q : x + a = w) (p : w + 0 = y) (q' : x + a = y) (u : A x)
          : id p (f q u) = f q' u \elim y, s
          | _, idp => id-eval p _ *> pmap (\lam r => f r u) prop-pi

    \func comp {R : Ring} {G : AbGroup} {A B C : G -> LModule R} {a b : G} (g : GradedMap B C b) (f : GradedMap A B a) : GradedMap A C (a + b)
      => \lam {x} {y} p => g {x + a} {y} (+-assoc *> p) LinearMap.∘ f {x} {x + a} idp

    \lemma comp-eval {R : Ring} {G : AbGroup} {A B C : G -> LModule R} {a b : G} (g : GradedMap B C b) (f : GradedMap A B a)
                     {x w y : G} (p : x + (a + b) = y) (p1 : x + a = w) (p2 : w + b = y) (u : A x) : comp g f p u = g p2 (f p1 u) \elim w, p1
      | _, idp => pmap (\lam q => g q (f idp u)) (prop-pi {x + a + b = y} {+-assoc *> p} {p2})

    \lemma zero-move {R : Ring} {G : AbGroup} {A B : G -> LModule R} {a : G} (f : GradedMap A B a) {x y y' : G} (p : x + a = y) (p' : x + a = y')
                     {u : A x} (h : f p u = 0) : f p' u = 0 \elim y, y', p, p'
      | _, _, idp, idp => h

    \lemma exact {R : Ring} {G : AbGroup} {A B C : G -> LModule R} {a b : G} (f : GradedMap A B a) (g : GradedMap B C b)
                 (e : \Pi (y : G) -> AbExactAt (f (pre y a)) (g idp)) {x y z : G} (p : x + a = y) (q : y + b = z) : AbExactAt (f p) (g q)
      => aux f g e (source p) p q
      \where
        \lemma aux {R : Ring} {G : AbGroup} {A B C : G -> LModule R} {a b : G} (f : GradedMap A B a) (g : GradedMap B C b)
                   (e : \Pi (y : G) -> AbExactAt (f (pre y a)) (g idp)) {x y z : G} (s : x = y - a) (p : x + a = y) (q : y + b = z)
          : AbExactAt (f p) (g q) \elim x, z, s, q
          | _, _, idp, idp => transport (\lam p' => AbExactAt (f p') (g idp)) prop-pi (e y)

    \func image {R : Ring} {G : AbGroup} {A B : G -> LModule R} {a : G} (f : GradedMap A B a) (y : G) : SubLModule R (B y)
      => ImageLModule (f (pre y a))

    \lemma image-intro {R : Ring} {G : AbGroup} {A B : G -> LModule R} {a : G} (f : GradedMap A B a) {x y : G} (p : x + a = y) (u : A x)
      : image f y (f p u)
      => aux f (source p) p u
      \where
        \lemma aux {R : Ring} {G : AbGroup} {A B : G -> LModule R} {a : G} (f : GradedMap A B a) {x y : G} (s : x = y - a) (p : x + a = y) (u : A x)
          : image f y (f p u) \elim x, s
          | _, idp => inP (u, pmap (\lam q => f q u) prop-pi)
  }

\record DiffModule.{u} (G : AbGroup.{u}) (deg : G) \extends LGradedComplex.{u} {
  | Ix => G
  | src y => y - deg
  | tgt y => y + deg
  | d {x y : G} : x + deg = y -> LinearMap (D x) (D y)
  | d-d {x y z : G} (p : x + deg = y) (q : y + deg = z) (u : D x) : d q (d p u) = 0
  | dIn y => d (GradedMap.pre y deg)
  | dOut _ => d idp
  | dOut-dIn _ => d-d _ idp
  | dIn-*c {y} => (d (GradedMap.pre y deg)).func-*c
  | dOut-*c {y} => (d (idp {G} {y + deg})).func-*c

  \lemma cycle {x y : G} (p : x + deg = y) (u : D x) : LIsCycle y (d p u)
    => d-d p idp u

  \lemma boundary-intro {x y : G} (p : x + deg = y) (u : D x) : LIsBoundary y (d p u, cycle p u)
    => \case GradedMap.image-intro d p u \with {
      | inP (v, q) => inP (v, ext q)
    }
} \where
  \func hom.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y : DiffModule.{u} G deg R} (h : \Pi (x : G) -> LinearMap (X.D x) (Y.D x))
            (c : \Pi {x y : G} (p : x + deg = y) (u : X.D x) -> Y.d p (h x u) = h y (X.d p u)) : LComplexMap X Y \cowith
    | f => h
    | commIn _ => c _
    | commOut _ => c idp
    | f-*c {y} => (h y).func-*c

\record DiffPairing.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} (X Y Z : DiffModule.{u} G deg R) {
  | mul {x y z : G} (p : x + y = z) : BilinearMap (X.D x) (Y.D y) (Z.D z)
  | sgn : G -> R
  | sgn-sq (x : G) : sgn x * sgn x = 1
  | leibniz {x y z x' y' z' : G} (p : x + y = z) (q : z + deg = z') (r1 : x + deg = x') (q1 : x' + y = z') (r2 : y + deg = y') (q2 : x + y' = z')
            (a : X.D x) (b : Y.D y) : Z.d q (mul p a b) = mul q1 (X.d r1 a) b + sgn x *c mul q2 a (Y.d r2 b)

  \lemma sgn-twice {M : LModule R} (x : G) (m : M) : sgn x *c (sgn x *c m) = m
    => inv *c-assoc *> pmap (`*c m) (sgn-sq x) *> ide_*c

  \lemma cycle-mul {x y z : G} (p : x + y = z) {a : X.D x} {b : Y.D y} (ca : X.LIsCycle x a) (cb : Y.LIsCycle y b) : Z.LIsCycle z (mul p a b)
    => leibniz p idp idp (equation.abGroup *> pmap (`+ deg) p) idp (equation.abGroup *> pmap (`+ deg) p) a b
       *> pmap2 (\lam s t => mul _ s b + sgn x *c mul _ a t) ca cb
       *> pmap2 (\lam s t => s + sgn x *c t) (BilinearMap.zro-left (mul _)) (BilinearMap.zro-right (mul _)) *> pmap (0 +) LModule.*c_zro-right *> zro-left

  \func cyclePairing {x y z : G} (p : x + y = z) : BilinearMap (IModule (X.LIsCycle x)) (IModule (Y.LIsCycle y)) (IModule (Z.LIsCycle z))
    => BilinearMap.restrict (mul p) (cycle-mul p)

  \lemma boundary-left {x y z : G} (p : x + y = z) {a : IModule (X.LIsCycle x)} (b : IModule (Y.LIsCycle y)) (h : X.LIsBoundary x a)
    : Z.LIsBoundary z (cyclePairing p a b) \elim h
    | inP (u, e) => inP (mul (equation.abGroup *> pmap (`- deg) p) u b.1, ext (
        leibniz _ (GradedMap.pre z deg) (GradedMap.pre x deg) p idp (equation.abGroup *> p) u b.1
        *> pmap2 (\lam s t => mul p s b.1 + sgn (x - deg) *c mul _ u t) (pmap __.1 e) b.2
        *> pmap (_ + sgn (x - deg) *c __) (BilinearMap.zro-right (mul _)) *> pmap (_ +) LModule.*c_zro-right *> zro-right))

  \lemma boundary-right {x y z : G} (p : x + y = z) (a : IModule (X.LIsCycle x)) {b : IModule (Y.LIsCycle y)} (h : Y.LIsBoundary y b)
    : Z.LIsBoundary z (cyclePairing p a b) \elim h
    | inP (v, e) => inP (sgn x *c mul (equation.abGroup *> pmap (`- deg) p) a.1 v, ext (
        (Z.d _).func-*c
        *> pmap (sgn x *c) (leibniz _ (GradedMap.pre z deg) idp (equation.abGroup *> p) (GradedMap.pre y deg) p a.1 v
          *> pmap (\lam s => mul _ s v + sgn x *c mul p a.1 (Y.d _ v)) a.2
          *> pmap (`+ _) (BilinearMap.zro-left (mul _)) *> zro-left)
        *> sgn-twice x _ *> pmap (\lam t => mul p a.1 t.1) e))

  \func homologyPairing {x y z : G} (p : x + y = z) : BilinearMap (LHomology X x) (LHomology Y y) (LHomology Z z)
    => bilinearQuotient {R} {IModule (X.LIsCycle x)} {IModule (Y.LIsCycle y)} {IModule (Z.LIsCycle z)} (cyclePairing p) (boundary-left p) (boundary-right p)
} \where {
    \func Leibniz.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R}
                  (mul : \Pi {x y z : G} (p : x + y = z) -> BilinearMap (X.D x) (Y.D y) (Z.D z)) (sgn : G -> R) : \Prop
      => \Pi {x y z : G} (p : x + y = z) (q1 : x + deg + y = z + deg) (q2 : x + (y + deg) = z + deg) (a : X.D x) (b : Y.D y)
           -> Z.d idp (mul p a b) = mul q1 (X.d idp a) b + sgn x *c mul q2 a (Y.d idp b)

    \lemma leibniz-at.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R}
                      (mul : \Pi {x y z : G} (p : x + y = z) -> BilinearMap (X.D x) (Y.D y) (Z.D z)) (sgn : G -> R) (l : Leibniz mul sgn)
                      {x y z x' y' z' : G} (p : x + y = z) (q : z + deg = z') (r1 : x + deg = x') (q1 : x' + y = z') (r2 : y + deg = y') (q2 : x + y' = z')
                      (a : X.D x) (b : Y.D y) : Z.d q (mul p a b) = mul q1 (X.d r1 a) b + sgn x *c mul q2 a (Y.d r2 b) \elim x', y', z', q, r1, r2
      | _, _, _, idp, idp, idp => l p q1 q2 a b

    \lemma homology-natural.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z X' Y' Z' : DiffModule.{u} G deg R} (P : DiffPairing X Y Z) (P' : DiffPairing X' Y' Z')
                            (FX : LComplexMap X X') (FY : LComplexMap Y Y') (FZ : LComplexMap Z Z')
                            (sq : \Pi {x y z : G} (p : x + y = z) (a : X.D x) (b : Y.D y) -> FZ.f z (P.mul p a b) = P'.mul p (FX.f x a) (FY.f y b))
                            {x y z : G} (p : x + y = z) (a : LHomology X x) (b : LHomology Y y)
      : LComplexMap.lhomology FZ z (P.homologyPairing p a b) = P'.homologyPairing p (LComplexMap.lhomology FX x a) (LComplexMap.lhomology FY y b) \elim a, b
      | in~ a, in~ b => pmap in~ (ext (sq p a.1 b.1))
  }

