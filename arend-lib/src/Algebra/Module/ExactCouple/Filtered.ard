\import Algebra.Group
\import Algebra.Group.Exact
\import Algebra.Group.Product
\import Algebra.Meta
\import Algebra.Module
\import Algebra.Module.Differential
\import Algebra.Module.Differential.Filtered
\import Algebra.Module.Differential.LongExact (DiffSES, exact-congr, exact-post)
\import Algebra.Module.ExactCouple
\import Algebra.Module.ExactCouple.Cumulative
\import Algebra.Module.GradedComplex
\import Algebra.Module.LinearMap
\import Algebra.Monoid
\import Algebra.Monoid.Product
\import Algebra.Pointed
\import Algebra.Ring
\import Arith.Int
\import Logic
\import Logic.Meta
\import Order.LinearOrder
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\import Relation.Equivalence
\open AddMonoid (*n)

\func Bi (G : AbGroup) : AbGroup => ProductAbGroup IntRing G
  \where
    \lemma ndi {G : AbGroup} (n : Nat) : (*n) {Bi G} n (neg 1, 0) = (neg n, 0)
      => ext (ProductAddMonoid.proj1_*n n (neg 1, 0) *> IntRing.*n_neg, ProductAddMonoid.proj2_*n n (neg 1, 0) *> AddMonoid.*n_zro)

\func filteredCouple.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X : DiffModule.{u} G deg R} (FX : FilteredDiff X)
  : ExactCouple.{u} R (Bi G) (neg 1, 0) (0, 0) (1, deg)
  => ExactCouple.make couple (\lam p q => exact-ij p q, \lam p q => exact-jk p q, \lam p q => exact-ki p q)
  \where {
    \func tail(x : Bi G) => FX.ses {x.1} {x.1 + 1} {inf} (linarith : x.1 <= x.1 + 1) ()

    \func couple : Couple R (Bi G) (neg 1, 0) (0, 0) (1, deg) \cowith
      | D x => LHomology (FX.Win x.1 inf) x.2
      | E x => LHomology (FX.Win x.1 (fin (x.1 + 1))) x.2
      | i {x} {z} q => FX.whom {x.1} {z.1} {inf} {inf} (le-i q) () (deg-i q)
      | j {x} {z} q => FX.whom {x.1} {z.1} {inf} {fin (z.1 + 1)} (le-j q) () (deg-j q)
      | k {x} {z} q => LinearMap.compose {R} {LHomology (FX.Win x.1 (fin (x.1 + 1))) x.2} {LHomology (FX.Win (x.1 + 1) inf) z.2} {LHomology (FX.Win z.1 inf) z.2}
                                         (FX.wh {x.1 + 1} {z.1} {inf} {inf} (le-k q) () z.2) (FX.conn {x.1} {x.1 + 1} {inf} (linarith : x.1 <= x.1 + 1) () (deg-k q))

    \lemma le-i {x z : Bi G} (q : (+) {Bi G} x (neg 1, 0) = z) : z.1 <= x.1 => rewriteI (pmap __.1 q) (linarith : x.1 + neg 1 <= x.1)

    \lemma deg-i {x z : Bi G} (q : (+) {Bi G} x (neg 1, 0) = z) : x.2 = z.2 => inv zro-right *> pmap __.2 q

    \lemma le-j {x z : Bi G} (q : (+) {Bi G} x (0, 0) = z) : z.1 <= x.1 => rewriteI (pmap __.1 q) (linarith : x.1 + 0 <= x.1)

    \lemma deg-j {x z : Bi G} (q : (+) {Bi G} x (0, 0) = z) : x.2 = z.2 => inv zro-right *> pmap __.2 q

    \lemma le-k {x z : Bi G} (q : (+) {Bi G} x (1, deg) = z) : z.1 <= x.1 + 1 => rewriteI (pmap __.1 q) <=-refl

    \lemma deg-k {x z : Bi G} (q : (+) {Bi G} x (1, deg) = z) : x.2 + deg = z.2 => pmap __.2 q

    \lemma ij-gen {a a1 a2 : Int} {u v w : G} (h1 : a1 <= a) (h2 : a2 <= a1) (s1 : a1 + 1 = a) (s2 : a2 = a1) (e1 : u = v) (e2 : v = w)
      : AbExactAt (FX.whom {a} {a1} {inf} {inf} h1 () e1) (FX.whom {a1} {a2} {inf} {fin (a2 + 1)} h2 () e2)
      \elim a, a2, v, w, s1, s2, e1, e2
      | _, _, _, _, idp, idp, idp, idp => transport (\lam h => AbExactAt (FX.wh h1 () u) (FX.wh {a1} {a1} {inf} {fin (a1 + 1)} h () u)) prop-pi
                                                    (DiffSES.exact-middle {FX.ses {a1} {a1 + 1} {inf} h1 ()} u)

    \lemma jk-gen {a a1 a2 : Int} {u v w : G} (h1 : a1 <= a) (h2 : a2 <= a1 + 1) (s1 : a = a1) (s2 : a1 + 1 = a2) (e1 : u = v) (e2 : v + deg = w)
      : AbExactAt (FX.whom {a} {a1} {inf} {fin (a1 + 1)} h1 () e1)
                  (LinearMap.compose {R} {LHomology (FX.Win a1 (fin (a1 + 1))) v} {LHomology (FX.Win (a1 + 1) inf) w} {LHomology (FX.Win a2 inf) w}
                                     (FX.wh {a1 + 1} {a2} {inf} {inf} h2 () w) (FX.conn {a1} {a1 + 1} {inf} (linarith : a1 <= a1 + 1) () e2))
      \elim a, a2, v, w, s1, s2, e1, e2
      | _, _, _, _, idp, idp, idp, idp =>
        \have s : a1 <= a1 + 1 => linarith
        \in exact-post {_} {_} {_} {_} {FX.wh {a1} {a1} {inf} {fin (a1 + 1)} h1 () u} {FX.conn {a1} {a1 + 1} {inf} s () idp}
                       {LinearMap.compose {R} {LHomology (FX.Win a1 (fin (a1 + 1))) u} {LHomology (FX.Win (a1 + 1) inf) (u + deg)}
                                          {LHomology (FX.Win (a1 + 1) inf) (u + deg)} (FX.wh h2 () (u + deg)) (FX.conn {a1} {a1 + 1} {inf} s () idp)}
                       {FX.wh h2 () (u + deg)} (FX.wh-inj h2 () (u + deg)) (\lam _ => idp)
            (transport (\lam h => AbExactAt (FX.wh {a1} {a1} {inf} {fin (a1 + 1)} h () u) (FX.conn {a1} {a1 + 1} {inf} s () idp)) prop-pi
                       (DiffSES.exact-right {FX.ses {a1} {a1 + 1} {inf} s ()} u))

    \lemma ki-gen {a a1 a2 : Int} {u v w : G} (h1 : a1 <= a + 1) (h2 : a2 <= a1) (s1 : a + 1 = a1) (s2 : a2 = a) (e1 : u + deg = v) (e2 : v = w)
      : AbExactAt (LinearMap.compose {R} {LHomology (FX.Win a (fin (a + 1))) u} {LHomology (FX.Win (a + 1) inf) v} {LHomology (FX.Win a1 inf) v}
                                     (FX.wh {a + 1} {a1} {inf} {inf} h1 () v) (FX.conn {a} {a + 1} {inf} (linarith : a <= a + 1) () e1))
                  (FX.whom {a1} {a2} {inf} {inf} h2 () e2)
      \elim a1, a2, v, w, s1, s2, e1, e2
      | _, _, _, _, idp, idp, idp, idp =>
        \have s : a <= a + 1 => linarith
        \in exact-congr {_} {_} {_} {FX.conn {a} {a + 1} {inf} s () idp}
              {LinearMap.compose {R} {LHomology (FX.Win a (fin (a + 1))) u} {LHomology (FX.Win (a + 1) inf) (u + deg)} {LHomology (FX.Win (a + 1) inf) (u + deg)}
                                 (FX.wh h1 () (u + deg)) (FX.conn {a} {a + 1} {inf} s () idp)}
              {FX.wh {a + 1} {a} {inf} {inf} s () (u + deg)} {FX.wh h2 () (u + deg)}
              (\lam _ => inv (FX.wh-id h1 () _)) (\lam t => pmap (\lam h => FX.wh {a + 1} {a} {inf} {inf} h () (u + deg) t) prop-pi)
              (DiffSES.exact-left {FX.ses {a} {a + 1} {inf} s ()} u)

    \lemma exact-ij {x y z : Bi G} (p : (+) {Bi G} x (neg 1, 0) = y) (q : (+) {Bi G} y (0, 0) = z) : AbExactAt (Couple.i {couple} p) (Couple.j {couple} q)
      => ij-gen (le-i p) (le-j q) (pmap (\lam (t : Int) => t + 1) (inv (pmap __.1 p)) *> (linarith : x.1 + neg 1 + 1 = x.1)) (inv (pmap __.1 q) *> zro-right) (deg-i p) (deg-j q)

    \lemma exact-jk {x y z : Bi G} (p : (+) {Bi G} x (0, 0) = y) (q : (+) {Bi G} y (1, deg) = z) : AbExactAt (Couple.j {couple} p) (Couple.k {couple} q)
      => jk-gen (le-j p) (le-k q) (inv zro-right *> pmap __.1 p) (pmap __.1 q) (deg-j p) (deg-k q)

    \lemma exact-ki {x y z : Bi G} (p : (+) {Bi G} x (1, deg) = y) (q : (+) {Bi G} y (neg 1, 0) = z) : AbExactAt (Couple.k {couple} p) (Couple.i {couple} q)
      => ki-gen (le-k p) (le-i q) (pmap __.1 p)
                (inv (pmap __.1 q) *> pmap (\lam (t : Int) => t + neg 1) (inv (pmap __.1 p)) *> (linarith : x.1 + 1 + neg 1 = x.1)) (deg-k p) (deg-i q)
  }

\lemma iter-whom.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X : DiffModule.{u} G deg R} (FX : FilteredDiff X) (n : Nat) {x y : Bi G}
                 (p : (+) {Bi G} x ((*n) {Bi G} n (neg 1, 0)) = y) {a : Int} {u : G} (h : x.1 <= a) (e : u = x.2) (h' : y.1 <= a) (e' : u = y.2)
                 (w : LHomology (FX.Win a inf) u)
  : iter (filteredCouple FX) n p (FX.whom {a} {x.1} {inf} {inf} h () e w) = FX.whom {a} {y.1} {inf} {inf} h' () e' w \elim n
  | 0 => aux (inv (zro-right {Bi G}) *> p) p h e h' e' w
  | suc n =>
    \let | h0 : ((+) {Bi G} x ((*n) {Bi G} n (neg 1, 0))).1 <= a => transportInv (`<= a) (pmap (x.1 +) (ProductAddMonoid.proj1_*n n (neg 1, 0) *> IntRing.*n_neg))
                                                                                    (<=-transitive (linarith : x.1 + neg n <= x.1) h)
         | e0 : u = ((+) {Bi G} x ((*n) {Bi G} n (neg 1, 0))).2
             => e *> inv zro-right *> pmap (x.2 +) (inv (ProductAddMonoid.proj2_*n n (neg 1, 0) *> AddMonoid.*n_zro))
    \in pmap (FX.whom _ () _) (iter-whom FX n idp h e h0 e0 w)
        *> FX.whom-comp {a} {_} {y.1} {inf} {inf} {inf} h0 () (filteredCouple.le-i (+-assoc {Bi G} *> p)) () h' () e0 (filteredCouple.deg-i (+-assoc {Bi G} *> p)) w
        *> FX.whom-unique h' h' () () _ e' w
  \where
    \lemma aux {x y : Bi G} (s : x = y) (p : (+) {Bi G} x (0, 0) = y) {a : Int} {u : G} (h : x.1 <= a) (e : u = x.2) (h' : y.1 <= a) (e' : u = y.2)
               (w : LHomology (FX.Win a inf) u)
      : GradedMap.id {R} {Bi G} {Couple.D {filteredCouple FX}} p (FX.whom {a} {x.1} {inf} {inf} h () e w) = FX.whom {a} {y.1} {inf} {inf} h' () e' w \elim y, s
      | _, idp => GradedMap.id-eval {R} {Bi G} {Couple.D {filteredCouple FX}} p _ *> FX.whom-unique h h' () () e e' w
