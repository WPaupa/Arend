                                 (sm-a.{u} {G} {m} p) (sm-b.{u} {G} p) (sm-c.{u} {G} {deg} {m} p) (bot-le.{u} {G} {m} x) () (le-mtop.{u} {G} {deg} {m} y) () (bot-le.{u} {G} {m} z) ()
