                                       (sd-a.{u} {G} {deg} {m} p') (sd-b.{u} {G} {deg} {m} p') () (sd-a.{u} {G} {deg} {m} p) (sd-b.{u} {G} {deg} {m} p) () <=-refl <=-refl (filteredCouple.le-i.{u} q) () (filteredCouple.le-i.{u} r) (far-le.{u} {G} {deg} {m} r)
