\import Algebra.Group
\import Algebra.Group.Product
\import Algebra.Meta
\import Algebra.Module
\import Algebra.Module.Differential
\import Algebra.Module.Differential.Filtered
\import Algebra.Module.Differential.Filtered.Product
\import Algebra.Module.ExactCouple
\import Algebra.Module.ExactCouple.Convergence
\import Algebra.Module.ExactCouple.Cumulative
\import Algebra.Module.ExactCouple.Filtered
\import Algebra.Module.ExactCouple.Filtered.Window
\import Algebra.Module.ExactCouple.Product (LayerPairing, WindowLeibniz, WindowPairing)
\import Algebra.Module.ExactCouple.Window
\import Algebra.Module.GradedComplex
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Ring
\import Arith.Int
\import Logic
\import Order.LinearOrder
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\open AddMonoid (*n)

\func filteredLayer.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing X Y Z}
                        {FX : FilteredDiff X} {FY : FilteredDiff Y} {FZ : FilteredDiff Z} (FP : FilteredPairing P FX FY FZ)
  : LayerPairing (filteredCouple FX) (filteredCouple FY) (filteredCouple FZ) \cowith
  | mul p => FP.hpair (filteredLeibniz.lz p) (filteredLeibniz.gr-left p) (filteredLeibniz.gr-right p) (filteredLeibniz.deg2 p)

\func filteredLeibniz.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing X Y Z}
                          {FX : FilteredDiff X} {FY : FilteredDiff Y} {FZ : FilteredDiff Z} (FP : FilteredPairing P FX FY FZ) (n : Nat)
  : WindowLeibniz \cowith
  | LayerPairing => filteredLayer FP
  | n => n
  | AX => filteredWindow FX n
  | AY => filteredWindow FY n
  | AZ => filteredWindow FZ n
  | sgn x => P.sgn x.2
  | sgn-sq x => P.sgn-sq x.2
  | wmul p => FP.hpair (lz p) (top-left p) (top-right p) (deg2 p)
  | rho-wmul {x} {y} {z} p s t => FilteredPairing.hpair-whom FP {x.1} {y.1} {z.1} {x.1} {y.1} {z.1} {fin (top x)} {fin (top y)} {fin (top z)}
                                    {fin (x.1 + 1)} {fin (y.1 + 1)} {fin (z.1 + 1)} (lz p) (top-left p) (top-right p) (lz p) (gr-left p) (gr-right p)
                                    <=-refl (lo-top x) <=-refl (lo-top y) <=-refl (lo-top z) (deg2 p) (deg2 p) idp idp idp s t
  | dwmul p => FP.hpair (dw-a p) () (dw-b p) (dw-deg p)
  | rho-dwmul {w} {x} {y} {z} p r p' t s => FilteredPairing.hpair-whom FP {w.1} {y.1} {z.1} {x.1} {y.1} {z.1} {inf} {fin (top y)} {fin (top z)}
                                              {fin (x.1 + 1)} {fin (y.1 + 1)} {fin (z.1 + 1)} (dw-a p) () (dw-b p) (lz p') (gr-left p') (gr-right p')
                                              (filteredCouple.le-j r) () <=-refl (lo-top y) <=-refl (lo-top z) (dw-deg p) (deg2 p')
                                              (filteredCouple.deg-j r) idp idp t s
  | wdmul p => FP.hpair (wd-a p) (wd-b p) () (wd-deg p)
  | rho-wdmul {x} {w} {y} {z} p r p' s t => FilteredPairing.hpair-whom FP {x.1} {w.1} {z.1} {x.1} {y.1} {z.1} {fin (top x)} {inf} {fin (top z)}
                                              {fin (x.1 + 1)} {fin (y.1 + 1)} {fin (z.1 + 1)} (wd-a p) (wd-b p) () (lz p') (gr-left p') (gr-right p')
                                              <=-refl (lo-top x) (filteredCouple.le-j r) () <=-refl (lo-top z) (wd-deg p) (deg2 p')
                                              idp (filteredCouple.deg-j r) idp s t
  | leibniz-window {x} {y} {z} {z'} p r q q' s t =>
    FilteredPairing.conn-leibniz FP {x.1} {top x} {y.1} {top y} {z.1} {top z} {z'.1} {inf} {inf} {inf} {fin (top z')}
                                 (lz p) (top-left p) (top-right p) (le-top x) () (le-top y) () (le-top z) ()
                                 (dw-a q) () (dw-b q) (wd-a q') (wd-b q') () (filteredCouple.le-j r) ()
                                 (deg2 p) (deg-top x) (deg-top y) (deg-top z) (filteredCouple.deg-j r) (dw-deg q) (wd-deg q') idp s t
  \where {
    \func top (y : Bi G) : Int => filteredWindow.top {G} {deg} {n} y

    \lemma top-eq (y : Bi G) : top y = y.1 + 1 - neg n
      => filteredWindow.top-eq {G} {deg} {n} y

    \lemma le-top (y : Bi G) : y.1 <= top y
      => filteredWindow.le-top {G} {deg} {n} y

    \lemma lo-top (y : Bi G) : y.1 + 1 <= top y
      => filteredWindow.lo-top {G} {deg} {n} y

    \lemma deg-top (y : Bi G) : y.2 + deg = (filteredWindow.jx {G} {deg} {n} y).2
      => filteredWindow.deg-top {G} {deg} {n} y

    \lemma lz {x y z : Bi G} (p : (+) {Bi G} x y = z) : z.1 <= x.1 + y.1 \elim z, p
      | _, idp => <=-refl

    \lemma deg2 {x y z : Bi G} (p : (+) {Bi G} x y = z) : x.2 + y.2 = z.2
      => pmap __.2 p

    \lemma gr-left {x y z : Bi G} (p : (+) {Bi G} x y = z) : z.1 + 1 <= x.1 + 1 + y.1 \elim z, p
      | _, idp => (linarith : x.1 + y.1 + 1 <= x.1 + 1 + y.1)

    \lemma gr-right {x y z : Bi G} (p : (+) {Bi G} x y = z) : z.1 + 1 <= y.1 + 1 + x.1 \elim z, p
      | _, idp => (linarith : x.1 + y.1 + 1 <= y.1 + 1 + x.1)

    \lemma top-left {x y z : Bi G} (p : (+) {Bi G} x y = z) : top z <= top x + y.1 \elim z, p
      | _, idp => rewrite (top-eq ((+) {Bi G} x y), top-eq x) (linarith : x.1 + y.1 + 1 - neg n <= x.1 + 1 - neg n + y.1)

    \lemma top-right {x y z : Bi G} (p : (+) {Bi G} x y = z) : top z <= top y + x.1 \elim z, p
      | _, idp => rewrite (top-eq ((+) {Bi G} x y), top-eq y) (linarith : x.1 + y.1 + 1 - neg n <= y.1 + 1 - neg n + x.1)

    \lemma dw-a {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : z.1 <= w.1 + y.1 \elim z, p
      | _, idp => (linarith : w.1 + 0 + y.1 <= w.1 + y.1)

    \lemma dw-b {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : top z <= top y + w.1 \elim z, p
      | _, idp => rewrite (top-eq ((+) {Bi G} ((+) {Bi G} w (0, 0)) y), top-eq y) (linarith : w.1 + 0 + y.1 + 1 - neg n <= y.1 + 1 - neg n + w.1)

    \lemma dw-deg {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : w.2 + y.2 = z.2
      => inv (pmap (`+ y.2) zro-right) *> pmap __.2 p

    \lemma wd-a {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : z.1 <= x.1 + w.1 \elim z, p
      | _, idp => (linarith : x.1 + (w.1 + 0) <= x.1 + w.1)

    \lemma wd-b {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : top z <= top x + w.1 \elim z, p
      | _, idp => rewrite (top-eq ((+) {Bi G} x ((+) {Bi G} w (0, 0))), top-eq x) (linarith : x.1 + (w.1 + 0) + 1 - neg n <= x.1 + 1 - neg n + w.1)

    \lemma wd-deg {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : x.2 + w.2 = z.2
      => inv (pmap (x.2 +) zro-right) *> pmap __.2 p
  }

\func filteredPairing.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing X Y Z}
                          {FX : FilteredDiff X} {FY : FilteredDiff Y} {FZ : FilteredDiff Z} (FP : FilteredPairing P FX FY FZ) (m : Nat)
  : WindowPairing \cowith
  | LayerPairing => filteredLayer FP
  | n => suc m
  | sgn => WindowLeibniz.sgn {filteredLeibniz FP (suc m)}
  | sgn-sq => WindowLeibniz.sgn-sq {filteredLeibniz FP (suc m)}
  | MX => filteredFrame FX m
  | MY => filteredFrame FY m
  | MZ => filteredFrame FZ m
  | wmul => WindowLeibniz.wmul {filteredLeibniz FP (suc m)}
  | rho-wmul => WindowLeibniz.rho-wmul {filteredLeibniz FP (suc m)}
  | dwmul => WindowLeibniz.dwmul {filteredLeibniz FP (suc m)}
  | rho-dwmul => WindowLeibniz.rho-dwmul {filteredLeibniz FP (suc m)}
  | wdmul => WindowLeibniz.wdmul {filteredLeibniz FP (suc m)}
  | rho-wdmul => WindowLeibniz.rho-wdmul {filteredLeibniz FP (suc m)}
  | leibniz-window => WindowLeibniz.leibniz-window {filteredLeibniz FP (suc m)}
  | smul p => FP.hpair (sm-a p) (sm-b p) (sm-c p) (sm-deg p)
  | dmmul p => FP.hpair (dm-a p) () (dm-b p) (dm-deg p)
  | mrho-dmmul {w} {x} {y} {z} p r _ t u => FilteredPairing.hpair-whom FP {w.1} {y.1} {z.1} {x.1} {y.1} {z.1} {inf} {fin (mtop y)} {fin (mtop z)}
                                               {fin (x.1 + 1)} {fin (y.1 + 1)} {fin (z.1 + 1)} (dm-a p) () (dm-b p) _ _ _
                                               (filteredCouple.le-j r) () <=-refl (lo-mtop y) <=-refl (lo-mtop z) (dm-deg p) _ (filteredCouple.deg-j r) idp idp t u
  | sdmul p => FP.hpair (sd-a p) (sd-b p) () (sd-deg p)
  | sdmul-i {x} {w} {w'} {z} {z'} p p' q r u t =>
    inv (pmap (\lam v => FP.hpair (sd-a p) (sd-b p) () (sd-deg p) v (Couple.i {filteredCouple FY} q t)) (FX.whom-id {bot x} {fin (mj x).1} <=-refl <=-refl idp u))
    *> inv (FilteredPairing.hpair-whom FP {bot x} {w.1} {z'.1} {bot x} {w'.1} {z.1} {fin (mj x).1} {inf} {fin (mtop z')} {fin (mj x).1} {inf} {fin (mtop z)}
                                       (sd-a p') (sd-b p') () (sd-a p) (sd-b p) () <=-refl <=-refl (filteredCouple.le-i q) () (filteredCouple.le-i r) (far-le r)
                                       (sd-deg p') (sd-deg p) idp (filteredCouple.deg-i q) (filteredCouple.deg-i r) u t)
  | leibniz-left {x} {y} {z} p q q' u v =>
    FilteredPairing.conn-leibniz FP {bot x} {(mj x).1} {y.1} {mtop y} {bot z} {(mj z).1} {z.1} {inf} {inf} {inf} {fin (mtop z)}
                                 (sm-a p) (sm-b p) (sm-c p) (bot-le x) () (le-mtop y) () (bot-le z) ()
                                 (dm-a {G} {mj x} q) () (dm-b {G} {deg} {m} {mj x} q) (sd-a {G} {deg} {m} {x} {mx y} q') (sd-b {G} {deg} {m} {x} {mx y} q') ()
                                 (filteredCouple.le-j (GradedMap.pre {Bi G} z (0, 0))) ()
                                 (sm-deg p) (deg-bot x) (deg-mtop y) (deg-bot z) (filteredCouple.deg-j (GradedMap.pre {Bi G} z (0, 0)))
                                 (dm-deg {G} {mj x} q) (sd-deg {G} {deg} {m} {x} {mx y} q') (pmap P.sgn (equation.abGroup : x.2 - 0 - deg = x.2 - (deg + 0 + 0))) u v
  | msmul p => FP.hpair (ms-a p) (ms-b p) (ms-c p) (ms-deg p)
  | mdmul p => FP.hpair (md-a p) (md-b p) () (md-deg p)
  | mrho-mdmul {x} {w} {y} {z} p r _ u t => FilteredPairing.hpair-whom FP {x.1} {w.1} {z.1} {x.1} {y.1} {z.1} {fin (mtop x)} {inf} {fin (mtop z)}
                                               {fin (x.1 + 1)} {fin (y.1 + 1)} {fin (z.1 + 1)} (md-a p) (md-b p) () _ _ _
                                               <=-refl (lo-mtop x) (filteredCouple.le-j r) () <=-refl (lo-mtop z) (md-deg p) _ idp (filteredCouple.deg-j r) idp u t
  | dsmul p => FP.hpair (ds-a p) () (ds-b p) (ds-deg p)
  | dsmul-i {w} {w'} {y} {z} {z'} p p' q r t u =>
    inv (pmap (\lam v => FP.hpair (ds-a p) () (ds-b p) (ds-deg p) (Couple.i {filteredCouple FX} q t) v) (FY.whom-id {bot y} {fin (mj y).1} <=-refl <=-refl idp u))
    *> inv (FilteredPairing.hpair-whom FP {w.1} {bot y} {z'.1} {w'.1} {bot y} {z.1} {inf} {fin (mj y).1} {fin (mtop z')} {inf} {fin (mj y).1} {fin (mtop z)}
                                       (ds-a p') () (ds-b p') (ds-a p) () (ds-b p) (filteredCouple.le-i q) () <=-refl <=-refl (filteredCouple.le-i r) (far-le r)
                                       (ds-deg p') (ds-deg p) (filteredCouple.deg-i q) idp (filteredCouple.deg-i r) t u)
  | leibniz-right {x} {y} {z} p q q' v u =>
    FilteredPairing.conn-leibniz FP {x.1} {mtop x} {bot y} {(mj y).1} {bot z} {(mj z).1} {z.1} {inf} {inf} {inf} {fin (mtop z)}
                                 (ms-a p) (ms-b p) (ms-c p) (le-mtop x) () (bot-le y) () (bot-le z) ()
                                 (ds-a {G} {deg} {m} {mx x} q) () (ds-b {G} {deg} {m} {mx x} q) (md-a {G} {x} {mj y} q') (md-b {G} {deg} {m} {x} {mj y} q') ()
                                 (filteredCouple.le-j (GradedMap.pre {Bi G} z (0, 0))) ()
                                 (ms-deg p) (deg-mtop x) (deg-bot y) (deg-bot z) (filteredCouple.deg-j (GradedMap.pre {Bi G} z (0, 0)))
                                 (ds-deg {G} {deg} {m} {mx x} q) (md-deg {G} {x} {mj y} q') idp v u
  \where {
    \func mj (y : Bi G) : Bi G => filteredWindow.mj {G} y

    \func bot (y : Bi G) : Int => filteredWindow.bot {G} {suc m} y

    \func mtop (y : Bi G) : Int => filteredFrame.mtop {G} {deg} {m} y

    \func mx (y : Bi G) : Bi G => filteredFrame.mx {G} {deg} {m} y

    \lemma bot-le (y : Bi G) : bot y <= (mj y).1
      => filteredWindow.bot-le {G} {suc m} y

    \lemma deg-bot (y : Bi G) : (mj y).2 - deg + deg = (mj y).2
      => filteredWindow.deg-bot {G} {deg} y

    \lemma le-mtop (y : Bi G) : y.1 <= mtop y
      => filteredFrame.le-mtop {G} {deg} {m} y

    \lemma lo-mtop (y : Bi G) : y.1 + 1 <= mtop y
      => filteredFrame.lo-mtop {G} {deg} {m} y

    \lemma deg-mtop (y : Bi G) : y.2 + deg = (filteredFrame.mx {G} {deg} {m} y).2
      => filteredFrame.deg-mtop {G} {deg} {m} y

    \lemma far-le {x y : Bi G} (p : (+) {Bi G} x (neg 1, 0) = y) : mtop y <= mtop x
      => filteredFrame.far-le {G} {deg} {m} p

    \lemma mj1 (y : Bi G) : (mj y).1 = y.1
      => (linarith : y.1 - 0 = y.1)

    \lemma botN (y : Bi G) : bot y = y.1 + neg (suc m)
      => pmap (\lam (z : Bi G) => (mj y).1 + z.1) (Bi.ndi (suc m)) *> pmap (`+ neg (suc m)) (mj1 y)

    \lemma mtopN (y : Bi G) : mtop y = y.1 + 1 - neg (suc m) + neg 1
      => filteredFrame.mtop-eq {G} {deg} {m} y

    \lemma idx1 {a b z : Bi G} (p : (+) {Bi G} ((+) {Bi G} a b) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : z.1 = a.1 + b.1 + neg (suc m)
      => (linarith : z.1 = z.1 + 1 + neg 1) *> inv (pmap __.1 p) *> pmap (\lam (t : Bi G) => a.1 + b.1 + t.1) (Bi.ndi (suc m))

    \lemma idx2 {a b z : Bi G} (p : (+) {Bi G} ((+) {Bi G} a b) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : a.2 + b.2 = z.2 + deg
      => inv zro-right *> inv (pmap (\lam (t : Bi G) => a.2 + b.2 + t.2) (Bi.ndi (suc m))) *> pmap __.2 p *> zro-right

    \lemma sm-a {x y z : Bi G} (p : (+) {Bi G} x y = z) : bot z <= bot x + y.1 \elim z, p
      | _, idp => rewrite (botN ((+) {Bi G} x y), botN x) (linarith : x.1 + y.1 + neg (suc m) <= x.1 + neg (suc m) + y.1)

    \lemma sm-b {x y z : Bi G} (p : (+) {Bi G} x y = z) : (mj z).1 <= (mj x).1 + y.1 \elim z, p
      | _, idp => rewrite (mj1 ((+) {Bi G} x y), mj1 x) (linarith : x.1 + y.1 <= x.1 + y.1)

    \lemma sm-c {x y z : Bi G} (p : (+) {Bi G} x y = z) : (mj z).1 <= mtop y + bot x \elim z, p
      | _, idp => rewrite (mj1 ((+) {Bi G} x y), mtopN y, botN x) (linarith : x.1 + y.1 <= y.1 + 1 - neg (suc m) + neg 1 + (x.1 + neg (suc m)))

    \lemma sm-deg {x y z : Bi G} (p : (+) {Bi G} x y = z) : (mj x).2 - deg + y.2 = (mj z).2 - deg \elim z, p
      | _, idp => (equation.abGroup : x.2 - 0 - deg + y.2 = x.2 + y.2 - 0 - deg)

    \lemma dm-a {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : z.1 <= w.1 + y.1 \elim z, p
      | _, idp => (linarith : w.1 + 0 + y.1 <= w.1 + y.1)

    \lemma dm-b {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : mtop z <= mtop y + w.1 \elim z, p
      | _, idp => rewrite (mtopN ((+) {Bi G} ((+) {Bi G} w (0, 0)) y), mtopN y)
                    (linarith : w.1 + 0 + y.1 + 1 - neg (suc m) + neg 1 <= y.1 + 1 - neg (suc m) + neg 1 + w.1)

    \lemma dm-deg {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : w.2 + y.2 = z.2
      => inv (pmap (`+ y.2) zro-right) *> pmap __.2 p

    \lemma sd-a {x w z : Bi G} (p : (+) {Bi G} ((+) {Bi G} x w) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : z.1 <= bot x + w.1
      => rewrite (idx1 p, botN x) (linarith : x.1 + w.1 + neg (suc m) <= x.1 + neg (suc m) + w.1)

    \lemma sd-b {x w z : Bi G} (p : (+) {Bi G} ((+) {Bi G} x w) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : mtop z <= (mj x).1 + w.1
      => rewrite (mtopN z, idx1 p, mj1 x) (linarith : x.1 + w.1 + neg (suc m) + 1 - neg (suc m) + neg 1 <= x.1 + w.1)

    \lemma sd-deg {x w z : Bi G} (p : (+) {Bi G} ((+) {Bi G} x w) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : (mj x).2 - deg + w.2 = z.2
      => (equation.abGroup : x.2 - 0 - deg + w.2 = x.2 + w.2 - deg) *> pmap (`- deg) (idx2 p) *> (equation.abGroup : z.2 + deg - deg = z.2)

    \lemma ms-a {x y z : Bi G} (p : (+) {Bi G} x y = z) : bot z <= x.1 + bot y \elim z, p
      | _, idp => rewrite (botN ((+) {Bi G} x y), botN y) (linarith : x.1 + y.1 + neg (suc m) <= x.1 + (y.1 + neg (suc m)))

    \lemma ms-b {x y z : Bi G} (p : (+) {Bi G} x y = z) : (mj z).1 <= mtop x + bot y \elim z, p
      | _, idp => rewrite (mj1 ((+) {Bi G} x y), mtopN x, botN y) (linarith : x.1 + y.1 <= x.1 + 1 - neg (suc m) + neg 1 + (y.1 + neg (suc m)))

    \lemma ms-c {x y z : Bi G} (p : (+) {Bi G} x y = z) : (mj z).1 <= (mj y).1 + x.1 \elim z, p
      | _, idp => rewrite (mj1 ((+) {Bi G} x y), mj1 y) (linarith : x.1 + y.1 <= y.1 + x.1)

    \lemma ms-deg {x y z : Bi G} (p : (+) {Bi G} x y = z) : x.2 + ((mj y).2 - deg) = (mj z).2 - deg \elim z, p
      | _, idp => (equation.abGroup : x.2 + (y.2 - 0 - deg) = x.2 + y.2 - 0 - deg)

    \lemma md-a {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : z.1 <= x.1 + w.1 \elim z, p
      | _, idp => (linarith : x.1 + (w.1 + 0) <= x.1 + w.1)

    \lemma md-b {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : mtop z <= mtop x + w.1 \elim z, p
      | _, idp => rewrite (mtopN ((+) {Bi G} x ((+) {Bi G} w (0, 0))), mtopN x)
                    (linarith : x.1 + (w.1 + 0) + 1 - neg (suc m) + neg 1 <= x.1 + 1 - neg (suc m) + neg 1 + w.1)

    \lemma md-deg {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : x.2 + w.2 = z.2
      => inv (pmap (x.2 +) zro-right) *> pmap __.2 p

    \lemma ds-a {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w y) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : z.1 <= w.1 + bot y
      => rewrite (idx1 p, botN y) (linarith : w.1 + y.1 + neg (suc m) <= w.1 + (y.1 + neg (suc m)))

    \lemma ds-b {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w y) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : mtop z <= (mj y).1 + w.1
      => rewrite (mtopN z, idx1 p, mj1 y) (linarith : w.1 + y.1 + neg (suc m) + 1 - neg (suc m) + neg 1 <= y.1 + w.1)

    \lemma ds-deg {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w y) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : w.2 + ((mj y).2 - deg) = z.2
      => (equation.abGroup : w.2 + (y.2 - 0 - deg) = w.2 + y.2 - deg) *> pmap (`- deg) (idx2 p) *> (equation.abGroup : z.2 + deg - deg = z.2)
  }
