                                 (filteredCouple.le-j.{u} {G} {(-) {Bi G} z (0, 0)} {z} (GradedMap.pre {Bi G} z (0, 0))) ()
                                 (sm-deg.{u} {G} {deg} p) (deg-bot.{u} {G} {deg} x) (deg-mtop.{u} {G} {deg} {m} y) (deg-bot.{u} {G} {deg} z) (filteredCouple.deg-j.{u} {G} {(-) {Bi G} z (0, 0)} {z} (GradedMap.pre {Bi G} z (0, 0)))
