                 (q' : (+) {Bi G} x ((+) {Bi G} ((-) {Bi G} ((+) {Bi G} y (1, deg)) ((*n) {Bi G} (suc m) (neg 1, 0))) (0, 0)) = z') (s : WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {X} FX m} x) (t : WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y)
