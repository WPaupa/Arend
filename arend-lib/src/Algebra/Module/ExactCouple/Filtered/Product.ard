\import Algebra.Group
\import Algebra.Group.Product
\import Algebra.Meta
\import Algebra.Module
\import Algebra.Module.BilinearMap
\import Algebra.Module.Differential
\import Algebra.Module.Differential.Filtered
\import Algebra.Module.Differential.Filtered.Product
\import Algebra.Module.ExactCouple
\import Algebra.Module.ExactCouple.Convergence
\import Algebra.Module.ExactCouple.Cumulative
\import Algebra.Module.ExactCouple.Filtered
\import Algebra.Module.ExactCouple.Filtered.Window
\import Algebra.Module.ExactCouple.Product (LayerPairing, WindowLeibniz, WindowPairing)
\import Algebra.Module.ExactCouple.Window
\import Algebra.Module.GradedComplex
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Ring
\import Arith.Int
\import Logic
\import Order.LinearOrder
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\open AddMonoid (*n)

\func filteredLayer.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing X Y Z}
                        {FX : FilteredDiff X} {FY : FilteredDiff Y} {FZ : FilteredDiff Z} (FP : FilteredPairing P FX FY FZ)
  : LayerPairing.{u} (filteredCouple.{u} {R} {G} {deg} {X} FX) (filteredCouple.{u} {R} {G} {deg} {Y} FY) (filteredCouple.{u} {R} {G} {deg} {Z} FZ) \cowith
  | mul p => FilteredPairing.hpair.{u} {FP} (filteredLeibniz.lz.{u} p) (filteredLeibniz.gr-left.{u} p) (filteredLeibniz.gr-right.{u} p) (filteredLeibniz.deg2.{u} p)

\func filteredLeibniz.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing X Y Z}
                          {FX : FilteredDiff X} {FY : FilteredDiff Y} {FZ : FilteredDiff Z} (FP : FilteredPairing P FX FY FZ) (n : Nat)
  : WindowLeibniz.{u} \cowith
  | LayerPairing => filteredLayer.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP
  | n => n
  | AX => filteredWindow.{u} {R} {G} {deg} {X} FX n
  | AY => filteredWindow.{u} {R} {G} {deg} {Y} FY n
  | AZ => filteredWindow.{u} {R} {G} {deg} {Z} FZ n
  | sgn x => P.sgn x.2
  | sgn-sq x => P.sgn-sq x.2
  | wmul p => wmul0.{u} p
  | rho-wmul {x} {y} {z} p s t => FilteredPairing.hpair-whom.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP {x.1} {y.1} {z.1} {x.1} {y.1} {z.1} {fin (top.{u} x)} {fin (top.{u} y)} {fin (top.{u} z)}
                                    {fin (x.1 + 1)} {fin (y.1 + 1)} {fin (z.1 + 1)} (lz.{u} p) (top-left.{u} p) (top-right.{u} p) (lz.{u} p) (gr-left.{u} p) (gr-right.{u} p)
                                    <=-refl (lo-top.{u} x) <=-refl (lo-top.{u} y) <=-refl (lo-top.{u} z) (deg2.{u} p) (deg2.{u} p) idp idp idp s t
  | dwmul p => dwmul0.{u} p
  | rho-dwmul {w} {x} {y} {z} p r p' t s => FilteredPairing.hpair-whom.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP {w.1} {y.1} {z.1} {x.1} {y.1} {z.1} {inf} {fin (top.{u} y)} {fin (top.{u} z)}
                                              {fin (x.1 + 1)} {fin (y.1 + 1)} {fin (z.1 + 1)} (dw-a.{u} p) () (dw-b.{u} p) (lz.{u} p') (gr-left.{u} p') (gr-right.{u} p')
                                              (filteredCouple.le-j.{u} r) () <=-refl (lo-top.{u} y) <=-refl (lo-top.{u} z) (dw-deg.{u} p) (deg2.{u} p')
                                              (filteredCouple.deg-j.{u} r) idp idp t s
  | wdmul p => wdmul0.{u} p
  | rho-wdmul {x} {w} {y} {z} p r p' s t => FilteredPairing.hpair-whom.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP {x.1} {w.1} {z.1} {x.1} {y.1} {z.1} {fin (top.{u} x)} {inf} {fin (top.{u} z)}
                                              {fin (x.1 + 1)} {fin (y.1 + 1)} {fin (z.1 + 1)} (wd-a.{u} p) (wd-b.{u} p) () (lz.{u} p') (gr-left.{u} p') (gr-right.{u} p')
                                              <=-refl (lo-top.{u} x) (filteredCouple.le-j.{u} r) () <=-refl (lo-top.{u} z) (wd-deg.{u} p) (deg2.{u} p')
                                              idp (filteredCouple.deg-j.{u} r) idp s t
  | leibniz-window {x} {y} {z} {z'} p r q q' s t =>
    FilteredPairing.conn-leibniz.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP {x.1} {top.{u} x} {y.1} {top.{u} y} {z.1} {top.{u} z} {z'.1} {inf} {inf} {inf} {fin (top.{u} z')}
                                 (lz.{u} p) (top-left.{u} p) (top-right.{u} p) (le-top.{u} x) () (le-top.{u} y) () (le-top.{u} z) ()
                                 (dw-a.{u} q) () (dw-b.{u} q) (wd-a.{u} q') (wd-b.{u} q') () (filteredCouple.le-j.{u} r) ()
                                 (deg2.{u} p) (deg-top.{u} x) (deg-top.{u} y) (deg-top.{u} z) (filteredCouple.deg-j.{u} r) (dw-deg.{u} q) (wd-deg.{u} q') idp s t
  \where {
    \func wmul0 {x y z : Bi G} (p : (+) {Bi G} x y = z)
      : BilinearMap {R} (WindowDiagram.W {filteredWindow {R} {G} {deg} {X} FX n} x) (WindowDiagram.W {filteredWindow {R} {G} {deg} {Y} FY n} y) (WindowDiagram.W {filteredWindow {R} {G} {deg} {Z} FZ n} z)
      => (FilteredPairing.hpair {FP} (lz p) (top-left p) (top-right p) (deg2 p)
        : BilinearMap {R} (WindowDiagram.W {filteredWindow {R} {G} {deg} {X} FX n} x) (WindowDiagram.W {filteredWindow {R} {G} {deg} {Y} FY n} y) (WindowDiagram.W {filteredWindow {R} {G} {deg} {Z} FZ n} z))

    \func dwmul0 {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z)
      : BilinearMap {R} (Couple.D {filteredCouple {R} {G} {deg} {X} FX} w) (WindowDiagram.W {filteredWindow {R} {G} {deg} {Y} FY n} y) (WindowDiagram.W {filteredWindow {R} {G} {deg} {Z} FZ n} z)
      => (FilteredPairing.hpair {FP} (dw-a p) () (dw-b p) (dw-deg p)
        : BilinearMap {R} (Couple.D {filteredCouple {R} {G} {deg} {X} FX} w) (WindowDiagram.W {filteredWindow {R} {G} {deg} {Y} FY n} y) (WindowDiagram.W {filteredWindow {R} {G} {deg} {Z} FZ n} z))

    \func wdmul0 {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z)
      : BilinearMap {R} (WindowDiagram.W {filteredWindow {R} {G} {deg} {X} FX n} x) (Couple.D {filteredCouple {R} {G} {deg} {Y} FY} w) (WindowDiagram.W {filteredWindow {R} {G} {deg} {Z} FZ n} z)
      => (FilteredPairing.hpair {FP} (wd-a p) (wd-b p) () (wd-deg p)
        : BilinearMap {R} (WindowDiagram.W {filteredWindow {R} {G} {deg} {X} FX n} x) (Couple.D {filteredCouple {R} {G} {deg} {Y} FY} w) (WindowDiagram.W {filteredWindow {R} {G} {deg} {Z} FZ n} z))

    \func top (y : Bi G) : Int => filteredWindow.top {G} {deg} {n} y

    \lemma top-eq (y : Bi G) : top y = y.1 + 1 - neg n
      => filteredWindow.top-eq {G} {deg} {n} y

    \lemma le-top (y : Bi G) : y.1 <= top y
      => filteredWindow.le-top {G} {deg} {n} y

    \lemma lo-top (y : Bi G) : y.1 + 1 <= top y
      => filteredWindow.lo-top {G} {deg} {n} y

    \lemma deg-top (y : Bi G) : y.2 + deg = (filteredWindow.jx {G} {deg} {n} y).2
      => filteredWindow.deg-top {G} {deg} {n} y

    \lemma lz {x y z : Bi G} (p : (+) {Bi G} x y = z) : z.1 <= x.1 + y.1 \elim z, p
      | _, idp => <=-refl

    \lemma deg2 {x y z : Bi G} (p : (+) {Bi G} x y = z) : x.2 + y.2 = z.2
      => pmap __.2 p

    \lemma gr-left {x y z : Bi G} (p : (+) {Bi G} x y = z) : z.1 + 1 <= x.1 + 1 + y.1 \elim z, p
      | _, idp => (linarith : x.1 + y.1 + 1 <= x.1 + 1 + y.1)

    \lemma gr-right {x y z : Bi G} (p : (+) {Bi G} x y = z) : z.1 + 1 <= y.1 + 1 + x.1 \elim z, p
      | _, idp => (linarith : x.1 + y.1 + 1 <= y.1 + 1 + x.1)

    \lemma top-left {x y z : Bi G} (p : (+) {Bi G} x y = z) : top z <= top x + y.1 \elim z, p
      | _, idp => rewrite (top-eq ((+) {Bi G} x y), top-eq x) (linarith : x.1 + y.1 + 1 - neg n <= x.1 + 1 - neg n + y.1)

    \lemma top-right {x y z : Bi G} (p : (+) {Bi G} x y = z) : top z <= top y + x.1 \elim z, p
      | _, idp => rewrite (top-eq ((+) {Bi G} x y), top-eq y) (linarith : x.1 + y.1 + 1 - neg n <= y.1 + 1 - neg n + x.1)

    \lemma dw-a {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : z.1 <= w.1 + y.1 \elim z, p
      | _, idp => (linarith : w.1 + 0 + y.1 <= w.1 + y.1)

    \lemma dw-b {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : top z <= top y + w.1 \elim z, p
      | _, idp => rewrite (top-eq ((+) {Bi G} ((+) {Bi G} w (0, 0)) y), top-eq y) (linarith : w.1 + 0 + y.1 + 1 - neg n <= y.1 + 1 - neg n + w.1)

    \lemma dw-deg {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : w.2 + y.2 = z.2
      => inv (pmap (`+ y.2) zro-right) *> pmap __.2 p

    \lemma wd-a {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : z.1 <= x.1 + w.1 \elim z, p
      | _, idp => (linarith : x.1 + (w.1 + 0) <= x.1 + w.1)

    \lemma wd-b {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : top z <= top x + w.1 \elim z, p
      | _, idp => rewrite (top-eq ((+) {Bi G} x ((+) {Bi G} w (0, 0))), top-eq x) (linarith : x.1 + (w.1 + 0) + 1 - neg n <= x.1 + 1 - neg n + w.1)

    \lemma wd-deg {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : x.2 + w.2 = z.2
      => inv (pmap (x.2 +) zro-right) *> pmap __.2 p
  }

\func filteredPairing.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing X Y Z}
                          {FX : FilteredDiff X} {FY : FilteredDiff Y} {FZ : FilteredDiff Z} (FP : FilteredPairing P FX FY FZ) (m : Nat)
  : WindowPairing.{u} \cowith
  | LayerPairing => filteredLayer.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP
  | n => suc m
  | sgn => WindowLeibniz.sgn {filteredLeibniz.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP (suc m)}
  | sgn-sq => WindowLeibniz.sgn-sq {filteredLeibniz.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP (suc m)}
  | MX => filteredFrame.{u} {R} {G} {deg} {X} FX m
  | MY => filteredFrame.{u} {R} {G} {deg} {Y} FY m
  | MZ => filteredFrame.{u} {R} {G} {deg} {Z} FZ m
  | wmul {x} {y} {z} p => wmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m {x} {y} {z} p
  | rho-wmul p s t => rho-wmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p s t
  | dwmul {w} {y} {z} p => dwmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m {w} {y} {z} p
  | rho-dwmul p r p' t s => rho-dwmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p r p' t s
  | wdmul {x} {w} {z} p => wdmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m {x} {w} {z} p
  | rho-wdmul p r p' s t => rho-wdmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p r p' s t
  | leibniz-window p r q q' s t => leibniz-window0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p r q q' s t
  | smul {x} {y} {z} p => smul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m {x} {y} {z} p
  | dmmul {w} {y} {z} p => dmmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m {w} {y} {z} p
  | mrho-dmmul p r p' t u => mrho-dmmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p r p' t u
  | sdmul {x} {w} {z} p => sdmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m {x} {w} {z} p
  | sdmul-i p p' q r u t => sdmul-i0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p p' q r u t
  | leibniz-left p q q' u v => leibniz-left0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p q q' u v
  | msmul {x} {y} {z} p => msmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m {x} {y} {z} p
  | mdmul {x} {w} {z} p => mdmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m {x} {w} {z} p
  | mrho-mdmul p r p' u t => mrho-mdmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p r p' u t
  | dsmul {w} {y} {z} p => dsmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m {w} {y} {z} p
  | dsmul-i p p' q r t u => dsmul-i0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p p' q r t u
  | leibniz-right p q q' v u => leibniz-right0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p q q' v u
  \where {
    \func wmul0.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing.{u} X Y Z}
                 {FX : FilteredDiff.{u} X} {FY : FilteredDiff.{u} Y} {FZ : FilteredDiff.{u} Z} (FP : FilteredPairing.{u} P FX FY FZ) (m : Nat)
                 {x y z : Bi G} (p : (+) {Bi G} x y = z)
      : BilinearMap {R} (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {X} FX m} x) (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y) (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z)
      => (WindowLeibniz.wmul {filteredLeibniz.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP (suc m)} p
        : BilinearMap {R} (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {X} FX m} x) (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y) (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z))

    \func dwmul0.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing.{u} X Y Z}
                 {FX : FilteredDiff.{u} X} {FY : FilteredDiff.{u} Y} {FZ : FilteredDiff.{u} Z} (FP : FilteredPairing.{u} P FX FY FZ) (m : Nat)
                 {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z)
      : BilinearMap {R} (Couple.D {filteredCouple.{u} {R} {G} {deg} {X} FX} w) (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y) (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z)
      => (WindowLeibniz.dwmul {filteredLeibniz.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP (suc m)} p
        : BilinearMap {R} (Couple.D {filteredCouple.{u} {R} {G} {deg} {X} FX} w) (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y) (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z))

    \func wdmul0.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing.{u} X Y Z}
                 {FX : FilteredDiff.{u} X} {FY : FilteredDiff.{u} Y} {FZ : FilteredDiff.{u} Z} (FP : FilteredPairing.{u} P FX FY FZ) (m : Nat)
                 {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z)
      : BilinearMap {R} (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {X} FX m} x) (Couple.D {filteredCouple.{u} {R} {G} {deg} {Y} FY} w) (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z)
      => (WindowLeibniz.wdmul {filteredLeibniz.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP (suc m)} p
        : BilinearMap {R} (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {X} FX m} x) (Couple.D {filteredCouple.{u} {R} {G} {deg} {Y} FY} w) (WindowDiagram.W {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z))

    \func smul0.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing.{u} X Y Z}
                 {FX : FilteredDiff.{u} X} {FY : FilteredDiff.{u} Y} {FZ : FilteredDiff.{u} Z} (FP : FilteredPairing.{u} P FX FY FZ) (m : Nat)
                 {x y z : Bi G} (p : (+) {Bi G} x y = z)
      : BilinearMap {R} (WindowDiagram.S {filteredFrame.{u} {R} {G} {deg} {X} FX m} x) (WindowFrame.M {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y) (WindowDiagram.S {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z)
      => (FilteredPairing.hpair.{u} {FP} (sm-a.{u} {G} {m} p) (sm-b.{u} {G} p) (sm-c.{u} {G} {deg} {m} p) (sm-deg.{u} {G} {deg} p)
        : BilinearMap {R} (WindowDiagram.S {filteredFrame.{u} {R} {G} {deg} {X} FX m} x) (WindowFrame.M {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y) (WindowDiagram.S {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z))

    \func dmmul0.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing.{u} X Y Z}
                 {FX : FilteredDiff.{u} X} {FY : FilteredDiff.{u} Y} {FZ : FilteredDiff.{u} Z} (FP : FilteredPairing.{u} P FX FY FZ) (m : Nat)
                 {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z)
      : BilinearMap {R} (Couple.D {filteredCouple.{u} {R} {G} {deg} {X} FX} w) (WindowFrame.M {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y) (WindowFrame.M {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z)
      => (FilteredPairing.hpair.{u} {FP} (dm-a.{u} {G} p) () (dm-b.{u} {G} {deg} {m} p) (dm-deg.{u} {G} p)
        : BilinearMap {R} (Couple.D {filteredCouple.{u} {R} {G} {deg} {X} FX} w) (WindowFrame.M {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y) (WindowFrame.M {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z))

    \func sdmul0.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing.{u} X Y Z}
                 {FX : FilteredDiff.{u} X} {FY : FilteredDiff.{u} Y} {FZ : FilteredDiff.{u} Z} (FP : FilteredPairing.{u} P FX FY FZ) (m : Nat)
                 {x w z : Bi G} (p : (+) {Bi G} ((+) {Bi G} x w) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
