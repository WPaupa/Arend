                                               <=-refl (lo-mtop.{u} {G} {deg} {m} x) (filteredCouple.le-j.{u} r) () <=-refl (lo-mtop.{u} {G} {deg} {m} z) (md-deg.{u} {G} p) _ idp (filteredCouple.deg-j.{u} r) idp u t

    \lemma dsmul-i0.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing.{u} X Y Z}
                 {FX : FilteredDiff.{u} X} {FY : FilteredDiff.{u} Y} {FZ : FilteredDiff.{u} Z} (FP : FilteredPairing.{u} P FX FY FZ) (m : Nat)
                 {w w' y z z' : Bi G} (p : (+) {Bi G} ((+) {Bi G} w' y) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0)) (p' : (+) {Bi G} ((+) {Bi G} w y) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z' (1, deg)) (neg 1, 0))
                 (q : (+) {Bi G} w (neg 1, 0) = w') (r : (+) {Bi G} z' (neg 1, 0) = z) (t : Couple.D {filteredCouple.{u} {R} {G} {deg} {X} FX} w) (u : WindowDiagram.S {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y)
      : dsmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p (Couple.i {filteredCouple.{u} {R} {G} {deg} {X} FX} q t) u = WindowFrame.far {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} r (dsmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p' t u)
      => inv (pmap (\lam v => FilteredPairing.hpair.{u} {FP} (ds-a.{u} {G} {deg} {m} p) () (ds-b.{u} {G} {deg} {m} p) (ds-deg.{u} {G} {deg} {m} p) (Couple.i {filteredCouple.{u} {R} {G} {deg} {X} FX} q t) v) (FilteredDiff.whom-id.{u} {FY} {bot.{u} {G} {m} y} {fin (mj.{u} {G} y).1} <=-refl <=-refl idp u))
    *> inv (FilteredPairing.hpair-whom.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP {w.1} {bot.{u} {G} {m} y} {z'.1} {w'.1} {bot.{u} {G} {m} y} {z.1} {inf} {fin (mj.{u} {G} y).1} {fin (mtop.{u} {G} {deg} {m} z')} {inf} {fin (mj.{u} {G} y).1} {fin (mtop.{u} {G} {deg} {m} z)}
                                       (ds-a.{u} {G} {deg} {m} p') () (ds-b.{u} {G} {deg} {m} p') (ds-a.{u} {G} {deg} {m} p) () (ds-b.{u} {G} {deg} {m} p) (filteredCouple.le-i.{u} q) () <=-refl <=-refl (filteredCouple.le-i.{u} r) (far-le.{u} {G} {deg} {m} r)
                                       (ds-deg.{u} {G} {deg} {m} p') (ds-deg.{u} {G} {deg} {m} p) (filteredCouple.deg-i.{u} q) idp (filteredCouple.deg-i.{u} r) t u)

    \lemma leibniz-right0.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X Y Z : DiffModule.{u} G deg R} {P : DiffPairing.{u} X Y Z}
                 {FX : FilteredDiff.{u} X} {FY : FilteredDiff.{u} Y} {FZ : FilteredDiff.{u} Z} (FP : FilteredPairing.{u} P FX FY FZ) (m : Nat)
                 {x y z : Bi G} (p : (+) {Bi G} x y = z) (q : (+) {Bi G} ((+) {Bi G} ((+) {Bi G} ((-) {Bi G} ((+) {Bi G} x (1, deg)) ((*n) {Bi G} (suc m) (neg 1, 0))) (neg 1, 0)) y) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0)) (q' : (+) {Bi G} x ((+) {Bi G} ((-) {Bi G} y (0, 0)) (0, 0)) = z)
                 (v : WindowFrame.M {filteredFrame.{u} {R} {G} {deg} {X} FX m} x) (u : WindowDiagram.S {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y)
      : WindowFrame.restrict {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} (GradedMap.pre {Bi G} z (0, 0)) (WindowDiagram.tower {filteredFrame.{u} {R} {G} {deg} {Z} FZ m} z (msmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m p v u))
        = dsmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m q (WindowFrame.mdelta {filteredFrame.{u} {R} {G} {deg} {X} FX m} x v) u + WindowLeibniz.sgn {filteredLeibniz.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP (suc m)} x *c mdmul0.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP m q' v (WindowDiagram.tower {filteredFrame.{u} {R} {G} {deg} {Y} FY m} y u)
      => FilteredPairing.conn-leibniz.{u} {R} {G} {deg} {X} {Y} {Z} {P} {FX} {FY} {FZ} FP {x.1} {mtop.{u} {G} {deg} {m} x} {bot.{u} {G} {m} y} {(mj.{u} {G} y).1} {bot.{u} {G} {m} z} {(mj.{u} {G} z).1} {z.1} {inf} {inf} {inf} {fin (mtop.{u} {G} {deg} {m} z)}
                                 (ms-a.{u} {G} {m} p) (ms-b.{u} {G} {deg} {m} p) (ms-c.{u} {G} p) (le-mtop.{u} {G} {deg} {m} x) () (bot-le.{u} {G} {m} y) () (bot-le.{u} {G} {m} z) ()
                                 (ds-a.{u} {G} {deg} {m} {mx.{u} {G} {deg} {m} x} q) () (ds-b.{u} {G} {deg} {m} {mx.{u} {G} {deg} {m} x} q) (md-a.{u} {G} {x} {mj.{u} {G} y} q') (md-b.{u} {G} {deg} {m} {x} {mj.{u} {G} y} q') ()
                                 (filteredCouple.le-j.{u} {G} {(-) {Bi G} z (0, 0)} {z} (GradedMap.pre {Bi G} z (0, 0))) ()
                                 (ms-deg.{u} {G} {deg} p) (deg-mtop.{u} {G} {deg} {m} x) (deg-bot.{u} {G} {deg} y) (deg-bot.{u} {G} {deg} z) (filteredCouple.deg-j.{u} {G} {(-) {Bi G} z (0, 0)} {z} (GradedMap.pre {Bi G} z (0, 0)))
                                 (ds-deg.{u} {G} {deg} {m} {mx.{u} {G} {deg} {m} x} q) (md-deg.{u} {G} {x} {mj.{u} {G} y} q') idp v u

    \func mj.{u} {G : AbGroup.{u}} (y : Bi G) : Bi G => filteredWindow.mj.{u} {G} y

    \func bot.{u} {G : AbGroup.{u}} {m : Nat} (y : Bi G) : Int => filteredWindow.bot.{u} {G} {suc m} y

    \func mtop.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} (y : Bi G) : Int => filteredFrame.mtop.{u} {G} {deg} {m} y

    \func mx.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} (y : Bi G) : Bi G => filteredFrame.mx.{u} {G} {deg} {m} y

    \lemma bot-le.{u} {G : AbGroup.{u}} {m : Nat} (y : Bi G) : bot.{u} {G} {m} y <= (mj.{u} {G} y).1
      => filteredWindow.bot-le.{u} {G} {suc m} y

    \lemma deg-bot.{u} {G : AbGroup.{u}} {deg : G} (y : Bi G) : (mj.{u} {G} y).2 - deg + deg = (mj.{u} {G} y).2
      => filteredWindow.deg-bot.{u} {G} {deg} y

    \lemma le-mtop.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} (y : Bi G) : y.1 <= mtop.{u} {G} {deg} {m} y
      => filteredFrame.le-mtop.{u} {G} {deg} {m} y

    \lemma lo-mtop.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} (y : Bi G) : y.1 + 1 <= mtop.{u} {G} {deg} {m} y
      => filteredFrame.lo-mtop.{u} {G} {deg} {m} y

    \lemma deg-mtop.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} (y : Bi G) : y.2 + deg = (filteredFrame.mx.{u} {G} {deg} {m} y).2
      => filteredFrame.deg-mtop.{u} {G} {deg} {m} y

    \lemma far-le.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {x y : Bi G} (p : (+) {Bi G} x (neg 1, 0) = y) : mtop.{u} {G} {deg} {m} y <= mtop.{u} {G} {deg} {m} x
      => filteredFrame.far-le.{u} {G} {deg} {m} p

    \lemma mj1.{u} {G : AbGroup.{u}} (y : Bi G) : (mj.{u} {G} y).1 = y.1
      => (linarith : y.1 - 0 = y.1)

    \lemma botN.{u} {G : AbGroup.{u}} {m : Nat} (y : Bi G) : bot.{u} {G} {m} y = y.1 + neg (suc m)
      => pmap (\lam (z : Bi G) => (mj.{u} {G} y).1 + z.1) (Bi.ndi (suc m)) *> pmap (`+ neg (suc m)) (mj1.{u} {G} y)

    \lemma mtopN.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} (y : Bi G) : mtop.{u} {G} {deg} {m} y = y.1 + 1 - neg (suc m) + neg 1
      => filteredFrame.mtop-eq.{u} {G} {deg} {m} y

    \lemma idx1.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {a b z : Bi G} (p : (+) {Bi G} ((+) {Bi G} a b) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : z.1 = a.1 + b.1 + neg (suc m)
      => (linarith : z.1 = z.1 + 1 + neg 1) *> inv (pmap __.1 p) *> pmap (\lam (t : Bi G) => a.1 + b.1 + t.1) (Bi.ndi (suc m))

    \lemma idx2.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {a b z : Bi G} (p : (+) {Bi G} ((+) {Bi G} a b) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : a.2 + b.2 = z.2 + deg
      => inv zro-right *> inv (pmap (\lam (t : Bi G) => a.2 + b.2 + t.2) (Bi.ndi (suc m))) *> pmap __.2 p *> zro-right

    \lemma sm-a.{u} {G : AbGroup.{u}} {m : Nat} {x y z : Bi G} (p : (+) {Bi G} x y = z) : bot.{u} {G} {m} z <= bot.{u} {G} {m} x + y.1 \elim z, p
      | _, idp => rewrite (botN.{u} {G} {m} ((+) {Bi G} x y), botN.{u} {G} {m} x) (linarith : x.1 + y.1 + neg (suc m) <= x.1 + neg (suc m) + y.1)

    \lemma sm-b.{u} {G : AbGroup.{u}} {x y z : Bi G} (p : (+) {Bi G} x y = z) : (mj.{u} {G} z).1 <= (mj.{u} {G} x).1 + y.1 \elim z, p
      | _, idp => rewrite (mj1.{u} {G} ((+) {Bi G} x y), mj1.{u} {G} x) (linarith : x.1 + y.1 <= x.1 + y.1)

    \lemma sm-c.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {x y z : Bi G} (p : (+) {Bi G} x y = z) : (mj.{u} {G} z).1 <= mtop.{u} {G} {deg} {m} y + bot.{u} {G} {m} x \elim z, p
      | _, idp => rewrite (mj1.{u} {G} ((+) {Bi G} x y), mtopN.{u} {G} {deg} {m} y, botN.{u} {G} {m} x) (linarith : x.1 + y.1 <= y.1 + 1 - neg (suc m) + neg 1 + (x.1 + neg (suc m)))

    \lemma sm-deg.{u} {G : AbGroup.{u}} {deg : G} {x y z : Bi G} (p : (+) {Bi G} x y = z) : (mj.{u} {G} x).2 - deg + y.2 = (mj.{u} {G} z).2 - deg \elim z, p
      | _, idp => (equation.abGroup : x.2 - 0 - deg + y.2 = x.2 + y.2 - 0 - deg)

    \lemma dm-a.{u} {G : AbGroup.{u}} {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : z.1 <= w.1 + y.1 \elim z, p
      | _, idp => (linarith : w.1 + 0 + y.1 <= w.1 + y.1)

    \lemma dm-b.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : mtop.{u} {G} {deg} {m} z <= mtop.{u} {G} {deg} {m} y + w.1 \elim z, p
      | _, idp => rewrite (mtopN.{u} {G} {deg} {m} ((+) {Bi G} ((+) {Bi G} w (0, 0)) y), mtopN.{u} {G} {deg} {m} y)
                    (linarith : w.1 + 0 + y.1 + 1 - neg (suc m) + neg 1 <= y.1 + 1 - neg (suc m) + neg 1 + w.1)

    \lemma dm-deg.{u} {G : AbGroup.{u}} {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w (0, 0)) y = z) : w.2 + y.2 = z.2
      => inv (pmap (`+ y.2) zro-right) *> pmap __.2 p

    \lemma sd-a.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {x w z : Bi G} (p : (+) {Bi G} ((+) {Bi G} x w) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : z.1 <= bot.{u} {G} {m} x + w.1
      => rewrite (idx1.{u} {G} {deg} {m} p, botN.{u} {G} {m} x) (linarith : x.1 + w.1 + neg (suc m) <= x.1 + neg (suc m) + w.1)

    \lemma sd-b.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {x w z : Bi G} (p : (+) {Bi G} ((+) {Bi G} x w) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : mtop.{u} {G} {deg} {m} z <= (mj.{u} {G} x).1 + w.1
      => rewrite (mtopN.{u} {G} {deg} {m} z, idx1.{u} {G} {deg} {m} p, mj1.{u} {G} x) (linarith : x.1 + w.1 + neg (suc m) + 1 - neg (suc m) + neg 1 <= x.1 + w.1)

    \lemma sd-deg.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {x w z : Bi G} (p : (+) {Bi G} ((+) {Bi G} x w) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : (mj.{u} {G} x).2 - deg + w.2 = z.2
      => (equation.abGroup : x.2 - 0 - deg + w.2 = x.2 + w.2 - deg) *> pmap (`- deg) (idx2.{u} {G} {deg} {m} p) *> (equation.abGroup : z.2 + deg - deg = z.2)

    \lemma ms-a.{u} {G : AbGroup.{u}} {m : Nat} {x y z : Bi G} (p : (+) {Bi G} x y = z) : bot.{u} {G} {m} z <= x.1 + bot.{u} {G} {m} y \elim z, p
      | _, idp => rewrite (botN.{u} {G} {m} ((+) {Bi G} x y), botN.{u} {G} {m} y) (linarith : x.1 + y.1 + neg (suc m) <= x.1 + (y.1 + neg (suc m)))

    \lemma ms-b.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {x y z : Bi G} (p : (+) {Bi G} x y = z) : (mj.{u} {G} z).1 <= mtop.{u} {G} {deg} {m} x + bot.{u} {G} {m} y \elim z, p
      | _, idp => rewrite (mj1.{u} {G} ((+) {Bi G} x y), mtopN.{u} {G} {deg} {m} x, botN.{u} {G} {m} y) (linarith : x.1 + y.1 <= x.1 + 1 - neg (suc m) + neg 1 + (y.1 + neg (suc m)))

    \lemma ms-c.{u} {G : AbGroup.{u}} {x y z : Bi G} (p : (+) {Bi G} x y = z) : (mj.{u} {G} z).1 <= (mj.{u} {G} y).1 + x.1 \elim z, p
      | _, idp => rewrite (mj1.{u} {G} ((+) {Bi G} x y), mj1.{u} {G} y) (linarith : x.1 + y.1 <= y.1 + x.1)

    \lemma ms-deg.{u} {G : AbGroup.{u}} {deg : G} {x y z : Bi G} (p : (+) {Bi G} x y = z) : x.2 + ((mj.{u} {G} y).2 - deg) = (mj.{u} {G} z).2 - deg \elim z, p
      | _, idp => (equation.abGroup : x.2 + (y.2 - 0 - deg) = x.2 + y.2 - 0 - deg)

    \lemma md-a.{u} {G : AbGroup.{u}} {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : z.1 <= x.1 + w.1 \elim z, p
      | _, idp => (linarith : x.1 + (w.1 + 0) <= x.1 + w.1)

    \lemma md-b.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : mtop.{u} {G} {deg} {m} z <= mtop.{u} {G} {deg} {m} x + w.1 \elim z, p
      | _, idp => rewrite (mtopN.{u} {G} {deg} {m} ((+) {Bi G} x ((+) {Bi G} w (0, 0))), mtopN.{u} {G} {deg} {m} x)
                    (linarith : x.1 + (w.1 + 0) + 1 - neg (suc m) + neg 1 <= x.1 + 1 - neg (suc m) + neg 1 + w.1)

    \lemma md-deg.{u} {G : AbGroup.{u}} {x w z : Bi G} (p : (+) {Bi G} x ((+) {Bi G} w (0, 0)) = z) : x.2 + w.2 = z.2
      => inv (pmap (x.2 +) zro-right) *> pmap __.2 p

    \lemma ds-a.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w y) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : z.1 <= w.1 + bot.{u} {G} {m} y
      => rewrite (idx1.{u} {G} {deg} {m} p, botN.{u} {G} {m} y) (linarith : w.1 + y.1 + neg (suc m) <= w.1 + (y.1 + neg (suc m)))

    \lemma ds-b.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w y) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : mtop.{u} {G} {deg} {m} z <= (mj.{u} {G} y).1 + w.1
      => rewrite (mtopN.{u} {G} {deg} {m} z, idx1.{u} {G} {deg} {m} p, mj1.{u} {G} y) (linarith : w.1 + y.1 + neg (suc m) + 1 - neg (suc m) + neg 1 <= y.1 + w.1)

    \lemma ds-deg.{u} {G : AbGroup.{u}} {deg : G} {m : Nat} {w y z : Bi G} (p : (+) {Bi G} ((+) {Bi G} w y) ((*n) {Bi G} (suc m) (neg 1, 0)) = (+) {Bi G} ((+) {Bi G} z (1, deg)) (neg 1, 0))
      : w.2 + ((mj.{u} {G} y).2 - deg) = z.2
      => (equation.abGroup : w.2 + (y.2 - 0 - deg) = w.2 + y.2 - deg) *> pmap (`- deg) (idx2.{u} {G} {deg} {m} p) *> (equation.abGroup : z.2 + deg - deg = z.2)
  }
