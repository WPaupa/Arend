\import Algebra.Group
\import Algebra.Group.Exact
\import Algebra.Group.Product
\import Algebra.Meta
\import Algebra.Module
\import Algebra.Module.Differential
\import Algebra.Module.Differential.Filtered
\import Algebra.Module.Differential.LongExact (DiffSES, exact-congr)
\import Algebra.Module.ExactCouple
\import Algebra.Module.ExactCouple.Cumulative
\import Algebra.Module.ExactCouple.Filtered
\import Algebra.Module.ExactCouple.Window
\import Algebra.Module.GradedComplex
\import Algebra.Module.LinearMap
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Ring
\import Arith.Int
\import Logic
\import Order.LinearOrder
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\open GradedMap (pre)
\open ExactCouple (jdeg)
\open AddMonoid (*n)

\func filteredWindow.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X : DiffModule.{u} G deg R} (FX : FilteredDiff X) (n : Nat)
  : WindowDiagram.{u} (filteredCouple.{u} FX) n \cowith
  | W => W'.{u} {G} {deg} {n} {R} {X} {FX}
  | rho => rho'.{u} {G} {deg} {n} {R} {X} {FX}
  | delta => delta'.{u} {G} {deg} {n} {R} {X} {FX}
  | delta-rho y t => delta-rho'.{u} {G} {deg} {n} {R} {X} {FX} y t
  | dshort y => LinearMap.compose {R} {W'.{u} {G} {deg} {n} {R} {X} {FX} y} {Couple.D {filteredCouple.{u} FX} (jx.{u} {G} {deg} {n} y)} {Couple.E {filteredCouple.{u} FX} (jz.{u} {G} {deg} {n} y)}
                                  (Couple.j {filteredCouple.{u} FX} {jx.{u} {G} {deg} {n} y} {jz.{u} {G} {deg} {n} y} (jdeg.index {Bi G} {neg 1, 0} {0, 0} {n} {dk.{u} {G} {deg} y} (+-assoc {Bi G} *> idp))) (delta'.{u} {G} {deg} {n} {R} {X} {FX} y)
  | j-delta _ _ => idp
  | V => V'.{u} {G} {deg} {n} {R} {X} {FX}
  | q => q'.{u} {G} {deg} {n} {R} {X} {FX}
  | obstruction => obst.{u} {G} {deg} {n} {R} {X} {FX}
  | obstruction-k _ _ => idp
  | exact-rho y => exact-rho'.{u} {G} {deg} {n} {R} {X} {FX} y
  | exact-q y => exact-q'.{u} {G} {deg} {n} {R} {X} {FX} y
  | S => S'.{u} {G} {deg} {n} {R} {X} {FX}
  | short y => LinearMap.compose {R} {S'.{u} {G} {deg} {n} {R} {X} {FX} y} {Couple.D {filteredCouple.{u} FX} (mj.{u} {G} y)} {Couple.E {filteredCouple.{u} FX} y}
                                 (Couple.j {filteredCouple.{u} FX} {mj.{u} {G} y} {y} (pre {Bi G} y (0, 0))) (tower'.{u} {G} {deg} {n} {R} {X} {FX} y)
  | tower => tower'.{u} {G} {deg} {n} {R} {X} {FX}
  | exact-tower y => exact-tower'.{u} {G} {deg} {n} {R} {X} {FX} y
  | tower-short _ _ => idp
  | wrestrict {w} {y} p => FilteredDiff.whom.{u} {FX} {w.1} {y.1} {inf} {fin (top.{u} {G} {deg} {n} y)} (filteredCouple.le-j.{u} p) () (filteredCouple.deg-j.{u} p)
  | rho-wrestrict {w} {y} p t => FilteredDiff.whom-comp.{u} {FX} {w.1} {y.1} {y.1} {inf} {fin (top.{u} {G} {deg} {n} y)} {fin (y.1 + 1)} (filteredCouple.le-j.{u} p) () <=-refl (lo-top.{u} {G} {deg} {n} y)
                                              (filteredCouple.le-j.{u} p) () (filteredCouple.deg-j.{u} p) idp t
                                 *> FilteredDiff.whom-unique.{u} {FX} (filteredCouple.le-j.{u} p) (filteredCouple.le-j.{u} p) () () _ (filteredCouple.deg-j.{u} p) t
  \where {
    \func dk.{u} {G : AbGroup.{u}} {deg : G} (y : Bi G) : Bi G => (+) {Bi G} y (1, deg)

    \func jx.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} (y : Bi G) : Bi G => (-) {Bi G} (dk.{u} {G} {deg} y) ((*n) {Bi G} n (neg 1, 0))

    \func jz.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} (y : Bi G) : Bi G => (+) {Bi G} y ((+) {Bi G} (1, deg) (jdeg {Bi G} (neg 1, 0) (0, 0) n))

    \func mj.{u} {G : AbGroup.{u}} (y : Bi G) : Bi G => (-) {Bi G} y (0, 0)

    \func mjn.{u} {G : AbGroup.{u}} {n : Nat} (y : Bi G) : Bi G => (+) {Bi G} (mj.{u} {G} y) ((*n) {Bi G} n (neg 1, 0))

    \func top.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} (y : Bi G) : Int => (jx.{u} {G} {deg} {n} y).1

    \func bot.{u} {G : AbGroup.{u}} {n : Nat} (y : Bi G) : Int => (mjn.{u} {G} {n} y).1

    \func W'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) => LHomology.{u} (FilteredDiff.Win.{u} {FX} y.1 (fin (top.{u} {G} {deg} {n} y))) y.2

    \func V'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) => LHomology.{u} (FilteredDiff.Win.{u} {FX} (y.1 + 1) (fin (top.{u} {G} {deg} {n} y))) (y.2 + deg)

    \func S'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) => LHomology.{u} (FilteredDiff.Win.{u} {FX} (bot.{u} {G} {n} y) (fin (mj.{u} {G} y).1)) ((mj.{u} {G} y).2 - deg)

    \func rho'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) : LinearMap (W'.{u} {G} {deg} {n} {R} {X} {FX} y) (Couple.E {filteredCouple.{u} FX} y)
      => FilteredDiff.whom.{u} {FX} {y.1} {y.1} {fin (top.{u} {G} {deg} {n} y)} {fin (y.1 + 1)} <=-refl (lo-top.{u} {G} {deg} {n} y) idp

    \func delta'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) : LinearMap (W'.{u} {G} {deg} {n} {R} {X} {FX} y) (Couple.D {filteredCouple.{u} FX} (jx.{u} {G} {deg} {n} y))
      => FilteredDiff.conn.{u} {FX} (le-top.{u} {G} {deg} {n} y) () (deg-top.{u} {G} {deg} {n} y)

    \func q'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) : LinearMap (Couple.D {filteredCouple.{u} FX} (dk.{u} {G} {deg} y)) (V'.{u} {G} {deg} {n} {R} {X} {FX} y)
      => FilteredDiff.whom.{u} {FX} {y.1 + 1} {y.1 + 1} {inf} {fin (top.{u} {G} {deg} {n} y)} <=-refl () idp

    \func obst.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) : LinearMap (Couple.E {filteredCouple.{u} FX} y) (V'.{u} {G} {deg} {n} {R} {X} {FX} y)
      => LinearMap.compose {R} {Couple.E {filteredCouple.{u} FX} y} {Couple.D {filteredCouple.{u} FX} (dk.{u} {G} {deg} y)} {V'.{u} {G} {deg} {n} {R} {X} {FX} y} (q'.{u} {G} {deg} {n} {R} {X} {FX} y) (Couple.k {filteredCouple.{u} FX} {y} idp)

    \func tower'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) : LinearMap (S'.{u} {G} {deg} {n} {R} {X} {FX} y) (Couple.D {filteredCouple.{u} FX} (mj.{u} {G} y))
      => FilteredDiff.conn.{u} {FX} (bot-le.{u} {G} {n} y) () (deg-bot.{u} {G} {deg} y)

    \lemma top-eq.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} (y : Bi G) : top.{u} {G} {deg} {n} y = y.1 + 1 - neg n
      => pmap (\lam (z : Bi G) => y.1 + 1 - z.1) (Bi.ndi n)

    \lemma le-top.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} (y : Bi G) : y.1 <= top.{u} {G} {deg} {n} y
      => transportInv (y.1 <=) (top-eq.{u} {G} {deg} {n} y) (linarith : y.1 <= y.1 + 1 - neg n)

    \lemma lo-top.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} (y : Bi G) : y.1 + 1 <= top.{u} {G} {deg} {n} y
      => transportInv (y.1 + 1 <=) (top-eq.{u} {G} {deg} {n} y) (linarith : y.1 + 1 <= y.1 + 1 - neg n)

    \lemma deg-top.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} (y : Bi G) : y.2 + deg = (jx.{u} {G} {deg} {n} y).2
      => inv (pmap (\lam (z : Bi G) => y.2 + deg - z.2) (Bi.ndi n) *> AddGroup.minus_zro)

    \lemma bot-le.{u} {G : AbGroup.{u}} {n : Nat} (y : Bi G) : bot.{u} {G} {n} y <= (mj.{u} {G} y).1
      => transportInv (`<= (mj.{u} {G} y).1) (pmap (\lam (z : Bi G) => (mj.{u} {G} y).1 + z.1) (Bi.ndi n)) (linarith : (mj.{u} {G} y).1 + neg n <= (mj.{u} {G} y).1)

    \lemma deg-bot.{u} {G : AbGroup.{u}} {deg : G} (y : Bi G) : (mj.{u} {G} y).2 - deg + deg = (mj.{u} {G} y).2
      => equation.abGroup

    \lemma bot-deg.{u} {G : AbGroup.{u}} {n : Nat} (y : Bi G) : (mj.{u} {G} y).2 = (mjn.{u} {G} {n} y).2
      => inv (pmap (\lam (z : Bi G) => (mj.{u} {G} y).2 + z.2) (Bi.ndi n) *> zro-right)

    \lemma q-gen.{u} {G : AbGroup.{u}} {deg : G} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} {a b : Int} {u v : G} (h : b <= a) (e : u = v)
      : AbExactAt (FilteredDiff.whom.{u} {FX} {a} {b} {inf} {inf} h () e) (FilteredDiff.whom.{u} {FX} {b} {b} {inf} {fin a} <=-refl () idp) \elim v, e
      | _, idp => FilteredDiff.exact-ip.{u} FX h () u

    \lemma tower-gen.{u} {G : AbGroup.{u}} {deg : G} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} {a b : Int} {u v w : G} (h : a <= b) (e : u + deg = v) (e' : v = w)
      : AbExactAt (FilteredDiff.conn.{u} {FX} {a} {b} {inf} h () e) (FilteredDiff.whom.{u} {FX} {b} {a} {inf} {inf} h () e') \elim v, w, e, e'
      | _, _, idp, idp => FilteredDiff.exact-ci.{u} FX h () u

    \func conn-k.{u} {G : AbGroup.{u}} {deg : G} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) : LinearMap (Couple.E {filteredCouple.{u} FX} y) (LHomology.{u} (FilteredDiff.Win.{u} {FX} (y.1 + 1) inf) (y.2 + deg))
      => FilteredDiff.conn.{u} {FX} {y.1} {y.1 + 1} {inf} (filteredCouple.le-suc y.1) () (filteredCouple.deg-k.{u} {G} {deg} {y} idp)

    \lemma k-eq.{u} {G : AbGroup.{u}} {deg : G} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) (x : Couple.E {filteredCouple.{u} FX} y)
      : Couple.k {filteredCouple.{u} FX} {y} idp x = FilteredDiff.whom.{u} {FX} {y.1 + 1} {y.1 + 1} {inf} {inf} (filteredCouple.le-k.{u} {G} {deg} {y} idp) () idp (conn-k.{u} {G} {deg} {R} {X} {FX} y x)
      => idp

    \lemma exact-rho'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) : AbExactAt (rho'.{u} {G} {deg} {n} {R} {X} {FX} y) (obst.{u} {G} {deg} {n} {R} {X} {FX} y)
      => exact-congr {_} {_} {_} {rho'.{u} {G} {deg} {n} {R} {X} {FX} y} {rho'.{u} {G} {deg} {n} {R} {X} {FX} y} {FilteredDiff.wc.{u} {FX} (filteredCouple.le-suc y.1) (lo-top.{u} {G} {deg} {n} y) y.2} {obst.{u} {G} {deg} {n} {R} {X} {FX} y}
                     (\lam _ => idp) (\lam x => inv (obstruction-eq.{u} {G} {deg} {n} {R} {X} {FX} y x)) (FilteredDiff.exact-pc.{u} FX (filteredCouple.le-suc y.1) (lo-top.{u} {G} {deg} {n} y) y.2)

    \lemma exact-q'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) : AbExactAt (iter.{u} (filteredCouple.{u} FX) n {jx.{u} {G} {deg} {n} y} {dk.{u} {G} {deg} y} (pre {Bi G} (dk.{u} {G} {deg} y) ((*n) {Bi G} n (neg 1, 0)))) (q'.{u} {G} {deg} {n} {R} {X} {FX} y)
      => exact-congr {_} {_} {_} {FilteredDiff.whom.{u} {FX} {top.{u} {G} {deg} {n} y} {y.1 + 1} {inf} {inf} (lo-top.{u} {G} {deg} {n} y) () (inv (deg-top.{u} {G} {deg} {n} y))}
                     {iter.{u} (filteredCouple.{u} FX) n {jx.{u} {G} {deg} {n} y} {dk.{u} {G} {deg} y} (pre {Bi G} (dk.{u} {G} {deg} y) ((*n) {Bi G} n (neg 1, 0)))} {q'.{u} {G} {deg} {n} {R} {X} {FX} y} {q'.{u} {G} {deg} {n} {R} {X} {FX} y}
                     (\lam w => inv (iter-whom.{u} FX n {jx.{u} {G} {deg} {n} y} {dk.{u} {G} {deg} y} (pre {Bi G} _ _) <=-refl idp (lo-top.{u} {G} {deg} {n} y) (inv (deg-top.{u} {G} {deg} {n} y)) w)
                                *> pmap (iter.{u} (filteredCouple.{u} FX) n _) (FilteredDiff.whom-id.{u} {FX} <=-refl () idp w))
                     (\lam _ => idp) (q-gen.{u} {G} {deg} {R} {X} {FX} (lo-top.{u} {G} {deg} {n} y) (inv (deg-top.{u} {G} {deg} {n} y)))

    \lemma exact-tower'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) : AbExactAt (tower'.{u} {G} {deg} {n} {R} {X} {FX} y) (iter.{u} (filteredCouple.{u} FX) n {mj.{u} {G} y} {mjn.{u} {G} {n} y} idp)
      => exact-congr {_} {_} {_} {tower'.{u} {G} {deg} {n} {R} {X} {FX} y} {tower'.{u} {G} {deg} {n} {R} {X} {FX} y} {FilteredDiff.whom.{u} {FX} {(mj.{u} {G} y).1} {bot.{u} {G} {n} y} {inf} {inf} (bot-le.{u} {G} {n} y) () (bot-deg.{u} {G} {n} y)}
                     {iter.{u} (filteredCouple.{u} FX) n {mj.{u} {G} y} {mjn.{u} {G} {n} y} idp}
                     (\lam _ => idp)
                     (\lam w => inv (iter-whom.{u} FX n {mj.{u} {G} y} {mjn.{u} {G} {n} y} idp <=-refl idp (bot-le.{u} {G} {n} y) (bot-deg.{u} {G} {n} y) w)
                                *> pmap (iter.{u} (filteredCouple.{u} FX) n _) (FilteredDiff.whom-id.{u} {FX} <=-refl () idp w))
                     (tower-gen.{u} {G} {deg} {R} {X} {FX} (bot-le.{u} {G} {n} y) (deg-bot.{u} {G} {deg} y) (bot-deg.{u} {G} {n} y))

    \lemma delta-rho'.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) (t : W'.{u} {G} {deg} {n} {R} {X} {FX} y)
      : iter.{u} (filteredCouple.{u} FX) n {jx.{u} {G} {deg} {n} y} {dk.{u} {G} {deg} y} (pre {Bi G} (dk.{u} {G} {deg} y) ((*n) {Bi G} n (neg 1, 0))) (delta'.{u} {G} {deg} {n} {R} {X} {FX} y t)
        = Couple.k {filteredCouple.{u} FX} {y} idp (rho'.{u} {G} {deg} {n} {R} {X} {FX} y t)
      => pmap (iter.{u} (filteredCouple.{u} FX) n {jx.{u} {G} {deg} {n} y} {dk.{u} {G} {deg} y} _) (inv (FilteredDiff.whom-id.{u} {FX} {top.{u} {G} {deg} {n} y} {inf} <=-refl () idp (delta'.{u} {G} {deg} {n} {R} {X} {FX} y t)))
         *> iter-whom.{u} FX n {jx.{u} {G} {deg} {n} y} {dk.{u} {G} {deg} y} (pre {Bi G} _ _) <=-refl idp (lo-top.{u} {G} {deg} {n} y) (inv (deg-top.{u} {G} {deg} {n} y)) (delta'.{u} {G} {deg} {n} {R} {X} {FX} y t)
         *> FilteredDiff.whom-unique.{u} {FX} {top.{u} {G} {deg} {n} y} {y.1 + 1} {inf} {inf} (lo-top.{u} {G} {deg} {n} y) (lo-top.{u} {G} {deg} {n} y) () () (inv (deg-top.{u} {G} {deg} {n} y)) (inv (deg-top.{u} {G} {deg} {n} y) *> idp) (delta'.{u} {G} {deg} {n} {R} {X} {FX} y t)
         *> inv (FilteredDiff.whom-comp.{u} {FX} {top.{u} {G} {deg} {n} y} {y.1 + 1} {y.1 + 1} {inf} {inf} {inf} (lo-top.{u} {G} {deg} {n} y) () (filteredCouple.le-k.{u} {G} {deg} {y} idp) () (lo-top.{u} {G} {deg} {n} y) ()
                                            (inv (deg-top.{u} {G} {deg} {n} y)) idp (delta'.{u} {G} {deg} {n} {R} {X} {FX} y t))
         *> inv (pmap (FilteredDiff.whom.{u} {FX} {y.1 + 1} {y.1 + 1} {inf} {inf} (filteredCouple.le-k.{u} {G} {deg} {y} idp) () idp)
                      (FilteredDiff.conn-whom.{u} {_} {_} {_} {_} FX {y.1} {top.{u} {G} {deg} {n} y} {y.1} {y.1 + 1} {inf} {inf} (le-top.{u} {G} {deg} {n} y) () (filteredCouple.le-suc y.1) ()
                                              <=-refl (lo-top.{u} {G} {deg} {n} y) () (deg-top.{u} {G} {deg} {n} y) idp (filteredCouple.deg-k.{u} {G} {deg} {y} idp) (inv (deg-top.{u} {G} {deg} {n} y)) t))
         *> inv (k-eq.{u} {G} {deg} {R} {X} {FX} y (rho'.{u} {G} {deg} {n} {R} {X} {FX} y t))

    \lemma obstruction-eq.{u} {G : AbGroup.{u}} {deg : G} {n : Nat} {R : Ring.{u}} {X : DiffModule.{u} G deg R} {FX : FilteredDiff.{u} X} (y : Bi G) (x : Couple.E {filteredCouple.{u} FX} y)
      : obst.{u} {G} {deg} {n} {R} {X} {FX} y x = FilteredDiff.wc.{u} {FX} (filteredCouple.le-suc y.1) (lo-top.{u} {G} {deg} {n} y) y.2 x
      => pmap (q'.{u} {G} {deg} {n} {R} {X} {FX} y) (k-eq.{u} {G} {deg} {R} {X} {FX} y x)
         *> FilteredDiff.whom-comp.{u} {FX} {y.1 + 1} {y.1 + 1} {y.1 + 1} {inf} {inf} {fin (top.{u} {G} {deg} {n} y)} (filteredCouple.le-k.{u} {G} {deg} {y} idp) () <=-refl ()
                                       (filteredCouple.le-k.{u} {G} {deg} {y} idp) () idp idp (conn-k.{u} {G} {deg} {R} {X} {FX} y x)
         *> FilteredDiff.whom-unique.{u} {FX} {y.1 + 1} {y.1 + 1} {inf} {fin (top.{u} {G} {deg} {n} y)} (filteredCouple.le-k.{u} {G} {deg} {y} idp) <=-refl () () (idp *> idp) idp (conn-k.{u} {G} {deg} {R} {X} {FX} y x)
         *> inv (FilteredDiff.conn-whom.{u} {_} {_} {_} {_} FX {y.1} {y.1 + 1} {y.1} {y.1 + 1} {inf} {fin (top.{u} {G} {deg} {n} y)} (filteredCouple.le-suc y.1) ()
                                            (filteredCouple.le-suc y.1) (lo-top.{u} {G} {deg} {n} y) <=-refl <=-refl () (filteredCouple.deg-k.{u} {G} {deg} {y} idp) idp idp idp x)
         *> pmap (FilteredDiff.conn.{u} {FX} (filteredCouple.le-suc y.1) (lo-top.{u} {G} {deg} {n} y) idp) (FilteredDiff.whom-id.{u} {FX} {y.1} {fin (y.1 + 1)} <=-refl <=-refl idp x)
  }

\func filteredFrame.{u} {R : Ring.{u}} {G : AbGroup.{u}} {deg : G} {X : DiffModule.{u} G deg R} (FX : FilteredDiff X) (m : Nat)
  : WindowFrame.{u} (filteredCouple.{u} FX) (suc m) \cowith
  | WindowDiagram => filteredWindow.{u} FX (suc m)
  | M y => LHomology (FilteredDiff.Win.{u} {FX} y.1 (fin (mtop.{u} y))) y.2
  | shorten y => FilteredDiff.whom.{u} {FX} {y.1} {y.1} {fin (top.{u} y)} {fin (mtop.{u} y)} <=-refl (mtop-le.{u} y) idp
  | mrho y => FilteredDiff.whom.{u} {FX} {y.1} {y.1} {fin (mtop.{u} y)} {fin (y.1 + 1)} <=-refl (lo-mtop.{u} y) idp
  | mrho-shorten y t => FilteredDiff.whom-comp.{u} {FX} {y.1} {y.1} {y.1} {fin (top.{u} y)} {fin (mtop.{u} y)} {fin (y.1 + 1)} <=-refl (mtop-le.{u} y) <=-refl (lo-mtop.{u} y) <=-refl (lo-top.{u} y) idp idp t
                        *> FilteredDiff.whom-unique.{u} {FX} {y.1} {y.1} {fin (top.{u} y)} {fin (y.1 + 1)} <=-refl <=-refl (lo-top.{u} y) (lo-top.{u} y) (idp *> idp) idp t
  | mdelta y => FilteredDiff.conn.{u} {FX} {y.1} {mtop.{u} y} {inf} (le-mtop.{u} y) () (deg-mtop.{u} y)
  | mdelta-shorten y t => FilteredDiff.conn-whom.{u} {_} {_} {_} {_} FX {y.1} {top.{u} y} {y.1} {mtop.{u} y} {inf} {inf} (filteredWindow.le-top.{u} {G} {deg} {suc m} y) () (le-mtop.{u} y) ()
                                                 <=-refl (mtop-le.{u} y) () (filteredWindow.deg-top.{u} {G} {deg} {suc m} y) idp (deg-mtop.{u} y)
                                                 (filteredCouple.deg-i.{u} {G} {jx.{u} y} {mx.{u} y} idp) t
  | restrict {w} {y} p => FilteredDiff.whom.{u} {FX} {w.1} {y.1} {inf} {fin (mtop.{u} y)} (filteredCouple.le-j.{u} p) () (filteredCouple.deg-j.{u} p)
  | mrho-restrict {w} {y} p t => FilteredDiff.whom-comp.{u} {FX} {w.1} {y.1} {y.1} {inf} {fin (mtop.{u} y)} {fin (y.1 + 1)} (filteredCouple.le-j.{u} p) () <=-refl (lo-mtop.{u} y)
                                              (filteredCouple.le-j.{u} p) () (filteredCouple.deg-j.{u} p) idp t
                                 *> FilteredDiff.whom-unique.{u} {FX} {w.1} {y.1} {inf} {fin (y.1 + 1)} (filteredCouple.le-j.{u} p) (filteredCouple.le-j.{u} p) () () _ (filteredCouple.deg-j.{u} p) t
  | far {x} {y} p => FilteredDiff.whom.{u} {FX} {x.1} {y.1} {fin (mtop.{u} x)} {fin (mtop.{u} y)} (filteredCouple.le-i.{u} p) (far-le.{u} p) (filteredCouple.deg-i.{u} p)
  | Void x => LHomology (FilteredDiff.Win.{u} {FX} x.1 (fin x.1)) x.2
  | void-zero v => FilteredDiff.H-zero.{u} {FX} v
  | toVoid x => FilteredDiff.whom.{u} {FX} {x.1} {x.1} {fin (mtop.{u} x)} {fin x.1} <=-refl (le-mtop.{u} x) idp
  | fromVoid {x} {y} p => FilteredDiff.whom.{u} {FX} {x.1} {y.1} {fin x.1} {fin (y.1 + 1)} (filteredCouple.le-i.{u} p) (void-le.{u} p) (filteredCouple.deg-i.{u} p)
  | mrho-far {x} {y} p t =>
    \have H : y.1 + 1 <= mtop.{u} x => <=-transitive (lo-mtop.{u} y) (far-le.{u} p)
    \in FilteredDiff.whom-comp.{u} {FX} {x.1} {y.1} {y.1} {fin (mtop.{u} x)} {fin (mtop.{u} y)} {fin (y.1 + 1)} (filteredCouple.le-i.{u} p) (far-le.{u} p) <=-refl (lo-mtop.{u} y)
                     (filteredCouple.le-i.{u} p) H (filteredCouple.deg-i.{u} p) idp t
        *> FilteredDiff.whom-unique.{u} {FX} {x.1} {y.1} {fin (mtop.{u} x)} {fin (y.1 + 1)} (filteredCouple.le-i.{u} p) (filteredCouple.le-i.{u} p) H H _ (idp *> filteredCouple.deg-i.{u} p) t
        *> inv (FilteredDiff.whom-comp.{u} {FX} {x.1} {x.1} {y.1} {fin (mtop.{u} x)} {fin x.1} {fin (y.1 + 1)} <=-refl (le-mtop.{u} x) (filteredCouple.le-i.{u} p) (void-le.{u} p)
                             (filteredCouple.le-i.{u} p) H idp (filteredCouple.deg-i.{u} p) t)
  \where {
    \func top (y : Bi G) : Int => filteredWindow.top {G} {deg} {suc m} y

    \func jx (y : Bi G) : Bi G => filteredWindow.jx {G} {deg} {suc m} y

    \func mx (y : Bi G) : Bi G => (+) {Bi G} (jx y) (neg 1, 0)

    \func mtop (y : Bi G) : Int => (mx y).1

    \lemma mtop-eq (y : Bi G) : mtop y = y.1 + 1 - neg (suc m) + neg 1
      => pmap (`+ neg 1) (filteredWindow.top-eq {G} {deg} {suc m} y)

    \lemma lo-top (y : Bi G) : y.1 + 1 <= top y
      => filteredWindow.lo-top {G} {deg} {suc m} y

    \lemma mtop-le (y : Bi G) : mtop y <= top y
      => filteredCouple.le-i {G} {jx y} {mx y} idp

    \lemma le-mtop (y : Bi G) : y.1 <= mtop y
      => transportInv (y.1 <=) (mtop-eq y) (linarith : y.1 <= y.1 + 1 - neg (suc m) + neg 1)

    \lemma lo-mtop (y : Bi G) : y.1 + 1 <= mtop y
      => transportInv (y.1 + 1 <=) (mtop-eq y) (linarith : y.1 + 1 <= y.1 + 1 - neg (suc m) + neg 1)

    \lemma deg-mtop (y : Bi G) : y.2 + deg = (mx y).2
      => filteredWindow.deg-top {G} {deg} {suc m} y *> filteredCouple.deg-i {G} {jx y} {mx y} idp

    \lemma far-le {x y : Bi G} (p : (+) {Bi G} x (neg 1, 0) = y) : mtop y <= mtop x \elim y, p
      | _, idp => rewrite (mtop-eq x, mtop-eq ((+) {Bi G} x (neg 1, 0)))
                    (linarith : x.1 + neg 1 + 1 - neg (suc m) + neg 1 <= x.1 + 1 - neg (suc m) + neg 1)

    \lemma void-le {x y : Bi G} (p : (+) {Bi G} x (neg 1, 0) = y) : y.1 + 1 <= x.1 \elim y, p
      | _, idp => (linarith : x.1 + neg 1 + 1 <= x.1)
  }
