\import Algebra.Group
\import Algebra.Group.Cochain
\import Algebra.Group.Cokernel
\import Algebra.Group.GradedComplex
\import Algebra.Group.GroupHom
\import Algebra.Group.Pairing
\import Algebra.Group.SubGroup
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Pointed.SubPointed
\import Algebra.Ring.DirectSum
\import Algebra.Ring.RingHom
\import Logic
\import Paths
\import Paths.Meta
\import Relation.Equivalence

\record CochainPairing (X Y Z : CochainComplex) \extends GradedPairing {
  | H => X.D
  | K => Y.D
  | L => Z.D
  | leibniz (p q : Nat) (a : X.D p) (b : Y.D q)
    : Z.delta (p Nat.+ q) (mul p q a b) = mul (suc p) q (X.delta p a) b + signed p (mul p (suc q) a (Y.delta q b))

  \lemma cocycle-mul {p q : Nat} {a : X.D p} {b : Y.D q} (ca : X.IsCycle p a) (cb : Y.IsCycle q b) : Z.IsCycle (p Nat.+ q) (mul p q a b)
    => leibniz p q a b *> pmap2 (+) (pmap (mul (suc p) q __ b) ca *> Pairing.zro-left (mul (suc p) q))
                                    (pmap (\lam y => signed p (mul p (suc q) a y)) cb *> pmap (signed p) (Pairing.zro-right (mul p (suc q))) *> signed.zro p) *> zro-left

  \lemma coboundary-left {p q : Nat} {a : X.Cycles p} (b : Y.Cycles q) (h : X.IsBoundary p a)
    : Z.IsBoundary (p Nat.+ q) (Pairing.restrict (mul p q) (cocycle-mul {\this} {p} {q}) a b) => \case \elim p, \elim a, \elim h \with {
      | 0, a, inP (u, e) => transport (Z.IsBoundary q) (ext (inv (Pairing.zro-left (mul 0 q)) *> pmap (\lam x => mul 0 q x.1 b.1) e))
                                      (SubAddPointed.contains_zro {Z.IsBoundary q})
      | suc p, a, inP (u, e) => inP (mul p q u b.1, ext (leibniz p q u b.1
          *> pmap2 (+) (pmap (\lam x => mul (suc p) q x.1 b.1) e)
                       (pmap (\lam y => signed p (mul p (suc q) u y)) b.2 *> pmap (signed p) (Pairing.zro-right (mul p (suc q))) *> signed.zro p)
          *> zro-right))
    }

  \lemma coboundary-right {p q : Nat} (a : X.Cycles p) {b : Y.Cycles q} (h : Y.IsBoundary q b)
    : Z.IsBoundary (p Nat.+ q) (Pairing.restrict (mul p q) (cocycle-mul {\this} {p} {q}) a b) => \case \elim q, \elim b, \elim h \with {
      | 0, b, inP (v, e) => transport (Z.IsBoundary p) (ext (inv (Pairing.zro-right (mul p 0)) *> pmap (\lam y => mul p 0 a.1 y.1) e))
                                      (SubAddPointed.contains_zro {Z.IsBoundary p})
      | suc q, b, inP (v, e) => inP (signed p (mul p q a.1 v), ext (signed.hom (Z.delta (p Nat.+ q)) p _
          *> pmap (signed p) (leibniz p q a.1 v *> pmap (`+ _) (pmap (mul (suc p) q __ v) a.2 *> Pairing.zro-left (mul (suc p) q)) *> zro-left)
          *> signed.twice p _ *> pmap (\lam y => mul p (suc q) a.1 y.1) e))
    }

  \func cohomologyPairing : GradedPairing (Homology X) (Homology Y) (Homology Z)
    => GradedPairing.quotient (GradedPairing.sub \this X.IsCycle Y.IsCycle Z.IsCycle cocycle-mul) X.IsBoundary Y.IsBoundary Z.IsBoundary coboundary-left coboundary-right
} \where
  \lemma cohomology-natural {X Y Z X' Y' Z' : CochainComplex} (P : CochainPairing X Y Z) (P' : CochainPairing X' Y' Z')
                            (F : CochainMap X X') (G : CochainMap Y Y') (H : CochainMap Z Z')
                            (sq : \Pi (p q : Nat) (a : X.D p) (b : Y.D q) -> H.f (p Nat.+ q) (P.mul p q a b) = P'.mul p q (F.f p a) (G.f q b))
                            {p q : Nat} (x : Homology X p) (y : Homology Y q)
    : H.homology (p Nat.+ q) (P.cohomologyPairing.mul p q x y) = P'.cohomologyPairing.mul p q (F.homology p x) (G.homology q y) \elim x, y
    | in~ a, in~ b => pmap in~ (ext (sq p q a.1 b.1))

\record DGA \extends CochainComplex, GradedProduct {
  | H => D
  | delta-mul (p q : Nat) (a : D p) (b : D q) : delta (p Nat.+ q) (mul p q a b) = mul (suc p) q (delta p a) b + signed p (mul p (suc q) a (delta q b))

  \func pairing : CochainPairing \this \this \this \cowith
    | mul => mul
    | leibniz => delta-mul

  \lemma one-cocycle : IsCycle 0 one
    => AddGroup.cancel-left (delta 0 one) (inv (inv (pmap (delta 0) (one-left 0 one)) *> delta-mul 0 0 one one *> pmap2 (+) (one-right 1 _) (one-left 1 _))
                                           *> inv zro-right)

  \func cohomologyProduct : GradedProduct (Homology \this)
    => GradedProduct.quotient (GradedProduct.sub \this IsCycle pairing.cocycle-mul one-cocycle) IsBoundary pairing.coboundary-left pairing.coboundary-right
}

\record CDGA \extends DGA, GradedCommProduct {
  \func cohomologyCommProduct : GradedCommProduct (Homology \this)
    => GradedCommProduct.quotient (GradedCommProduct.sub \this IsCycle pairing.cocycle-mul one-cocycle) IsBoundary pairing.coboundary-left pairing.coboundary-right
}

\record DGAMap (A B : DGA) \extends CochainMap {
  | CX => A
  | CY => B
  | f-mul (p q : Nat) (a : A.D p) (b : A.D q) : f (p Nat.+ q) (A.mul p q a b) = B.mul p q (f p a) (f q b)
  | f-one : f 0 A.one = B.one
} \where {
  \lemma cohomology-mul {A B : DGA} (F : DGAMap A B) (p q : Nat) (x : Homology A p) (y : Homology A q)
    : F.homology (p Nat.+ q) (A.cohomologyProduct.mul p q x y) = B.cohomologyProduct.mul p q (F.homology p x) (F.homology q y)
    => CochainPairing.cohomology-natural A.pairing B.pairing F F F F.f-mul x y

  \func cohomologyRing {A B : DGA} (F : DGAMap A B) : RingHom (DirectSum A.cohomologyProduct) (DirectSum B.cohomologyProduct)
    => DirectSum.ringMap {A.cohomologyProduct} {B.cohomologyProduct} F.homology (cohomology-mul F) (pmap in~ (ext F.f-one))
}

\record DGModule (A : DGA) \extends CochainComplex, GradedModule {
  | Alg => A
  | K => D
  | delta-act (p q : Nat) (a : A.D p) (x : D q) : delta (p Nat.+ q) (mul p q a x) = mul (suc p) q (A.delta p a) x + signed p (mul p (suc q) a (delta q x))

  \func pairing : CochainPairing A \this \this \cowith
    | mul => mul
    | leibniz => delta-act
} \where
  \func cohomologyModule {A : DGA} (M : DGModule A) : GradedModule A.cohomologyProduct
    => GradedModule.quotient (GradedModule.sub M A.IsCycle A.pairing.cocycle-mul A.one-cocycle M.IsCycle M.pairing.cocycle-mul)
                             A.IsBoundary A.pairing.coboundary-left A.pairing.coboundary-right M.IsBoundary M.pairing.coboundary-left M.pairing.coboundary-right
