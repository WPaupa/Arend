\open FSeriesRing (PairsFinSet)

\func sum-below {G : AddMonoid} (f : Nat -> G) (N : Nat) : G \elim N
  | 0 => 0
  | suc N => sum-below f N + f N
  \where {
    \lemma zero {G : AddMonoid} {f : Nat -> G} {N : Nat} (z : \Pi (n : Nat) -> n < N -> f n = 0) : sum-below f N = 0 \elim N
      | 0 => idp
      | suc N => pmap2 (+) (zero \lam n n<N => z n (n<N <∘ id<suc)) (z N id<suc) *> zro-left

    \lemma pad {G : AddMonoid} {f : Nat -> G} {N : Nat} (z : \Pi (n : Nat) -> N <= n -> f n = 0) (k : Nat) : sum-below f (N Nat.+ k) = sum-below f N \elim k
      | 0 => idp
      | suc k => pmap2 (+) (pad z k) (z (N Nat.+ k) (NatSemiring.<=_+ <=-refl zero<=_)) *> zro-right

    \lemma bounds {G : AddMonoid} {f : Nat -> G} {N M : Nat} (zN : \Pi (n : Nat) -> N <= n -> f n = 0) (zM : \Pi (n : Nat) -> M <= n -> f n = 0)
      : sum-below f N = sum-below f M
      => inv (pad zN M) *> pmap (sum-below f) NatSemiring.+-comm *> pad zM N

    \lemma hom {G H : AddMonoid} (h : AddMonoidHom G H) (f : Nat -> G) (N : Nat) : h (sum-below f N) = sum-below (\lam n => h (f n)) N \elim N
      | 0 => h.func-zro
      | suc N => h.func-+ *> pmap (`+ _) (hom h f N)

    \lemma add {G : AbMonoid} (f g : Nat -> G) (N : Nat) : sum-below (\lam n => f n + g n) N = sum-below f N + sum-below g N \elim N
      | 0 => inv zro-left
      | suc N => pmap (`+ _) (add f g N) *> equation

    \lemma unique {G : AddMonoid} {f : Nat -> G} {N n : Nat} (n<N : n < N) (z : \Pi (k : Nat) -> k /= n -> f k = 0) : sum-below f N = f n \elim N
      | suc N => \case decideEq n N \with {
        | yes e => pmap (`+ _) (zero \lam k _ => z k \lam _ => absurd linarith) *> zro-left *> pmap f (inv e)
        | no ne => pmap2 (+) (unique (LinearOrder.<=_/= (<_suc_<= n<N) ne) z) (z N (\lam p => ne (inv p))) *> zro-right
      }
  }

\func signed {G : AddGroup} (k : Nat) (a : G) : G \elim k
  | 0 => a
  | 1 => negative a
  | suc (suc k) => signed k a
  \where {
    \lemma twice {G : AddGroup} (k : Nat) (a : G) : signed k (signed k a) = a \elim k
      | 0 => idp
      | 1 => AddGroup.negative-isInv
      | suc (suc k) => twice k a

    \lemma hom {G H : AddGroup} (f : AddGroupHom G H) (k : Nat) (a : G) : f (signed k a) = signed k (f a) \elim k
      | 0 => idp
      | 1 => f.func-negative
      | suc (suc k) => hom f k a

    \lemma step {G : AddGroup} (k : Nat) (a : G) : signed (suc k) a = negative (signed k a) \elim k
      | 0 => idp
      | 1 => inv AddGroup.negative-isInv
      | suc (suc k) => step k a

    \lemma add {G : AddGroup} (k l : Nat) (a : G) : signed (k Nat.+ l) a = signed k (signed l a) \elim k
      | 0 => idp
      | 1 => step l a
      | suc (suc k) => add k l a

    \lemma double {G : AddGroup} (k : Nat) (a : G) : signed (k Nat.+ k) a = a \elim k
      | 0 => idp
      | suc k => double k a

    \lemma zro {G : AddGroup} (k : Nat) : signed {G} k 0 = 0 \elim k
      | 0 => idp
      | 1 => AddGroup.negative_zro
      | suc (suc k) => zro k

    \lemma odd-mul {G : AddGroup} (k l : Nat) (a : G) : signed (suc (k Nat.+ k) Nat.* suc (l Nat.+ l)) a = negative a
      => step _ a *> pmap negative (add _ (k Nat.+ k) a *> pmap (signed _) (double k a) *> pmap (signed __ a) NatSemiring.ldistr *> double _ a)
  }

\record GradedPairing (H K L : Nat -> AbGroup)
  | mul (p q : Nat) : Pairing (H p) (K q) (L (p Nat.+ q))
  \where {
    \func sub (m : GradedPairing) (S : \Pi (n : Nat) -> SubAddGroup (m.H n)) (T : \Pi (n : Nat) -> SubAddGroup (m.K n)) (U : \Pi (n : Nat) -> SubAddGroup (m.L n))
              (c : \Pi {p q : Nat} {a : m.H p} {b : m.K q} -> S p a -> T q b -> U (p Nat.+ q) (m.mul p q a b))
      : GradedPairing (\lam n => IAbGroup (S n)) (\lam n => IAbGroup (T n)) (\lam n => IAbGroup (U n)) \cowith
      | mul p q => Pairing.restrict (m.mul p q) (c {p} {q})

    \func quotient (m : GradedPairing) (S : \Pi (n : Nat) -> SubAddGroup (m.H n)) (T : \Pi (n : Nat) -> SubAddGroup (m.K n)) (U : \Pi (n : Nat) -> SubAddGroup (m.L n))
                   (l : \Pi {p q : Nat} {a : m.H p} (b : m.K q) -> S p a -> U (p Nat.+ q) (m.mul p q a b))
                   (r : \Pi {p q : Nat} (a : m.H p) {b : m.K q} -> T q b -> U (p Nat.+ q) (m.mul p q a b))
      : GradedPairing (\lam n => AbQuotient (S n)) (\lam n => AbQuotient (T n)) (\lam n => AbQuotient (U n)) \cowith
      | mul p q => Pairing.quotient (m.mul p q) (l {p} {q}) (r {p} {q})

    \func const {A B C : AbGroup} (m : Pairing A B C) : GradedPairing (\lam _ => A) (\lam _ => B) (\lam _ => C) \cowith
      | mul _ _ => m

    \func relabel (m : GradedPairing) {H' K' L' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (H' n) (m.H n))
                  (g : \Pi (n : Nat) -> AddGroupHom (K' n) (m.K n)) (h : \Pi (n : Nat) -> AddGroupHom (m.L n) (L' n)) : GradedPairing H' K' L' \cowith
      | mul p q => Pairing.compose (m.mul p q) (f p) (g q) (h (p Nat.+ q))

    \lemma transport-hom {G G' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (G n) (G' n)) {n m : Nat} (e : n = m) (x : G n)
      : f m (transport (\lam k => G k) e x) = transport (\lam k => G' k) e (f n x) \elim m, e
      | _, idp => idp

    \lemma transport-sub {G : Nat -> AbGroup} (S : \Pi (n : Nat) -> SubAddGroup (G n)) {n m : Nat} (e : n = m) (x : IAbGroup (S n))
      : (transport (\lam k => IAbGroup (S k)) e x).1 = transport (\lam k => G k) e x.1 \elim m, e
      | _, idp => idp
  }

\record GradedProduct \extends GradedPairing {
  | K => H
  | L => H
  | one : H 0
  | mul-assoc (p q r : Nat) (a : H p) (b : H q) (c : H r)
    : mul (p Nat.+ q) r (mul p q a b) c = transport (\lam n => H n) (inv NatSemiring.+-assoc) (mul p (q Nat.+ r) a (mul q r b c))
  | one-left (q : Nat) (b : H q) : mul 0 q one b = b
  | one-right (p : Nat) (a : H p) : mul p 0 a one = a

  \func cast {n m : Nat} (e : n = m) : AddGroupHom (H n) (H m) \cowith
    | func => transport (\lam k => H k) e
    | func-+ => cast-+ e

  \lemma cast-+ {n m : Nat} (e : n = m) {a b : H n} : transport (\lam k => H k) e (a + b) = transport (\lam k => H k) e a + transport (\lam k => H k) e b \elim m, e
    | _, idp => idp

  \lemma cast-comp {n m k : Nat} (e : n = m) (e' : m = k) (c : H n) : cast e' (cast e c) = cast (e *> e') c \elim k, e'
    | _, idp => idp

  \lemma cast-unique {n m : Nat} (e e' : n = m) (c : H n) : cast e c = cast e' c
    => pmap (\lam e'' => cast e'' c) prop-pi

  \lemma cast-left {p p' : Nat} (e : p = p') (q : Nat) (a : H p) (b : H q)
    : mul p' q (cast e a) b = cast (pmap (Nat.`+ q) e) (mul p q a b) \elim p', e
    | _, idp => idp
} \where {
  \func sub (D : GradedProduct) (S : \Pi (n : Nat) -> SubAddGroup (D.H n))
            (c : \Pi {p q : Nat} {a : D.H p} {b : D.H q} -> S p a -> S q b -> S (p Nat.+ q) (D.mul p q a b)) (c1 : S 0 D.one)
    : GradedProduct (\lam n => IAbGroup (S n)) \cowith
    | mul => GradedPairing.mul {GradedPairing.sub D S S S c}
    | one => (D.one, c1)
    | mul-assoc p q r a b c => ext (D.mul-assoc p q r a.1 b.1 c.1 *> inv (GradedPairing.transport-sub S _ _))
    | one-left q b => ext (D.one-left q b.1)
    | one-right p a => ext (D.one-right p a.1)

  \func quotient (D : GradedProduct) (I : \Pi (n : Nat) -> SubAddGroup (D.H n))
                 (l : \Pi {p q : Nat} {a : D.H p} (b : D.H q) -> I p a -> I (p Nat.+ q) (D.mul p q a b))
                 (r : \Pi {p q : Nat} (a : D.H p) {b : D.H q} -> I q b -> I (p Nat.+ q) (D.mul p q a b))
    : GradedProduct (\lam n => AbQuotient (I n)) \cowith
    | mul => GradedPairing.mul {GradedPairing.quotient D I I I l r}
    | one => in~ D.one
    | mul-assoc p q k a b c => \case \elim a, \elim b, \elim c \with {
      | in~ x, in~ y, in~ z => pmap in~ (D.mul-assoc p q k x y z) *> inv (AbQuotient.transport-in~ I _ _)
    }
    | one-left q b => \case \elim b \with {
      | in~ y => pmap in~ (D.one-left q y)
    }
    | one-right p a => \case \elim a \with {
      | in~ x => pmap in~ (D.one-right p x)
    }

  \func relabel (D : GradedProduct) {H' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (D.H n) (H' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
    : GradedProduct H' \cowith
    | mul => GradedPairing.mul {GradedPairing.relabel D (inverse f e) (inverse f e) f}
    | one => f 0 D.one
    | mul-assoc p q r a _ c => pmap (\lam x => f _ (D.mul _ r x ((e r).ret c))) ((e _).ret_f _) *> pmap (f _) (D.mul-assoc p q r _ _ _)
                               *> GradedPairing.transport-hom f _ _ *> pmap (transport (\lam n => H' n) _) (pmap (\lam y => f _ (D.mul p _ ((e p).ret a) y)) (inv ((e _).ret_f _)))
    | one-left q b => pmap (\lam x => f q (D.mul 0 q x ((e q).ret b))) ((e 0).ret_f _) *> pmap (f q) (D.one-left q _) *> (e q).f_ret b
    | one-right p a => pmap (\lam y => f p (D.mul p 0 ((e p).ret a) y)) ((e 0).ret_f _) *> pmap (f p) (D.one-right p _) *> (e p).f_ret a
    \where {
      \func inverse {G G' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (G n) (G' n)) (e : \Pi (n : Nat) -> QEquiv (f n)) (n : Nat) : AddGroupHom (G' n) (G n)
        => AddGroupHom.inverse (f n) (e n)

      \lemma mul-map (D : GradedProduct) {H' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (D.H n) (H' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
                     (p q : Nat) (a : D.H p) (b : D.H q) : f (p Nat.+ q) (D.mul p q a b) = (relabel D f e).mul p q (f p a) (f q b)
        => inv (pmap2 (\lam x y => f (p Nat.+ q) (D.mul p q x y)) ((e p).ret_f a) ((e q).ret_f b))

      \func ringMap (D : GradedProduct) {H' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (D.H n) (H' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
        : RingHom (DirectSum D) (DirectSum (relabel D f e))
        => DirectSum.ringMap {D} {relabel D f e} f (mul-map D f e) idp

      \func ringEquiv (D : GradedProduct) {H' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (D.H n) (H' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
        : QEquiv (ringMap D f e) \cowith
        | ret => DirectSum.ringMap {relabel D f e} {D} (inverse f e) (\lam p q _ _ => (e (p Nat.+ q)).ret_f _) ((e 0).ret_f _)
        | ret_f _ => DirectSum.sum-ext {D} \lam n => (e n).ret_f _
        | f_sec _ => DirectSum.sum-ext {relabel D f e} \lam n => (e n).f_ret _

      \func Sub {G G' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (G n) (G' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
                (S : \Pi (n : Nat) -> SubAddGroup (G n)) (n : Nat) : SubAddGroup (G' n)
        => SubAddGroup.preimage (inverse f e n) (S n)

      \func subMap {G G' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (G n) (G' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
                   (S : \Pi (n : Nat) -> SubAddGroup (G n)) (n : Nat) : AddGroupHom (IAbGroup (S n)) (IAbGroup (Sub f e S n))
        => IAbGroup.map {G n} {G' n} {S n} {Sub f e S n} (f n) (\lam c => transportInv (S n).contains ((e n).ret_f _) c)

      \func subEquiv {G G' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (G n) (G' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
                     (S : \Pi (n : Nat) -> SubAddGroup (G n)) (n : Nat) : QEquiv (subMap f e S n) \cowith
        | ret => IAbGroup.map {G' n} {G n} {Sub f e S n} {S n} (inverse f e n) (\lam c => c)
        | ret_f x => ext ((e n).ret_f x.1)
        | f_sec y => ext ((e n).f_ret y.1)

      \func quotientMap {G G' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (G n) (G' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
                        (S : \Pi (n : Nat) -> SubAddGroup (G n)) (n : Nat) : AddGroupHom (AbQuotient (S n)) (AbQuotient (Sub f e S n))
        => AbQuotient.map {G n} {G' n} {S n} {Sub f e S n} (f n) (\lam c => transportInv (S n).contains ((e n).ret_f _) c)

      \func quotientEquiv {G G' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (G n) (G' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
                          (S : \Pi (n : Nat) -> SubAddGroup (G n)) (n : Nat) : QEquiv (quotientMap f e S n) \cowith
        | ret => AbQuotient.map {G' n} {G n} {Sub f e S n} {S n} (inverse f e n) (\lam c => c)
        | ret_f x => \case \elim x \with {
          | in~ a => pmap in~ ((e n).ret_f a)
        }
        | f_sec y => \case \elim y \with {
          | in~ b => pmap in~ ((e n).f_ret b)
        }

      \lemma sub-mul (D : GradedProduct) {H' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (D.H n) (H' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
                     (S : \Pi (n : Nat) -> SubAddGroup (D.H n)) (c : \Pi {p q : Nat} {a : D.H p} {b : D.H q} -> S p a -> S q b -> S (p Nat.+ q) (D.mul p q a b))
                     (c1 : S 0 D.one) {p q : Nat} (x : IAbGroup (Sub f e S p)) (y : IAbGroup (Sub f e S q))
        : (sub (relabel D f e) (Sub f e S) (\lam sa sb => transportInv (S _).contains ((e _).ret_f _) (c sa sb)) (transportInv (S 0).contains ((e 0).ret_f _) c1)).mul p q x y
          = (relabel (sub D S c c1) {\lam n => IAbGroup (Sub f e S n)} (subMap f e S) (subEquiv f e S)).mul p q x y
        => idp

      \lemma quotient-mul (D : GradedProduct) {H' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (D.H n) (H' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
                          (I : \Pi (n : Nat) -> SubAddGroup (D.H n))
                          (l : \Pi {p q : Nat} {a : D.H p} (b : D.H q) -> I p a -> I (p Nat.+ q) (D.mul p q a b))
                          (r : \Pi {p q : Nat} (a : D.H p) {b : D.H q} -> I q b -> I (p Nat.+ q) (D.mul p q a b))
                          {p q : Nat} (x : AbQuotient (Sub f e I p)) (y : AbQuotient (Sub f e I q))
        : (quotient (relabel D f e) (Sub f e I) (\lam _ h => transportInv (I _).contains ((e _).ret_f _) (l _ h))
                                               (\lam _ h => transportInv (I _).contains ((e _).ret_f _) (r _ h))).mul p q x y
          = (relabel (quotient D I l r) {\lam n => AbQuotient (Sub f e I n)} (quotientMap f e I) (quotientEquiv f e I)).mul p q x y \elim x, y
        | in~ a, in~ b => idp
    }

  \func const (R : Ring) : GradedProduct (\lam _ => R) \cowith
    | mul _ _ => Pairing.mul R
    | one => 1
    | mul-assoc _ _ _ _ _ _ => R.*-assoc
    | one-left _ _ => R.ide-left
    | one-right _ _ => R.ide-right

  \func zero : GradedProduct (\lam _ => TrivialAbGroup) \cowith
    | mul _ _ => Pairing.zero
    | one => ()
    | mul-assoc _ _ _ _ _ _ => idp
    | one-left _ _ => idp
    | one-right _ _ => idp

  \func unit.{u} (R : Ring.{u}) : GradedProduct (unitFamily R) \cowith
    | mul => unitMul R
    | one => R.ide
    | mul-assoc => assoc R
    | one-left => unit-left R
    | one-right => unit-right R
    \where {
      \func unitFamily.{u} (R : AbGroup.{u}) (n : Nat) : AbGroup.{u} \elim n
        | 0 => R
        | suc _ => TrivialAbGroup

      \func unitMul.{u} (R : Ring.{u}) (p q : Nat) : Pairing (unitFamily R p) (unitFamily R q) (unitFamily R (p Nat.+ q)) \elim p, q
        | 0, 0 => Pairing.mul R
        | 0, suc q => Pairing.zero
        | suc p, q => Pairing.zero

      \lemma assoc.{u} (R : Ring.{u}) (p q r : Nat) (a : unitFamily R p) (b : unitFamily R q) (c : unitFamily R r)
        : unitMul R (p Nat.+ q) r (unitMul R p q a b) c
          = transport (\lam n => unitFamily R n) (inv NatSemiring.+-assoc) (unitMul R p (q Nat.+ r) a (unitMul R q r b c)) \elim p, q, r
        | 0, 0, 0 => R.*-assoc *> pmap (transport (\lam n => unitFamily R n) __ (a R.* (b R.* c))) (prop-pi {_} {idp})
        | 0, 0, suc r => idp
        | 0, suc q, r => idp
        | suc p, q, r => idp

      \lemma unit-left.{u} (R : Ring.{u}) (q : Nat) (b : unitFamily R q) : unitMul R 0 q R.ide b = b \elim q
        | 0 => R.ide-left
        | suc q => idp

      \lemma unit-right.{u} (R : Ring.{u}) (p : Nat) (a : unitFamily R p) : unitMul R p 0 a R.ide = a \elim p
        | 0 => R.ide-right
        | suc p => idp
    }
}

\record GradedCommProduct \extends GradedProduct {
  | koszul (p q : Nat) (a : H p) (b : H q) : mul p q a b = signed (q Nat.* p) (cast NatSemiring.+-comm (mul q p b a))

  \lemma anticomm (p q : Nat) (a : H (suc (p Nat.+ p))) (b : H (suc (q Nat.+ q)))
    : mul (suc (p Nat.+ p)) (suc (q Nat.+ q)) a b = negative (cast (NatSemiring.+-comm {suc (q Nat.+ q)} {suc (p Nat.+ p)}) (mul (suc (q Nat.+ q)) (suc (p Nat.+ p)) b a))
    => koszul _ _ a b *> signed.odd-mul q p _

  \lemma odd-square (p : Nat) (a : H (suc (p Nat.+ p)))
    : mul (suc (p Nat.+ p)) (suc (p Nat.+ p)) a a + mul (suc (p Nat.+ p)) (suc (p Nat.+ p)) a a = 0
    => pmap (_ +) (anticomm p p a a *> pmap negative (cast-unique _ idp _)) *> negative-right
} \where {
  \func sub (D : GradedCommProduct) (S : \Pi (n : Nat) -> SubAddGroup (D.H n))
            (c : \Pi {p q : Nat} {a : D.H p} {b : D.H q} -> S p a -> S q b -> S (p Nat.+ q) (D.mul p q a b)) (c1 : S 0 D.one)
    : GradedCommProduct (\lam n => IAbGroup (S n)) \cowith
    | GradedProduct => GradedProduct.sub D S c c1
    | koszul p q a b => ext (D.koszul p q a.1 b.1 *> inv (signed.hom IAddGroup.embed _ _ *> pmap (signed _) (GradedPairing.transport-sub S _ _)))

  \func quotient (D : GradedCommProduct) (I : \Pi (n : Nat) -> SubAddGroup (D.H n))
                 (l : \Pi {p q : Nat} {a : D.H p} (b : D.H q) -> I p a -> I (p Nat.+ q) (D.mul p q a b))
                 (r : \Pi {p q : Nat} (a : D.H p) {b : D.H q} -> I q b -> I (p Nat.+ q) (D.mul p q a b))
    : GradedCommProduct (\lam n => AbQuotient (I n)) \cowith
    | GradedProduct => GradedProduct.quotient D I l r
    | koszul p q a b => \case \elim a, \elim b \with {
      | in~ x, in~ y => pmap in~ (D.koszul p q x y) *> signed.hom (AbQuotient.proj (I _)) _ _ *> pmap (signed _) (inv (AbQuotient.transport-in~ I _ _))
    }

  \func relabel (D : GradedCommProduct) {H' : Nat -> AbGroup} (f : \Pi (n : Nat) -> AddGroupHom (D.H n) (H' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
    : GradedCommProduct H' \cowith
    | GradedProduct => GradedProduct.relabel D f e
    | koszul p q _ _ => pmap (f _) (D.koszul p q _ _) *> signed.hom (f _) _ _ *> pmap (signed _) (GradedPairing.transport-hom f _ _)
}

\record GradedModule (Alg : GradedProduct) \extends GradedPairing {
  | H => Alg.H
  | L => K
  | act-assoc (p q r : Nat) (a : Alg.H p) (b : Alg.H q) (x : K r)
    : mul (p Nat.+ q) r (Alg.mul p q a b) x = transport (\lam n => K n) (inv NatSemiring.+-assoc) (mul p (q Nat.+ r) a (mul q r b x))
  | act-ide (r : Nat) (x : K r) : mul 0 r Alg.one x = x
} \where {
  \func sub {A : GradedProduct} (M : GradedModule A) (SA : \Pi (n : Nat) -> SubAddGroup (A.H n))
            (cA : \Pi {p q : Nat} {a : A.H p} {b : A.H q} -> SA p a -> SA q b -> SA (p Nat.+ q) (A.mul p q a b)) (c1 : SA 0 A.one)
            (S : \Pi (n : Nat) -> SubAddGroup (M.K n)) (c : \Pi {p q : Nat} {a : A.H p} {x : M.K q} -> SA p a -> S q x -> S (p Nat.+ q) (M.mul p q a x))
    : GradedModule (GradedProduct.sub A SA cA c1) \cowith
    | K n => IAbGroup (S n)
    | mul => GradedPairing.mul {GradedPairing.sub M SA S S c}
    | act-assoc p q r a b x => ext (M.act-assoc p q r a.1 b.1 x.1 *> inv (GradedPairing.transport-sub S _ _))
    | act-ide r x => ext (M.act-ide r x.1)

  \func quotient {A : GradedProduct} (M : GradedModule A) (IA : \Pi (n : Nat) -> SubAddGroup (A.H n))
                 (lA : \Pi {p q : Nat} {a : A.H p} (b : A.H q) -> IA p a -> IA (p Nat.+ q) (A.mul p q a b))
                 (rA : \Pi {p q : Nat} (a : A.H p) {b : A.H q} -> IA q b -> IA (p Nat.+ q) (A.mul p q a b))
                 (I : \Pi (n : Nat) -> SubAddGroup (M.K n))
                 (l : \Pi {p q : Nat} {a : A.H p} (x : M.K q) -> IA p a -> I (p Nat.+ q) (M.mul p q a x))
                 (r : \Pi {p q : Nat} (a : A.H p) {x : M.K q} -> I q x -> I (p Nat.+ q) (M.mul p q a x))
    : GradedModule (GradedProduct.quotient A IA lA rA) \cowith
    | K n => AbQuotient (I n)
    | mul => GradedPairing.mul {GradedPairing.quotient M IA I I l r}
    | act-assoc p q k a b x => \case \elim a, \elim b, \elim x \with {
      | in~ a', in~ b', in~ x' => pmap in~ (M.act-assoc p q k a' b' x') *> inv (AbQuotient.transport-in~ I _ _)
    }
    | act-ide k x => \case \elim x \with {
      | in~ x' => pmap in~ (M.act-ide k x')
    }

  \func const {R : Ring} (M : LModule R) : GradedModule (GradedProduct.const R) \cowith
    | K _ => M
    | mul _ _ => Pairing.action M
    | act-assoc _ _ _ _ _ _ => M.*c-assoc
    | act-ide _ _ => M.ide_*c

  \func relabel {A : GradedProduct} (M : GradedModule A) {H' K' : Nat -> AbGroup}
                (f : \Pi (n : Nat) -> AddGroupHom (A.H n) (H' n)) (e : \Pi (n : Nat) -> QEquiv (f n))
                (g : \Pi (n : Nat) -> AddGroupHom (M.K n) (K' n)) (eg : \Pi (n : Nat) -> QEquiv (g n))
    : GradedModule (GradedProduct.relabel A f e) \cowith
    | K => K'
    | mul => GradedPairing.mul {GradedPairing.relabel M (GradedProduct.relabel.inverse f e) (GradedProduct.relabel.inverse g eg) g}
    | act-assoc p q r a _ x => pmap (\lam y => g _ (M.mul _ r y ((eg r).ret x))) ((e _).ret_f _) *> pmap (g _) (M.act-assoc p q r _ _ _)
                               *> GradedPairing.transport-hom g _ _ *> pmap (transport (\lam n => K' n) _) (pmap (\lam y => g _ (M.mul p _ ((e p).ret a) y)) (inv ((eg _).ret_f _)))
    | act-ide r x => pmap (\lam y => g r (M.mul 0 r y ((eg r).ret x))) ((e 0).ret_f _) *> pmap (g r) (M.act-ide r _) *> (eg r).f_ret x
}

\func DirectSum (D : GradedProduct) : Ring \cowith
  | E => \Sigma (x : \Pi (n : Nat) -> D.H n) (∃ (N : Nat) (\Pi (n : Nat) -> N <= n -> x n = 0))
  | zro => (\lam _ => 0, inP (0, \lam _ _ => idp))
  | + x y => (\lam n => x.1 n + y.1 n, \case x.2, y.2 \with {
    | inP (N, f), inP (M, g) => inP (N Nat.+ M, \lam n _ => pmap2 (+) (f n linarith) (g n linarith) *> zro-left)
  })
  | zro-left => sum-ext \lam _ => zro-left
  | +-assoc => sum-ext \lam _ => +-assoc
  | +-comm => sum-ext \lam _ => +-comm
  | negative x => (\lam n => negative (x.1 n), \case x.2 \with {
    | inP (N, f) => inP (N, \lam n le => pmap negative (f n le) *> AddGroup.negative_zro)
  })
  | negative-left => sum-ext \lam _ => negative-left
  | ide => (unit D, inP (1, \lam _ _ => unit-suc D (\lam _ => absurd linarith)))
  | * x y => (\lam n => conv D x.1 y.1 n, \case x.2, y.2 \with {
    | inP (N, f), inP (M, g) => inP (N Nat.+ M, \lam n _ => AbMonoid.FinSum_zro {D.H n} {PairsFinSet n} \lam s => \case LinearOrder.dec<_<= s.1 N \with {
      | inl s1<N => conv-zero-right D x.1 y.1 s (g s.2 (linarith s.3))
      | inr N<=s1 => conv-zero-left D x.1 y.1 s (f s.1 N<=s1)
    })
  })
  | ide-left {x} => sum-ext \lam n => AbMonoid.FinSum-unique {D.H n} {PairsFinSet n} (0, n, idp)
      (\lam s s/=0 => conv-zero-left D (unit D) x.1 s (unit-suc D \lam p => s/=0 (ext (p, pmap (Nat.`+ s.2) (inv p) *> s.3)))) *> D.cast-unique _ idp _ *> D.one-left n (x.1 n)
  | ide-right {x} => sum-ext \lam n => AbMonoid.FinSum-unique {D.H n} {PairsFinSet n} (n, 0, idp)
      (\lam s s/=0 => conv-zero-right D x.1 (unit D) s (unit-suc D \lam p => s/=0 (ext (pmap (s.1 Nat.+) (inv p) *> s.3, p)))) *> D.cast-unique _ idp _ *> D.one-right n (x.1 n)
  | *-assoc {x} {y} {z} => sum-ext \lam n => conv-assoc D x.1 y.1 z.1 n
  | ldistr => sum-ext \lam n => AbMonoid.FinSum-ext {D.H n} {PairsFinSet n}
                                  (\lam s => pmap (D.cast s.3) (Pairing.ldistr {D.mul s.1 s.2}) *> AddGroupHom.func-+ {D.cast s.3})
                                *> AbMonoid.FinSum_+
  | rdistr => sum-ext \lam n => AbMonoid.FinSum-ext {D.H n} {PairsFinSet n}
                                  (\lam s => pmap (D.cast s.3) (Pairing.rdistr {D.mul s.1 s.2}) *> AddGroupHom.func-+ {D.cast s.3})
                                *> AbMonoid.FinSum_+
  \where {
    \func inc (D : GradedProduct) (n : Nat) : AddGroupHom (D.H n) (DirectSum D) \cowith
      | func a => (\lam k => inc-at D n a k, inP (suc n, \lam _ _ => inc-at-other D a (\lam _ => absurd linarith)))
      | func-+ {a} {b} => sum-ext \lam k => \case decideEq n k \with {
        | yes e => inc-at-same D _ e *> D.cast-+ e *> inv (pmap2 (+) (inc-at-same D a e) (inc-at-same D b e))
        | no ne => inc-at-other D _ ne *> inv (pmap2 (+) (inc-at-other D a ne) (inc-at-other D b ne) *> zro-left)
      }

    \func proj (D : GradedProduct) (n : Nat) : AddGroupHom (DirectSum D) (D.H n) \cowith
      | func x => x.1 n
      | func-+ => idp

    \func inc-at (D : GradedProduct) (n : Nat) (a : D.H n) (k : Nat) : D.H k
      => \case decideEq n k \with {
        | yes e => D.cast e a
        | no _ => 0
      }

    \lemma inc-at-same (D : GradedProduct) {n k : Nat} (a : D.H n) (e : n = k) : inc-at D n a k = D.cast e a
      => unfold inc-at (rewrite (decideEq=_reduce e) idp)

    \lemma inc-at-other (D : GradedProduct) {n k : Nat} (a : D.H n) (ne : n /= k) : inc-at D n a k = 0
      => unfold inc-at (rewrite (decideEq/=_reduce ne) idp)

    \lemma proj-inc (D : GradedProduct) (n : Nat) (a : D.H n) : proj D n (inc D n a) = a
      => inc-at-same D a idp

    \lemma proj-inc-other (D : GradedProduct) {n k : Nat} (ne : n /= k) (a : D.H n) : proj D k (inc D n a) = 0
      => inc-at-other D a ne

    \lemma inc-mul (D : GradedProduct) (p q : Nat) (a : D.H p) (b : D.H q)
      : inc D p a * {DirectSum D} inc D q b = inc D (p Nat.+ q) (D.mul p q a b)
      => sum-ext \lam k => \case decideEq (p Nat.+ q) k \with {
        | yes e => AbMonoid.FinSum-unique {D.H k} {PairsFinSet k} (p, q, e) (\lam s s/= => \case decideEq p s.1 \with {
          | no ne => conv-zero-left D (inc-at D p a) (inc-at D q b) s (inc-at-other D a ne)
          | yes e1 => conv-zero-right D (inc-at D p a) (inc-at D q b) s (inc-at-other D b \lam e2 => s/= (ext (inv e1, inv e2)))
        }) *> D.cast-unique _ e _ *> pmap (D.cast e) (pmap2 (\lam a' b' => D.mul p q a' b') (inc-at-same D a idp) (inc-at-same D b idp))
           *> inv (inc-at-same D _ e)
        | no ne => AbMonoid.FinSum_zro {D.H k} {PairsFinSet k} (\lam s => \case decideEq p s.1 \with {
          | no ne1 => conv-zero-left D (inc-at D p a) (inc-at D q b) s (inc-at-other D a ne1)
          | yes e1 => conv-zero-right D (inc-at D p a) (inc-at D q b) s (inc-at-other D b \lam e2 => ne (pmap2 (Nat.+) e1 e2 *> s.3))
        }) *> inv (inc-at-other D _ ne)
      }

    \lemma decompose (D : GradedProduct) (x : DirectSum D) : ∃ (N : Nat) (x = sum-below {DirectSum D} (\lam n => inc D n (x.1 n)) N)
      => \case x.2 \with {
        | inP (N, z) => inP (N, decompose-at D x z)
      }

    \lemma decompose-at (D : GradedProduct) (x : DirectSum D) {N : Nat} (z : \Pi (n : Nat) -> N <= n -> x.1 n = 0)
      : x = sum-below {DirectSum D} (\lam n => inc D n (x.1 n)) N
      => sum-ext \lam k => inv (sum-below.hom (proj D k) _ N *> component D x.1 z k)
      \where
        \lemma component (D : GradedProduct) (x : \Pi (n : Nat) -> D.H n) {N : Nat} (z : \Pi (n : Nat) -> N <= n -> x n = 0) (k : Nat)
          : sum-below (\lam n => inc-at D n (x n) k) N = x k
          => \case LinearOrder.dec<_<= k N \with {
            | inl k<N => sum-below.unique k<N (\lam n ne => inc-at-other D (x n) ne) *> inc-at-same D (x k) idp
            | inr N<=k => sum-below.zero (\lam n _ => inc-at-other D (x n) (\lam _ => absurd linarith)) *> inv (z k N<=k)
          }

    \func lift (D : GradedProduct) {G : AbGroup} (fs : \Pi (n : Nat) -> AddGroupHom (D.H n) G) : AddGroupHom (DirectSum D) G \cowith
      | func x => (lift-value D fs x).1
      | func-+ {x} {y} => \case x.2, y.2 \with {
        | inP (N, zx), inP (M, zy) =>
          (lift-value D fs ((AddMonoid.+ {DirectSum D}) x y)).2 (N Nat.+ M) (\lam n _ => pmap2 (+) (zx n linarith) (zy n linarith) *> zro-left)
          *> pmap (sum-below __ (N Nat.+ M)) (ext \lam n => AddGroupHom.func-+ {fs n})
          *> sum-below.add _ _ (N Nat.+ M)
          *> inv (pmap2 (+) ((lift-value D fs x).2 (N Nat.+ M) (\lam n _ => zx n linarith))
                            ((lift-value D fs y).2 (N Nat.+ M) (\lam n _ => zy n linarith)))
      }
      \where {
        \func Value (D : GradedProduct) {G : AbGroup} (fs : \Pi (n : Nat) -> AddGroupHom (D.H n) G) (x : DirectSum D)
          => \Sigma (g : G) (\Pi (N : Nat) -> (\Pi (n : Nat) -> N <= n -> x.1 n = 0) -> g = sum-below (\lam n => fs n (x.1 n)) N)

        \sfunc lift-value (D : GradedProduct) {G : AbGroup} (fs : \Pi (n : Nat) -> AddGroupHom (D.H n) G) (x : DirectSum D) : Value D fs x
          => \scase x.2 \return Value D fs x \level value-prop D fs x \with {
            | inP (N, z) => (sum-below (\lam n => fs n (x.1 n)) N, \lam _ zM => sum-below.bounds (zero-image fs z) (zero-image fs zM))
          }

        \lemma zero-image {D : GradedProduct} {G : AbGroup} (fs : \Pi (n : Nat) -> AddGroupHom (D.H n) G) {x : \Pi (n : Nat) -> D.H n} {N : Nat}
                           (z : \Pi (n : Nat) -> N <= n -> x n = 0) (n : Nat) (le : N <= n) : fs n (x n) = 0
          => pmap (fs n) (z n le) *> AddGroupHom.func-zro {fs n}

        \sfunc value-prop (D : GradedProduct) {G : AbGroup} (fs : \Pi (n : Nat) -> AddGroupHom (D.H n) G) (x : DirectSum D) (a b : Value D fs x) : a = b
          => \case x.2 \with {
            | inP (N, z) => ext (a.2 N z *> inv (b.2 N z))
          }
      }

    \func universal (D : GradedProduct) (G : AbGroup) : QEquiv {AddGroupHom (DirectSum D) G} {\Pi (n : Nat) -> AddGroupHom (D.H n) G} \cowith
      | f h n => h AddGroupHom.∘ inc D n
      | ret => lift D
      | ret_f h => exts \lam x => \case x.2 \with {
        | inP (N, z) => (lift.lift-value D (\lam n => h AddGroupHom.∘ inc D n) x).2 N z *> inv (sum-below.hom h _ N) *> pmap h (inv (decompose-at D x z))
      }
      | f_sec fs => ext \lam n => exts \lam a =>
          (lift.lift-value D fs (inc D n a)).2 (suc n) (\lam _ _ => inc-at-other D a (\lam _ => absurd linarith))
          *> sum-below.unique id<suc (\lam k ne => pmap (fs k) (inc-at-other D a (\lam p => ne (inv p))) *> AddGroupHom.func-zro {fs k})
          *> pmap (fs n) (inc-at-same D a idp)

    \func ringMap {D D' : GradedProduct} (phi : \Pi (n : Nat) -> AddGroupHom (D.H n) (D'.H n))
                  (phi-mul : \Pi (p q : Nat) (a : D.H p) (b : D.H q) -> phi (p Nat.+ q) (D.mul p q a b) = D'.mul p q (phi p a) (phi q b))
                  (phi-one : phi 0 D.one = D'.one) : RingHom (DirectSum D) (DirectSum D') \cowith
      | func x => (\lam n => phi n (x.1 n), \case x.2 \with {
        | inP (N, z) => inP (N, \lam n le => pmap (phi n) (z n le) *> AddGroupHom.func-zro {phi n})
      })
      | func-+ => sum-ext \lam n => AddGroupHom.func-+ {phi n}
      | func-ide => sum-ext (unit-map phi phi-one)
      | func-* {x} {y} => sum-ext \lam n => AddMonoidHom.func-FinSum (phi n) {PairsFinSet n}
          *> AbMonoid.FinSum-ext {D'.H n} {PairsFinSet n} (\lam s => cast-map phi s.3 _ *> pmap (D'.cast s.3) (phi-mul s.1 s.2 (x.1 s.1) (y.1 s.2)))
      \where {
        \lemma unit-map {D D' : GradedProduct} (phi : \Pi (n : Nat) -> AddGroupHom (D.H n) (D'.H n)) (phi-one : phi 0 D.one = D'.one) (n : Nat)
          : phi n (unit D n) = unit D' n \elim n
          | 0 => phi-one
          | suc n => AddGroupHom.func-zro {phi (suc n)}

        \lemma cast-map {D D' : GradedProduct} (phi : \Pi (n : Nat) -> AddGroupHom (D.H n) (D'.H n)) {n m : Nat} (e : n = m) (a : D.H n)
          : phi m (D.cast e a) = D'.cast e (phi n a)
          => GradedPairing.transport-hom phi e a

        \lemma inc-map {D D' : GradedProduct} (phi : \Pi (n : Nat) -> AddGroupHom (D.H n) (D'.H n))
                       (phi-mul : \Pi (p q : Nat) (a : D.H p) (b : D.H q) -> phi (p Nat.+ q) (D.mul p q a b) = D'.mul p q (phi p a) (phi q b))
                       (phi-one : phi 0 D.one = D'.one) (n : Nat) (a : D.H n)
          : ringMap phi phi-mul phi-one (inc D n a) = inc D' n (phi n a)
          => sum-ext {D'} {ringMap phi phi-mul phi-one (inc D n a)} {inc D' n (phi n a)} \lam k => \case decideEq n k \with {
            | yes e => pmap (phi k) (inc-at-same D a e) *> cast-map phi e a *> inv (inc-at-same D' (phi n a) e)
            | no ne => pmap (phi k) (inc-at-other D a ne) *> AddGroupHom.func-zro {phi k} *> inv (inc-at-other D' (phi n a) ne)
          }
      }

    \func sum-ext {D : GradedProduct} {x y : \Sigma (x : \Pi (n : Nat) -> D.H n) (∃ (N : Nat) (\Pi (n : Nat) -> N <= n -> x n = 0))}
                  (h : \Pi (n : Nat) -> x.1 n = y.1 n) : x = y
      => ext (ext h)

    \func unit (D : GradedProduct) (n : Nat) : D.H n \elim n
      | 0 => D.one
      | suc _ => 0

    \lemma unit-suc (D : GradedProduct) {n : Nat} (n/=0 : n /= 0) : unit D n = 0 \elim n
      | 0 => absurd (n/=0 idp)
      | suc _ => idp

    \func conv (D : GradedProduct) (x y : \Pi (n : Nat) -> D.H n) (n : Nat) : D.H n
      => AbMonoid.FinSum {D.H n} {PairsFinSet n} \lam s => D.cast s.3 (D.mul s.1 s.2 (x s.1) (y s.2))

    \lemma conv-zero-left (D : GradedProduct) (x y : \Pi (n : Nat) -> D.H n) {n : Nat} (s : PairsFinSet n) (h : x s.1 = 0)
      : D.cast s.3 (D.mul s.1 s.2 (x s.1) (y s.2)) = 0
      => pmap (\lam a => D.cast s.3 (D.mul s.1 s.2 a (y s.2))) h *> pmap (D.cast s.3) (Pairing.zro-left (D.mul s.1 s.2)) *> AddGroupHom.func-zro {D.cast s.3}

    \lemma conv-zero-right (D : GradedProduct) (x y : \Pi (n : Nat) -> D.H n) {n : Nat} (s : PairsFinSet n) (h : y s.2 = 0)
      : D.cast s.3 (D.mul s.1 s.2 (x s.1) (y s.2)) = 0
      => pmap (\lam b => D.cast s.3 (D.mul s.1 s.2 (x s.1) b)) h *> pmap (D.cast s.3) (Pairing.zro-right (D.mul s.1 s.2)) *> AddGroupHom.func-zro {D.cast s.3}

    \lemma conv-assoc (D : GradedProduct) (x y z : \Pi (n : Nat) -> D.H n) (n : Nat) : conv D (conv D x y) z n = conv D x (conv D y z) n
      => AbMonoid.FinSum-ext {D.H n} {PairsFinSet n} (\lam s => pmap (D.cast s.3) (AddMonoidHom.func-FinSum (Pairing.right (D.mul s.1 s.2) (z s.2)) {PairsFinSet s.1})
                                                *> AddMonoidHom.func-FinSum (D.cast s.3))
         *> AbMonoid.FinSum-double-dep' (\lam (s : PairsFinSet n) => PairsFinSet s.1)
         *> AbMonoid.FinSum_Equiv2 {D.H n} {SigmaFin (PairsFinSet n) (\lam s => PairsFinSet s.1)} {SigmaFin (PairsFinSet n) (\lam s => PairsFinSet s.2)}
              (FSeriesRing.pairs-assoc n) (\lam a => \case \elim a \with {
                | ((i,j,e1),(k,m,e2)) => term D x y z _ _ _ _
              })
         *> inv (AbMonoid.FinSum-double-dep' (\lam (s : PairsFinSet n) => PairsFinSet s.2))
         *> inv (AbMonoid.FinSum-ext {D.H n} {PairsFinSet n} (\lam s => pmap (D.cast s.3) (AddMonoidHom.func-FinSum (Pairing.left (D.mul s.1 s.2) (x s.1)) {PairsFinSet s.2})
                                                     *> AddMonoidHom.func-FinSum (D.cast s.3)))
      \where
        \lemma term (D : GradedProduct) (x y z : \Pi (n : Nat) -> D.H n) {n i j k m : Nat} (e1 : i Nat.+ j = n) (e2 : k Nat.+ m = i)
                    (e3 : k Nat.+ (m Nat.+ j) = n) (e4 : m Nat.+ j = m Nat.+ j)
          : D.cast e1 (D.mul i j (D.cast e2 (D.mul k m (x k) (y m))) (z j))
            = D.cast e3 (D.mul k (m Nat.+ j) (x k) (D.cast e4 (D.mul m j (y m) (z j))))
          => pmap (D.cast e1) (D.cast-left e2 j _ _) *> D.cast-comp _ _ _
             *> pmap (D.cast (pmap (Nat.`+ j) e2 *> e1)) (D.mul-assoc k m j _ _ _) *> D.cast-comp _ _ _ *> D.cast-unique _ e3 _
             *> pmap (\lam c => D.cast e3 (D.mul k (m Nat.+ j) (x k) c)) (D.cast-unique idp e4 _)
  }
