\import Algebra.Group
\import Algebra.Group.GroupCat
\import Algebra.Group.GroupHom
\import Algebra.Group.Product
\import Algebra.Monoid
\import Algebra.Pointed (zro)
\import Arith.Int (ipred)
\import Category (Iso, oIso)
\import Equiv
\import Homotopy.Cohomology (Cohomology, ReducedCohomology)
\import Homotopy.Cohomology.Circle
\import Homotopy.Cohomology.Coefficients
\import Homotopy.Cohomology.Definition
\import Homotopy.Cohomology.DegreeZero
\import Homotopy.Cohomology.Functor
\import Homotopy.Cohomology.Group
\import Homotopy.Cohomology.Reduced
\import Homotopy.EilenbergMacLane.Algebra
\import Homotopy.EilenbergMacLane.Definition
\import Homotopy.EilenbergMacLane.Functor
\import Homotopy.EilenbergMacLane.Loop
\import Homotopy.Pointed (->*, Pointed, UnitPointed, base)
\import Logic.Unique (isSet)
\import Paths
\import Paths.Meta
\import Set.Fin

\open ->* (∘*)

-- Classes commute with the operations, pullbacks and coefficient maps definitionally.

\func classOf-zero.{u} {n : Nat} {X : \Type u} {A : AbGroup.{u}}
  : CohomologyNat.classOf (Cocycle.zero {n} {X} {A}) = zro {CohomologyNat n X A}
  => idp

\func classOf-add.{u} {n : Nat} {X : \Type u} {A : AbGroup.{u}} (f g : Cocycle n X A)
  : CohomologyNat.classOf (Cocycle.add f g) = (AddMonoid.+ {CohomologyNat n X A}) (CohomologyNat.classOf f) (CohomologyNat.classOf g)
  => idp

\func classOf-neg.{u} {n : Nat} {X : \Type u} {A : AbGroup.{u}} (f : Cocycle n X A)
  : CohomologyNat.classOf (Cocycle.neg f) = (AddGroup.negative {CohomologyNat n X A}) (CohomologyNat.classOf f)
  => idp

\func reduced-classOf-add.{u} {n : Nat} {X : Pointed.{u}} {A : AbGroup.{u}} (f g : ReducedCocycle n X A)
  : ReducedCohomologyNat.classOf (ReducedCocycle.add f g)
    = (AddMonoid.+ {ReducedCohomologyNat n X A}) (ReducedCohomologyNat.classOf f) (ReducedCohomologyNat.classOf g)
  => idp

\func pullback-classOf.{u} {n : Nat} {X Y : \Type u} {A : AbGroup.{u}} (s : X -> Y) (g : Cocycle n Y A)
  : pullback n s (CohomologyNat.classOf g) = CohomologyNat.classOf (\lam x => g (s x))
  => idp

\func reducedPullback-classOf.{u} {n : Nat} {X Y : Pointed.{u}} {A : AbGroup.{u}} (s : X ->* Y) (g : ReducedCocycle n Y A)
  : reducedPullback n s (ReducedCohomologyNat.classOf g) = ReducedCohomologyNat.classOf (g ∘* s)
  => idp

\func mapCoefficients-classOf.{u} {n : Nat} {X : \Type u} {A B : AbGroup.{u}} (f : AddGroupHom A B) (g : Cocycle n X A)
  : mapCoefficients n X f (CohomologyNat.classOf g) = CohomologyNat.classOf (\lam x => (KMap n (AddGroupHom.toGroupHom f)).1 (g x))
  => idp

\func reducedMapCoefficients-classOf.{u} {n : Nat} {X : Pointed.{u}} {A B : AbGroup.{u}} (f : AddGroupHom A B) (g : ReducedCocycle n X A)
  : reducedMapCoefficients n X f (ReducedCohomologyNat.classOf g) = ReducedCohomologyNat.classOf (KMap n (AddGroupHom.toGroupHom f) ∘* g)
  => idp

-- The recursor eliminates into sets of any universe, and the groups accept inputs of a lower universe.

\func rec-large {n : Nat} {X : \Type0} {A : AbGroup.{0}} {B : \Type1} (p : isSet B) (f : Cocycle n X A -> B) (c : CohomologyNat n X A) : B
  => CohomologyNat.rec p f c

\func mixed-levels (n : Nat) (X : \Type0) (A : AbGroup.{1}) : AbGroup.{1}
  => CohomologyNat n X A

-- Cocycles, including a pointed cocycle whose basepoint witness is not `idp`.

\func constant-cocycle.{u} (n : Nat) (X : \Type u) {A : AbGroup.{u}} (a : K A n) : Cocycle n X A
  => \lam _ => a

\func unit-sum.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) : ReducedCocycle n X A
  => ReducedCocycle.add ReducedCocycle.zero ReducedCocycle.zero

\func unit-sum-witness.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u})
  : (unit-sum n X A).2 = idp *> deloopAdd.base-path (K-loopEquiv n)
  => idp

\func unit-sum-class.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u})
  : ReducedCohomologyNat.classOf (unit-sum n X A) = ReducedCohomologyNat.classOf ReducedCocycle.zero
  => AddMonoid.zro-left {ReducedCohomologyNat n X A}

-- | An equality of pointed maps, including their basepoint witnesses.
\func translate-base.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) (g : ReducedCocycle n X A)
  : normalize (\lam x => K-add n (g.1 x) base) = g
  => normalize.translate g base

-- The point, finite sets and the circle.

\func H0-point.{u} (A : AbGroup.{u}) : Iso {AbGroupCat} {A} {CohomologyNat 0 (\Sigma) A} _
  => pointCohomology-zero A

\func H1-point.{u} (A : AbGroup.{u}) : Iso {AbGroupCat} {CohomologyNat 1 (\Sigma) A} {TrivialAbGroup} _
  => pointCohomology-positive 0 A

\func Hred-point.{u} (n : Nat) (A : AbGroup.{u}) : Iso {AbGroupCat} {ReducedCohomologyNat n UnitPointed A} {TrivialAbGroup} _
  => reducedPointCohomology n A

\func H0-fin0.{u} (A : AbGroup.{u}) : Iso {AbGroupCat} {CohomologyNat 0 (Fin 0) A} {TrivialAbGroup} _
  => oIso (cohomologyZero-fin idEquiv A) (finZero-trivial A)

\func H0-fin1.{u} (A : AbGroup.{u}) : Iso {AbGroupCat} {CohomologyNat 0 (Fin 1) A} {A} _
  => oIso (cohomologyZero-fin idEquiv A) (AbGroupCat.isoOfEquiv (fin1 A) (\new QEquiv {
    | ret a _ => a
    | ret_f h => ext \lam j => \case \elim j \with {
      | 0 => idp
    }
    | f_sec _ => idp
  }))
  \where
    \func fin1.{u} (A : AbGroup.{u}) : AddGroupHom (FuncAbGroup (Fin 1) A) A \cowith
      | func h => h 0
      | func-+ => idp

\func H0-fin2.{u} (A : AbGroup.{u}) : Iso {AbGroupCat} {CohomologyNat 0 (Fin 2) A} {ProductAbGroup A A} _
  => oIso (cohomologyZero-fin idEquiv A) (AbGroupCat.isoOfEquiv (fin2 A) (\new QEquiv {
    | ret p j => \case j \with {
      | 0 => p.1
      | 1 => p.2
    }
    | ret_f h => ext \lam j => \case \elim j \with {
      | 0 => idp
      | 1 => idp
    }
    | f_sec _ => idp
  }))
  \where
    \func fin2.{u} (A : AbGroup.{u}) : AddGroupHom (FuncAbGroup (Fin 2) A) (ProductAbGroup A A) \cowith
      | func h => (h 0, h 1)
      | func-+ => idp

\func H0-circle.{u} (A : AbGroup.{u}) : Iso {AbGroupCat} {A} {CohomologyNat 0 Circle A} _
  => cohomologyZero-circle A

\func Hred0-circle.{u} (A : AbGroup.{u}) : Iso {AbGroupCat} {ReducedCohomologyNat 0 Circle A} {TrivialAbGroup} _
  => reducedCohomologyZero-circle A

\func Hred1-circle.{u} (A : AbGroup.{u}) : Iso {AbGroupCat} {ReducedCohomologyNat 1 Circle A} {A} _
  => reducedCohomologyOne-circle A

-- The splitting on representatives, in degrees zero and one.

\func join-classOf.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) (g : ReducedCocycle n X A) (a : Cocycle n (\Sigma) A)
  : Homotopy.Cohomology.Reduced.cohomologySplit.join n X A (ReducedCohomologyNat.classOf g, CohomologyNat.classOf a)
    = CohomologyNat.classOf (\lam x => K-add n (g.1 x) (a ()))
  => idp

\func split-classOf.{u} (n : Nat) (X : Pointed.{u}) (A : AbGroup.{u}) (f : Cocycle n X A)
  : Homotopy.Cohomology.Reduced.cohomologySplit.split-map (CohomologyNat.classOf f)
    = (ReducedCohomologyNat.classOf (normalize f), CohomologyNat.classOf (\lam _ => f base))
  => idp

\func split-zero.{u} (X : Pointed.{u}) (A : AbGroup.{u})
  : Iso {AbGroupCat} {ProductAbGroup (ReducedCohomologyNat 0 X A) (CohomologyNat 0 (\Sigma) A)} {CohomologyNat 0 X A} _
  => Homotopy.Cohomology.Reduced.cohomologySplit 0 X A

\func split-one.{u} (X : Pointed.{u}) (A : AbGroup.{u})
  : Iso {AbGroupCat} {ReducedCohomologyNat 1 X A} {CohomologyNat 1 X A} _
  => Homotopy.Cohomology.Reduced.forgetIso 0 X A

-- Integer degrees.

\func degree-positive.{u} (n : Nat) (X : \Type u) (A : AbGroup.{u}) : Cohomology (pos n) X A = {AbGroup.{u}} CohomologyNat n X A
  => idp

\func degree-neg0.{u} (X : \Type u) (A : AbGroup.{u}) : Cohomology (neg 0) X A = {AbGroup.{u}} CohomologyNat 0 X A
  => idp

\func degree-minus1.{u} (X : \Type u) (A : AbGroup.{u}) : Cohomology (neg 1) X A = {AbGroup.{u}} TrivialAbGroup
  => idp

\func degree-minus2.{u} (X : \Type u) (A : AbGroup.{u}) : Cohomology (neg 2) X A = {AbGroup.{u}} TrivialAbGroup
  => idp

\func degree-pred-zero.{u} (X : \Type u) (A : AbGroup.{u}) : Cohomology (ipred (pos 0)) X A = {AbGroup.{u}} TrivialAbGroup
  => idp

\func split-negative.{u} (k : Nat) (X : Pointed.{u}) (A : AbGroup.{u})
  : Iso {AbGroupCat} {ProductAbGroup (ReducedCohomology (neg (suc k)) X A) (Cohomology (neg (suc k)) (\Sigma) A)}
                     {Cohomology (neg (suc k)) X A} _
  => Homotopy.Cohomology.cohomologySplit (neg (suc k)) X A
